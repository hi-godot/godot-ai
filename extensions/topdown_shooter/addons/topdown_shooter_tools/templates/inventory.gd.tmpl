extends Node

## Grid + weight inventory (generated by inventory_ui_scaffold).
##
## Put it under the player. Items are item_data.gd resources (from
## item_db_import) or their ids, looked up in `item_database`. Every stack
## sits at a cell of a `grid_width` x `grid_height` grid and covers the
## item's grid_width x grid_height cells (swapped when rotated). Stacks
## hold up to the item's max_stack.
##
## add_item(item, count) is all-or-nothing: it returns false and changes
## nothing when the items do not fit in the grid or would go over
## `max_weight`. That is what loot pickups call, so a full bag leaves the
## pickup on the ground.
##
## Above `encumbered_weight` the owner's `speed_property` (move_speed on the
## player controller) drops linearly to `min_speed_factor` at max_weight.
##
## Free to edit: this file was copied into your project and is yours now.

signal changed
signal item_added(item: Resource, count: int)
signal item_removed(item: Resource, count: int)
signal item_dropped(item: Resource, count: int, pickup: Node)
signal add_failed(item: Resource, count: int, reason: String)

@export_group("Grid")
@export_range(1, 64) var grid_width := 6
@export_range(1, 64) var grid_height := 8
## Let add_item and the UI turn items 90 degrees to make them fit.
@export var allow_rotation := true

@export_group("Weight")
## Kilograms the bag can hold. 0 = no limit.
@export var max_weight := 40.0
## Above this the owner slows down. 0 = never slows.
@export var encumbered_weight := 25.0
## Speed multiplier at max_weight.
@export_range(0.05, 1.0) var min_speed_factor := 0.5
## Owner property scaled by the weight (move_speed on the player).
@export var speed_property: StringName = &"move_speed"

@export_group("Items")
## item_database.tres from item_db_import, to accept item ids.
@export var item_database: Resource
## Items given at start, as {"item_id": "bandage", "count": 2}.
@export var starting_items: Array[Dictionary] = []
## Script of dropped items (loot_pickup.gd from loot_table_edit).
@export_file("*.gd") var pickup_script_path := "res://scripts/topdown/loot_pickup.gd"
## Dropped items land this far in front of the owner.
@export var drop_distance := 1.6

## Stacks: {"item": Resource, "count": int, "x": int, "y": int, "rotated": bool}.
var entries: Array[Dictionary] = []

var _base_speed := -1.0


func _ready() -> void:
	add_to_group(&"inventory")
	var owner_body := get_parent()
	if owner_body != null and speed_property != &"" and speed_property in owner_body:
		_base_speed = float(owner_body.get(speed_property))
	for spec in starting_items:
		var id: Variant = spec.get("item_id", spec.get("item"))
		var count := int(spec.get("count", 1))
		if not add_item(id, count):
			push_warning("Inventory: starting item %s x%d does not fit" % [id, count])
	_update_speed()


# --- queries -------------------------------------------------------------------

## Resource for an item or an item id (via item_database). Null if unknown.
func resolve_item(item: Variant) -> Resource:
	if item is Resource:
		return item
	if (item is String or item is StringName) and item_database != null and item_database.has_method("get_item"):
		return item_database.get_item(String(item))
	return null


func item_id_of(item: Variant) -> String:
	var res := resolve_item(item)
	if res != null and "item_id" in res:
		return String(res.get("item_id"))
	return String(item) if item is String or item is StringName else ""


## Cells an item covers, swapped when rotated.
func item_size(item: Resource, rotated := false) -> Vector2i:
	var w := 1
	var h := 1
	if item != null:
		if "grid_width" in item:
			w = maxi(int(item.get("grid_width")), 1)
		if "grid_height" in item:
			h = maxi(int(item.get("grid_height")), 1)
	return Vector2i(h, w) if rotated else Vector2i(w, h)


func entry_size(index: int) -> Vector2i:
	var e: Dictionary = entries[index]
	return item_size(e.item, e.rotated)


func max_stack_of(item: Resource) -> int:
	if item != null and "max_stack" in item:
		return maxi(int(item.get("max_stack")), 1)
	return 1


func weight_of(item: Resource, count := 1) -> float:
	if item != null and "weight" in item:
		return float(item.get("weight")) * count
	return 0.0


func value_of(item: Resource, count := 1) -> int:
	if item != null and "value" in item:
		return int(item.get("value")) * count
	return 0


func get_total_weight() -> float:
	var total := 0.0
	for e in entries:
		total += weight_of(e.item, e.count)
	return total


func get_total_value() -> int:
	var total := 0
	for e in entries:
		total += value_of(e.item, e.count)
	return total


## 1.0 = full speed, min_speed_factor at max_weight.
func get_speed_factor() -> float:
	if encumbered_weight <= 0.0:
		return 1.0
	var w := get_total_weight()
	if w <= encumbered_weight:
		return 1.0
	var top := max_weight if max_weight > encumbered_weight else encumbered_weight * 2.0
	var t := clampf((w - encumbered_weight) / (top - encumbered_weight), 0.0, 1.0)
	return lerpf(1.0, min_speed_factor, t)


func count_of(item: Variant) -> int:
	var id := item_id_of(item)
	var total := 0
	for e in entries:
		if item_id_of(e.item) == id:
			total += int(e.count)
	return total


func has_item(item: Variant, count := 1) -> bool:
	return count_of(item) >= count


## Index of the stack covering `cell`, or -1.
func entry_at(cell: Vector2i) -> int:
	for i in entries.size():
		var e: Dictionary = entries[i]
		var size := entry_size(i)
		if Rect2i(Vector2i(e.x, e.y), size).has_point(cell):
			return i
	return -1


## True when the w x h area at cell is inside the grid and holds no stack
## (other than `ignore_index`).
func is_area_free(cell: Vector2i, size: Vector2i, ignore_index := -1) -> bool:
	var rect := Rect2i(cell, size)
	if rect.position.x < 0 or rect.position.y < 0 or rect.end.x > grid_width or rect.end.y > grid_height:
		return false
	for i in entries.size():
		if i == ignore_index:
			continue
		var e: Dictionary = entries[i]
		if rect.intersects(Rect2i(Vector2i(e.x, e.y), entry_size(i))):
			return false
	return true


## First free cell for an item, scanning rows top to bottom. Returns
## {"cell": Vector2i, "rotated": bool} or {} when nothing fits.
func find_space(item: Resource) -> Dictionary:
	var options := [false]
	if allow_rotation and item_size(item) != item_size(item, true):
		options.append(true)
	for y in grid_height:
		for x in grid_width:
			for rotated in options:
				if is_area_free(Vector2i(x, y), item_size(item, rotated)):
					return {"cell": Vector2i(x, y), "rotated": rotated}
	return {}


# --- changes -------------------------------------------------------------------

## Adds `count` of an item (Resource or id). All or nothing: returns false
## and changes nothing when it does not fit or is too heavy.
func add_item(item: Variant, count := 1) -> bool:
	var res := resolve_item(item)
	if res == null:
		push_warning("Inventory: unknown item %s" % [item])
		add_failed.emit(null, count, "unknown")
		return false
	if count <= 0:
		return true
	if max_weight > 0.0 and get_total_weight() + weight_of(res, count) > max_weight + 0.0001:
		add_failed.emit(res, count, "weight")
		return false
	var saved := _copy_entries()
	var left := count
	var stack := max_stack_of(res)
	var id := item_id_of(res)
	for e in entries:
		if left <= 0:
			break
		if item_id_of(e.item) == id and int(e.count) < stack:
			var put := mini(stack - int(e.count), left)
			e.count = int(e.count) + put
			left -= put
	while left > 0:
		var spot := find_space(res)
		if spot.is_empty():
			entries = saved
			add_failed.emit(res, count, "space")
			return false
		var put := mini(stack, left)
		entries.append({"item": res, "count": put, "x": spot.cell.x, "y": spot.cell.y, "rotated": spot.rotated})
		left -= put
	_after_change()
	item_added.emit(res, count)
	return true


## Removes up to `count` of an item, smallest stacks first. Returns how
## many were removed.
func remove_item(item: Variant, count := 1) -> int:
	var id := item_id_of(item)
	var order: Array = []
	for i in entries.size():
		if item_id_of(entries[i].item) == id:
			order.append(i)
	order.sort_custom(func(a, b): return int(entries[a].count) < int(entries[b].count))
	var left := count
	var res: Resource = null
	for i in order:
		if left <= 0:
			break
		var e: Dictionary = entries[i]
		res = e.item
		var take := mini(int(e.count), left)
		e.count = int(e.count) - take
		left -= take
	entries.assign(entries.filter(func(e): return int(e.count) > 0))
	var removed := count - left
	if removed > 0:
		_after_change()
		item_removed.emit(res, removed)
	return removed


## Takes `count` (default: the whole stack) out of stack `index`.
## Returns {"item", "count"} or {}.
func take_from(index: int, count := -1) -> Dictionary:
	if index < 0 or index >= entries.size():
		return {}
	var e: Dictionary = entries[index]
	var take := int(e.count) if count < 0 else mini(count, int(e.count))
	e.count = int(e.count) - take
	if int(e.count) <= 0:
		entries.remove_at(index)
	_after_change()
	item_removed.emit(e.item, take)
	return {"item": e.item, "count": take}


## Moves stack `index` to `cell` (optionally rotated). Dropping it on
## another stack of the same item merges as much as fits. Returns true
## when anything changed.
func move_entry(index: int, cell: Vector2i, rotated := false) -> bool:
	if index < 0 or index >= entries.size():
		return false
	var e: Dictionary = entries[index]
	if rotated and not allow_rotation:
		rotated = false
	var target := entry_at(cell)
	if target >= 0 and target != index and item_id_of(entries[target].item) == item_id_of(e.item):
		var room := max_stack_of(e.item) - int(entries[target].count)
		if room <= 0:
			return false
		var put := mini(room, int(e.count))
		entries[target].count = int(entries[target].count) + put
		e.count = int(e.count) - put
		if int(e.count) <= 0:
			entries.remove_at(index)
		_after_change()
		return true
	if not is_area_free(cell, item_size(e.item, rotated), index):
		return false
	e.x = cell.x
	e.y = cell.y
	e.rotated = rotated
	_after_change()
	return true


## Splits half of stack `index` into a free spot. Returns true on success.
func split_entry(index: int) -> bool:
	if index < 0 or index >= entries.size() or int(entries[index].count) < 2:
		return false
	var e: Dictionary = entries[index]
	var spot := find_space(e.item)
	if spot.is_empty():
		return false
	var half := int(e.count) / 2
	e.count = int(e.count) - half
	entries.append({"item": e.item, "count": half, "x": spot.cell.x, "y": spot.cell.y, "rotated": spot.rotated})
	_after_change()
	return true


## Re-packs every stack, largest first, merging partial stacks. Keeps the
## old layout when the new one would not fit.
func sort_items() -> bool:
	var totals := {}
	var items := {}
	for e in entries:
		var id := item_id_of(e.item)
		totals[id] = int(totals.get(id, 0)) + int(e.count)
		items[id] = e.item
	var ids := totals.keys()
	ids.sort_custom(func(a, b):
		var sa := item_size(items[a])
		var sb := item_size(items[b])
		if sa.x * sa.y != sb.x * sb.y:
			return sa.x * sa.y > sb.x * sb.y
		return String(a) < String(b))
	var saved := _copy_entries()
	entries = []
	for id in ids:
		var left := int(totals[id])
		while left > 0:
			var spot := find_space(items[id])
			if spot.is_empty():
				entries = saved
				return false
			var put := mini(max_stack_of(items[id]), left)
			entries.append({"item": items[id], "count": put, "x": spot.cell.x, "y": spot.cell.y, "rotated": spot.rotated})
			left -= put
	_after_change()
	return true


## Removes stack `index` (or `count` of it) and drops it on the ground in
## front of the owner as a loot pickup. Returns the pickup or null.
func drop_entry(index: int, count := -1) -> Node:
	var taken := take_from(index, count)
	if taken.is_empty():
		return null
	var pickup := _spawn_pickup(taken.item, taken.count)
	item_dropped.emit(taken.item, taken.count, pickup)
	return pickup


func clear() -> void:
	entries.clear()
	_after_change()


## Plain data for saving: [{"item_id", "count", "x", "y", "rotated"}].
func to_data() -> Array:
	var out := []
	for e in entries:
		out.append({"item_id": item_id_of(e.item), "count": e.count, "x": e.x, "y": e.y, "rotated": e.rotated})
	return out


func from_data(data: Array) -> void:
	entries.clear()
	for d in data:
		var res := resolve_item(d.get("item_id", ""))
		if res != null:
			entries.append({"item": res, "count": int(d.get("count", 1)), "x": int(d.get("x", 0)), "y": int(d.get("y", 0)), "rotated": bool(d.get("rotated", false))})
	_after_change()


# --- internals -------------------------------------------------------------------

func _copy_entries() -> Array[Dictionary]:
	var out: Array[Dictionary] = []
	for e in entries:
		out.append(e.duplicate())
	return out


func _after_change() -> void:
	_update_speed()
	changed.emit()


func _update_speed() -> void:
	var owner_body := get_parent()
	if _base_speed < 0.0 or owner_body == null:
		return
	owner_body.set(speed_property, _base_speed * get_speed_factor())


func _spawn_pickup(item: Resource, count: int) -> Node:
	var owner_body := get_parent() as Node3D
	if owner_body == null or owner_body.get_parent() == null or not ResourceLoader.exists(pickup_script_path):
		return null
	var pickup := Area3D.new()
	pickup.set_script(load(pickup_script_path))
	for pair in [["item_id", item_id_of(item)], ["count", count], ["item", item]]:
		if pair[0] in pickup:
			pickup.set(pair[0], pair[1])
	pickup.name = "Dropped_%s" % item_id_of(item)
	var forward := Vector3.FORWARD
	if "aim_point" in owner_body:
		var to_aim: Vector3 = owner_body.get("aim_point") - owner_body.global_position
		to_aim.y = 0.0
		if to_aim.length_squared() > 0.01:
			forward = to_aim.normalized()
	owner_body.get_parent().add_child(pickup)
	pickup.global_position = owner_body.global_position + forward * drop_distance
	return pickup
