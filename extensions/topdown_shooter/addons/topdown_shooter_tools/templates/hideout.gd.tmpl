	add_child(_ghost)


func _button(text: String, callback: Callable) -> Button:
	var b := Button.new()
	b.text = text
	b.focus_mode = Control.FOCUS_NONE
	b.pressed.connect(callback)
	return b


func _box(fill: Color, border: Color, width: int, radius: int, pad := 0) -> StyleBoxFlat:
	var box := StyleBoxFlat.new()
	box.bg_color = fill
	box.border_color = border
	box.set_border_width_all(width)
	box.set_corner_radius_all(radius)
	box.set_content_margin_all(pad)
	return box


# --- updates -----------------------------------------------------------------------

func _on_changed() -> void:
	if _loading:
		return
	if state != null:
		state.store(stash, loadout)
	for pane in _panes:
		pane.refresh()
	_refresh()


func _refresh() -> void:
	if stash == null or loadout == null:
		return
	_stash_label.text = "창고  ₩%s" % _thousands(stash.get_total_value())
	var weight: float = loadout.get_total_weight()
	var limit: float = loadout.max_weight
	_bag_label.text = "무게 %.1f%s · 가치 ₩%s" % [weight, " / %.0f kg" % limit if limit > 0.0 else " kg", _thousands(loadout.get_total_value())]
	var scene := get_raid_scene()
	_deploy_button.text = "출격  ▶  %s" % scene.get_file().get_basename() if not scene.is_empty() else "출격할 레이드 씬이 없습니다"
	_deploy_button.disabled = scene.is_empty()
	if state != null:
		var s: Dictionary = state.stats
		var raids := int(s.get("raids", 0))
		var rate := "-" if raids == 0 else "%d%%" % roundi(100.0 * float(s.get("extracted", 0)) / raids)
		_stats_label.text = "레이드 %d · 탈출 %d · 사망 %d · 생존율 %s · 총 수익 ₩%s" % [raids, int(s.get("extracted", 0)), int(s.get("died", 0)) + int(s.get("mia", 0)), rate, _thousands(int(s.get("value_extracted", 0)))]
	_show_banner()


func _show_banner() -> void:
	var raid: Dictionary = summary.get("last_raid", {})
	var lines: Array[String] = []
	var color := Color(0.6, 0.65, 0.7)
	if bool(summary.get("returned", false)):
		var moved := 0
		for id in summary.get("moved", {}):
			moved += int(summary.moved[id])
		lines.append("탈출 성공 · 가져온 물건 ₩%s · %d개를 창고로 옮겼습니다" % [_thousands(int(raid.get("value", 0))), moved])
		if not summary.get("left_in_bag", {}).is_empty():
			lines.append("창고가 가득 차서 일부는 가방에 남았습니다")
		color = Color(0.5, 1.0, 0.6)
	elif str(raid.get("result", "")) == "died" and not bool(raid.get("seen", false)):
		lines.append("사망 · 가지고 간 물건 ₩%s를 잃었습니다" % _thousands(int(raid.get("value_lost", 0))))
		color = Color(1.0, 0.5, 0.45)
	elif str(raid.get("result", "")) == "mia" and not bool(raid.get("seen", false)):
		lines.append("레이드 중에 게임이 꺼져 가방을 잃었습니다")
		color = Color(1.0, 0.65, 0.4)
	if not summary.get("placed_waiting", {}).is_empty():
		lines.append("기본 지급품을 창고에 넣었습니다")
	if not summary.get("waiting", []).is_empty():
		lines.append("창고 공간이 부족해 %d묶음이 자리를 기다립니다" % summary.waiting.size())
	_banner.visible = not lines.is_empty()
	_banner_label.text = "\n".join(lines)
	_banner.add_theme_stylebox_override("panel", _box(Color(color.r, color.g, color.b, 0.12), color, 1, 6, 10))
	_banner_label.add_theme_color_override("font_color", color)
	if state != null and not raid.is_empty() and not bool(raid.get("seen", false)):
		## Show a death once; the next visit starts quiet.
		state.last_raid["seen"] = true


func _sort(inv: Node) -> void:
	if not inv.sort_items():
		_flash("정렬할 공간이 없습니다")


func _on_reset_pressed() -> void:
	if _reset_armed > 0.0:
		reset_game()
		return
	_reset_armed = 3.0
	_reset_button.text = "정말 지울까요?"


func _flash(text: String) -> void:
	var label := Label.new()
	label.text = text
	label.top_level = true
	label.add_theme_font_size_override("font_size", 20)
	label.add_theme_color_override("font_color", Color(1.0, 0.6, 0.5))
	label.add_theme_color_override("font_outline_color", Color.BLACK)
	label.add_theme_constant_override("outline_size", 6)
	label.position = get_global_mouse_position() + Vector2(12, -28)
	add_child(label)
	var tween := label.create_tween()
	tween.tween_interval(1.2)
	tween.tween_property(label, "modulate:a", 0.0, 0.5)
	tween.tween_callback(label.queue_free)


func show_tooltip(inv: Node, index: int, at: Vector2) -> void:
	if index < 0 or inv == null or index >= inv.entries.size():
		hide_tooltip()
		return
	var e: Dictionary = inv.entries[index]
	var item: Resource = e.item
	var rarity := String(item.get("rarity")) if "rarity" in item else ""
	var lines: Array[String] = [label_for(item, int(e.count)), RARITY_NAMES.get(rarity, rarity)]
	lines.append("무게 %.2f kg · 가치 ₩%s" % [inv.weight_of(item, e.count), _thousands(inv.value_of(item, e.count))])
	if "description" in item and String(item.get("description")) != "":
		lines.append(String(item.get("description")))
	lines.append("우클릭: %s(으)로 보내기" % ("가방" if inv == stash else "창고"))
	_tooltip_label.text = "\n".join(lines)
	_tooltip.visible = true
	_tooltip.reset_size()
	_tooltip.position = (at + Vector2(16, 16)).min(get_viewport_rect().size - _tooltip.size)


func hide_tooltip() -> void:
	if _tooltip != null:
		_tooltip.visible = false


func label_for(item: Resource, count: int) -> String:
	var text := ""
	if item != null and "display_name" in item:
		text = String(item.get("display_name"))
	if text.is_empty() and item != null and "item_id" in item:
		text = String(item.get("item_id"))
	return text if count <= 1 else "%s x%d" % [text, count]


static func rarity_color(item: Resource) -> Color:
	var rarity := String(item.get("rarity")) if item != null and "rarity" in item else "common"
	return RARITY_COLORS.get(rarity, RARITY_COLORS.common)


static func _thousands(n: int) -> String:
	var s := str(absi(n))
	var out := ""
	while s.length() > 3:
		out = "," + s.substr(s.length() - 3) + out
		s = s.substr(0, s.length() - 3)
	return ("-" if n < 0 else "") + s + out


## Moves between grids with the HideoutState helpers (or a plain add_item
## without the autoload).
func _transfer(from: Node, index: int, to: Node, cell: Vector2i, rotated: bool) -> int:
	if state != null:
		return state.transfer(from, index, to, cell, rotated)
	var e: Dictionary = from.entries[index]
	var count := int(e.count)
	if not to.add_item(e.item, count):
		return 0
	from.take_from(index)
	return count


func _move_all(from: Node, to: Node) -> Dictionary:
	if state != null:
		return state.move_all(from, to)
	var moved := {}
	var i: int = from.entries.size() - 1
	while i >= 0:
		var e: Dictionary = from.entries[i]
		if to.add_item(e.item, int(e.count)):
			moved[from.item_id_of(e.item)] = int(e.count)
			from.take_from(i)
		i -= 1
	return moved


# =============================================================================
# grid
# =============================================================================

class GridPane extends Control:
	var hideout: Node
	var inv: Node
	var cell := 44
	var _mouse := Vector2.ZERO
	var _hover := -1

	func _init() -> void:
		mouse_filter = Control.MOUSE_FILTER_STOP
		mouse_exited.connect(func():
			_hover = -1
			hideout.hide_tooltip()
			queue_redraw())

	func refresh() -> void:
		if inv == null:
			return
		custom_minimum_size = Vector2(inv.grid_width, inv.grid_height) * cell
		queue_redraw()

	func cell_at(local: Vector2) -> Vector2i:
		return Vector2i(floori(local.x / cell), floori(local.y / cell))

	## Cell the dragged stack's top-left lands on.
	func drop_cell(global_pos: Vector2, grab: Vector2) -> Vector2i:
		var local := get_global_transform_with_canvas().affine_inverse() * global_pos
		return cell_at(local - grab + Vector2(cell, cell) * 0.5)

	func _gui_input(event: InputEvent) -> void:
		if inv == null:
			return
		var drag: Dictionary = hideout.drag_info()
		if event is InputEventMouseMotion:
			_mouse = event.position
			if not drag.is_empty():
				hideout.update_drag(get_global_transform_with_canvas() * _mouse)
				return
			_hover = inv.entry_at(cell_at(_mouse))
			hideout.show_tooltip(inv, _hover, get_global_transform_with_canvas() * _mouse)
			queue_redraw()
		elif event is InputEventMouseButton:
			_mouse = event.position
			var index: int = inv.entry_at(cell_at(_mouse))
			if event.button_index == MOUSE_BUTTON_LEFT and event.pressed and drag.is_empty():
				if index < 0:
					return
				if event.shift_pressed:
					inv.split_entry(index)
					return
				var e: Dictionary = inv.entries[index]
				hideout.begin_drag(self, index, _mouse - Vector2(e.x, e.y) * cell)
			elif event.button_index == MOUSE_BUTTON_LEFT and not event.pressed and not drag.is_empty():
				hideout.end_drag(get_global_transform_with_canvas() * _mouse)
			elif event.button_index == MOUSE_BUTTON_RIGHT and event.pressed and index >= 0 and drag.is_empty():
				hideout.transfer_entry(inv, index)
				hideout.hide_tooltip()
			accept_event()

	func _draw() -> void:
		if inv == null:
			return
		var font := get_theme_default_font()
		var w: int = inv.grid_width
		var h: int = inv.grid_height
		draw_rect(Rect2(Vector2.ZERO, Vector2(w, h) * cell), Color(0.12, 0.13, 0.15))
		for y in h:
			for x in w:
				draw_rect(Rect2(Vector2(x, y) * cell + Vector2.ONE, Vector2(cell, cell) - Vector2.ONE * 2), Color(0.17, 0.18, 0.21))
		var drag: Dictionary = hideout.drag_info()
		for i in inv.entries.size():
			if not drag.is_empty() and drag.pane == self and i == drag.index:
				continue
			var e: Dictionary = inv.entries[i]
			draw_entry(self, hideout, font, e, Vector2(e.x, e.y) * cell, inv.item_size(e.item, e.rotated), cell, 1.0, i == _hover)
		if drag.is_empty():
			return
		var mouse: Vector2 = drag.mouse
		if not get_global_rect().has_point(mouse) or hideout.pane_at(mouse) != self:
			return
		var src: Node = drag.pane.inv
		var e: Dictionary = src.entries[drag.index]
		var size: Vector2i = inv.item_size(e.item, drag.rotated)
		var target := drop_cell(mouse, drag.grab)
		var under: int = inv.entry_at(target)
		var same: bool = under >= 0 and inv.item_id_of(inv.entries[under].item) == inv.item_id_of(e.item) and not (drag.pane == self and under == drag.index)
		var ok: bool = same or inv.is_area_free(target, size, drag.index if drag.pane == self else -1)
		if ok and drag.pane != self and float(inv.max_weight) > 0.0:
			ok = float(inv.get_total_weight()) + float(inv.weight_of(e.item)) <= float(inv.max_weight) + 0.0001
		var tint := Color(0.3, 0.9, 0.4, 0.35) if ok else Color(0.95, 0.3, 0.3, 0.35)
		draw_rect(Rect2(Vector2(target) * cell, Vector2(size) * cell), tint)

	static func draw_entry(canvas: CanvasItem, hideout_node: Node, font: Font, e: Dictionary, at: Vector2, size: Vector2i, cell_px: int, alpha: float, hovered: bool) -> void:
		var rect := Rect2(at + Vector2(2, 2), Vector2(size) * cell_px - Vector2(4, 4))
		var color: Color = hideout_node.rarity_color(e.item)
		var fill := color.darkened(0.55 if not hovered else 0.35)
		fill.a = alpha
		canvas.draw_rect(rect, fill)
		var border := color
		border.a = alpha
		canvas.draw_rect(rect, border, false, 2.0)
		var font_size := 12 if cell_px >= 40 else 10
		var text_width := rect.size.x - 8
		canvas.draw_multiline_string(font, rect.position + Vector2(4, 4 + font_size), hideout_node.label_for(e.item, 1), HORIZONTAL_ALIGNMENT_LEFT, text_width, font_size, 2, Color(1, 1, 1, alpha))
		if int(e.count) > 1:
			canvas.draw_string(font, rect.position + Vector2(4, rect.size.y - 5), "x%d" % e.count, HORIZONTAL_ALIGNMENT_RIGHT, text_width, font_size + 1, Color(1, 0.95, 0.7, alpha))


## Draws the stack being dragged under the mouse, above both grids.
class GhostLayer extends Control:
	var hideout: Node

	func _draw() -> void:
		var drag: Dictionary = hideout.drag_info()
		if drag.is_empty():
			return
		var inv: Node = drag.pane.inv
		if drag.index >= inv.entries.size():
			return
		var e: Dictionary = inv.entries[drag.index]
		var size: Vector2i = inv.item_size(e.item, drag.rotated)
		var at: Vector2 = get_global_transform_with_canvas().affine_inverse() * (drag.mouse - drag.grab)
		GridPane.draw_entry(self, hideout, get_theme_default_font(), e, at, size, hideout.cell_size, 0.85, false)
