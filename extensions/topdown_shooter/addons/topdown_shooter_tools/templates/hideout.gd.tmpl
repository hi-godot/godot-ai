extends Control

## Hideout screen (generated by hideout_scaffold).
##
## Two inventory.gd grids: the stash (`stash_path`, big, no weight limit)
## and the raid bag (`loadout_path`, the same size and weight limit as the
## player's raid inventory). Pack the bag and press 출격 to load the raid
## scene with it. Coming back from a raid, the bag moves into the stash on
## its own (what does not fit stays in the bag).
##
##   drag            move a stack, also between the stash and the bag
##   R (dragging)    rotate
##   right click     send a stack to the other grid
##   Shift+click     split a stack in half
##
## The HideoutState autoload keeps both grids in the save file; every
## change is saved right away. Without the autoload (scene run on its own)
## the screen still works but nothing is saved.
##
## Builds all its controls in code, so there is no scene to keep in sync.
## Free to edit: this file was copied into your project and is yours now.

signal deployed(scene: String)

const RARITY_COLORS := {
	"common": Color(0.62, 0.62, 0.62),
	"uncommon": Color(0.3, 0.75, 0.3),
	"rare": Color(0.3, 0.5, 0.95),
	"epic": Color(0.65, 0.3, 0.95),
	"legendary": Color(0.95, 0.6, 0.1),
}
const RARITY_NAMES := {
	"common": "일반", "uncommon": "고급", "rare": "희귀", "epic": "영웅", "legendary": "전설",
}

@export var title := "은신처"
## Raid scene for 출격. Empty: the HideoutState raid_scene setting.
@export_file("*.tscn") var raid_scene := ""
@export var stash_path: NodePath = ^"Stash"
@export var loadout_path: NodePath = ^"Loadout"
@export_range(24, 128) var cell_size := 44

var stash: Node
var loadout: Node
var state: Node
var summary := {}

var _panes: Array = []
var _drag := {}
var _loading := false
var _stash_label: Label
var _bag_label: Label
var _stats_label: Label
var _banner: PanelContainer
var _banner_label: Label
var _deploy_button: Button
var _reset_button: Button
var _reset_armed := 0.0
var _tooltip: PanelContainer
var _tooltip_label: Label
var _ghost: GhostLayer


func is_hideout() -> bool:
	return true


func _ready() -> void:
	add_to_group(&"hideout")
	set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	stash = get_node_or_null(stash_path)
	loadout = get_node_or_null(loadout_path)
	state = get_node_or_null(^"/root/HideoutState")
	_build()
	if stash == null or loadout == null:
		push_warning("Hideout: stash or loadout inventory node is missing (stash_path / loadout_path)")
		return
	_loading = true
	if state != null:
		summary = state.enter_hideout(self, stash, loadout)
	else:
		push_warning("Hideout: no HideoutState autoload; nothing is saved (run hideout_scaffold)")
	_loading = false
	stash.changed.connect(_on_changed)
	loadout.changed.connect(_on_changed)
	for pane in _panes:
		pane.refresh()
	_refresh()


func _process(delta: float) -> void:
	if _reset_armed > 0.0:
		_reset_armed -= delta
		if _reset_armed <= 0.0 and _reset_button != null:
			_reset_button.text = "처음부터"


func _input(event: InputEvent) -> void:
	if _drag.is_empty():
		return
	if event is InputEventKey and event.pressed and not event.echo and event.physical_keycode == KEY_R:
		rotate_drag()
		get_viewport().set_input_as_handled()
	elif event is InputEventKey and event.pressed and event.keycode == KEY_ESCAPE:
		cancel_drag()
		get_viewport().set_input_as_handled()


# --- actions ---------------------------------------------------------------------

## The raid scene 출격 loads.
func get_raid_scene() -> String:
	if not raid_scene.is_empty():
		return raid_scene
	return str(state.get("raid_scene")) if state != null else ""


## Packs nothing more: saves and loads the raid with the bag. Returns OK or
## an error.
func deploy() -> Error:
	var scene := get_raid_scene()
	if scene.is_empty() or not ResourceLoader.exists(scene):
		_flash("레이드 씬이 없습니다: %s" % scene)
		return ERR_FILE_NOT_FOUND
	deployed.emit(scene)
	if state != null:
		return state.deploy(stash, loadout, scene)
	return get_tree().change_scene_to_file(scene)


## Moves stack `index` of `from` to the other grid (to `cell`, or wherever
## it fits). Returns how many moved.
func transfer_entry(from: Node, index: int, cell := Vector2i(-1, -1), rotated := false) -> int:
	var to := loadout if from == stash else stash
	var moved := _transfer(from, index, to, cell, rotated)
	if moved == 0:
		var why := "공간이 없습니다"
		if index >= 0 and index < from.entries.size() and float(to.max_weight) > 0.0 \
				and float(to.get_total_weight()) + float(to.weight_of(from.entries[index].item)) > float(to.max_weight) + 0.0001:
			why = "가방이 너무 무겁습니다"
		_flash(why)
	return moved


## Empties the bag into the stash.
func unpack_bag() -> void:
	var moved := _move_all(loadout, stash)
	if moved.is_empty() and not loadout.entries.is_empty():
		_flash("창고에 공간이 없습니다")


func reset_game() -> void:
	if state == null:
		return
	state.new_game()
	get_tree().reload_current_scene()


# --- drag and drop (driven by the grids) ------------------------------------------

func begin_drag(pane: GridPane, index: int, grab: Vector2) -> void:
	var e: Dictionary = pane.inv.entries[index]
	_drag = {"pane": pane, "index": index, "rotated": bool(e.rotated), "grab": grab, "mouse": get_global_mouse_position()}
	hide_tooltip()
	_redraw_all()


func update_drag(global_pos: Vector2) -> void:
	if _drag.is_empty():
		return
	_drag.mouse = global_pos
	_redraw_all()


func end_drag(global_pos: Vector2) -> void:
	if _drag.is_empty():
		return
	var d := _drag
	_drag = {}
	var target := pane_at(global_pos)
	if target != null:
		var cell: Vector2i = target.drop_cell(global_pos, d.grab)
		if target == d.pane:
			target.inv.move_entry(d.index, cell, d.rotated)
		else:
			transfer_entry(d.pane.inv, d.index, cell, d.rotated)
	_redraw_all()


func cancel_drag() -> void:
	_drag = {}
	_redraw_all()


func rotate_drag() -> void:
	if _drag.is_empty() or not bool(_drag.pane.inv.allow_rotation):
		return
	_drag.rotated = not _drag.rotated
	var inv: Node = _drag.pane.inv
	var size: Vector2i = inv.item_size(inv.entries[_drag.index].item, _drag.rotated)
	_drag.grab = Vector2(size) * cell_size * 0.5
	_redraw_all()


func drag_info() -> Dictionary:
	return _drag


func pane_at(global_pos: Vector2) -> GridPane:
	for pane in _panes:
		if pane.is_visible_in_tree() and pane.get_global_rect().has_point(global_pos):
			var scroll := pane.get_parent() as ScrollContainer
			if scroll != null and not scroll.get_global_rect().has_point(global_pos):
				continue
			return pane
	return null


func _redraw_all() -> void:
	for pane in _panes:
		pane.queue_redraw()
	if _ghost != null:
		_ghost.queue_redraw()


# --- building -----------------------------------------------------------------------

func _build() -> void:
	var bg := ColorRect.new()
	bg.color = Color(0.07, 0.075, 0.085)
	bg.set_anchors_preset(Control.PRESET_FULL_RECT)
	bg.mouse_filter = Control.MOUSE_FILTER_IGNORE
	add_child(bg)

	var margin := MarginContainer.new()
	margin.set_anchors_preset(Control.PRESET_FULL_RECT)
	for side in ["left", "right", "top", "bottom"]:
		margin.add_theme_constant_override("margin_" + side, 20)
	add_child(margin)
	var column := VBoxContainer.new()
	column.add_theme_constant_override("separation", 12)
	margin.add_child(column)

	var header := HBoxContainer.new()
	header.add_theme_constant_override("separation", 16)
	column.add_child(header)
	var title_label := Label.new()
	title_label.text = title
	title_label.add_theme_font_size_override("font_size", 30)
	header.add_child(title_label)
	var spacer := Control.new()
	spacer.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	header.add_child(spacer)
	_stats_label = Label.new()
	_stats_label.add_theme_color_override("font_color", Color(0.75, 0.78, 0.82))
	header.add_child(_stats_label)
	_reset_button = Button.new()
	_reset_button.text = "처음부터"
	_reset_button.focus_mode = Control.FOCUS_NONE
	_reset_button.tooltip_text = "세이브를 지우고 새 게임을 시작합니다 (두 번 누르기)"
	_reset_button.pressed.connect(_on_reset_pressed)
	header.add_child(_reset_button)

	_banner = PanelContainer.new()
	_banner.visible = false
	column.add_child(_banner)
	_banner_label = Label.new()
	_banner_label.add_theme_font_size_override("font_size", 18)
	_banner_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	_banner.add_child(_banner_label)

	var body := HBoxContainer.new()
	body.size_flags_vertical = Control.SIZE_EXPAND_FILL
	body.add_theme_constant_override("separation", 24)
	column.add_child(body)

	## Stash (left, scrolls).
	var left := VBoxContainer.new()
	left.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	left.add_theme_constant_override("separation", 8)
	body.add_child(left)
	var left_head := HBoxContainer.new()
	left.add_child(left_head)
	_stash_label = Label.new()
	_stash_label.add_theme_font_size_override("font_size", 20)
	_stash_label.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	left_head.add_child(_stash_label)
	left_head.add_child(_button("정렬", func(): _sort(stash)))
	var scroll := ScrollContainer.new()
	scroll.size_flags_vertical = Control.SIZE_EXPAND_FILL
	scroll.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	scroll.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_AUTO
	left.add_child(scroll)
	var stash_pane := GridPane.new()
	stash_pane.name = "StashGrid"
	stash_pane.hideout = self
	stash_pane.inv = stash
	stash_pane.cell = cell_size
	scroll.add_child(stash_pane)
	_panes.append(stash_pane)

	## Raid bag (right).
	var right := VBoxContainer.new()
	right.add_theme_constant_override("separation", 8)
	body.add_child(right)
	var right_head := HBoxContainer.new()
	right.add_child(right_head)
	var bag_title := Label.new()
	bag_title.text = "출격 가방"
	bag_title.add_theme_font_size_override("font_size", 20)
	bag_title.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	right_head.add_child(bag_title)
	right_head.add_child(_button("정렬", func(): _sort(loadout)))
	right_head.add_child(_button("모두 창고로", unpack_bag))
	_bag_label = Label.new()
	right.add_child(_bag_label)
	var bag_pane := GridPane.new()
	bag_pane.name = "LoadoutGrid"
	bag_pane.hideout = self
	bag_pane.inv = loadout
	bag_pane.cell = cell_size
	bag_pane.size_flags_horizontal = Control.SIZE_SHRINK_BEGIN
	right.add_child(bag_pane)
	_panes.append(bag_pane)
	var fill := Control.new()
	fill.size_flags_vertical = Control.SIZE_EXPAND_FILL
	right.add_child(fill)
	_deploy_button = Button.new()
