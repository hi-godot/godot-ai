extends Node3D

## Drops loot from a loot table (generated by loot_table_edit).
##
## Put it under the thing that drops loot. When the parent emits
## `trigger_signal` (an enemy's `died` by default) it rolls `loot_table` and
## scatters one pickup per dropped item around the parent. A crate or any
## other source can call drop() itself instead (leave trigger_signal empty).
##
## Pickups are loot_pickup.gd nodes (or `pickup_scene` instances, which get
## `item_id`, `count` and `item` set when they have those properties).
##
## Free to edit: this file was copied into your project and is yours now.

signal dropped(drops: Array)

@export var loot_table: Resource
## Parent signal that triggers the drop. Empty: only drop() drops.
@export var trigger_signal: StringName = &"died"
## Drop only the first time (a dead enemy, an opened crate).
@export var drop_once := true
## Pickups land within this many meters of the source.
@export var scatter_radius := 0.8
## Optional scene to spawn instead of the built-in pickup.
@export var pickup_scene: PackedScene
## Script of the built-in pickup (loot_table_edit sets it to its copy).
@export_file("*.gd") var pickup_script_path := "res://scripts/topdown/loot_pickup.gd"

var has_dropped := false


func _ready() -> void:
	if Engine.is_editor_hint():
		return
	var source := get_parent()
	if source != null and trigger_signal != &"" and source.has_signal(trigger_signal):
		source.connect(trigger_signal, _on_trigger, CONNECT_DEFERRED)


func _on_trigger(_a = null, _b = null, _c = null) -> void:
	drop()


## Rolls the table and spawns the pickups. Returns the drops
## ([{"item_id", "count", "item"}]).
func drop(rng: RandomNumberGenerator = null) -> Array:
	if drop_once and has_dropped:
		return []
	has_dropped = true
	if loot_table == null or not loot_table.has_method("roll"):
		push_warning("%s: no loot_table to drop from" % get_path())
		return []
	var drops: Array = loot_table.roll(rng)
	var world := _spawn_parent()
	if world != null:
		var origin := global_position
		var i := 0
		for d in drops:
			var pickup := _make_pickup(d)
			world.add_child(pickup)
			var angle := TAU * float(i) / maxf(drops.size(), 1) + randf() * 0.5
			var r := scatter_radius * (0.5 + randf() * 0.5) if drops.size() > 1 else 0.0
			pickup.global_position = origin + Vector3(cos(angle) * r, 0.0, sin(angle) * r)
			i += 1
	dropped.emit(drops)
	return drops


func _make_pickup(d: Dictionary) -> Node3D:
	var pickup: Node3D
	if pickup_scene != null:
		pickup = pickup_scene.instantiate() as Node3D
	else:
		pickup = Area3D.new()
		pickup.set_script(load(pickup_script_path))
	for key in ["item_id", "count", "item"]:
		if key in pickup:
			pickup.set(key, d.get(key))
	pickup.name = "Loot_%s" % d.get("item_id", "item")
	return pickup


## Pickups go next to the source (it may be freed after dying), or into the
## current scene.
func _spawn_parent() -> Node:
	var source := get_parent()
	if source != null and source.get_parent() != null:
		return source.get_parent()
	return get_tree().current_scene if is_inside_tree() else null
