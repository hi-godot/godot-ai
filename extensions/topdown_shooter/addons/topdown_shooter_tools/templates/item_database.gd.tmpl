extends Resource

## Index of every item .tres (generated by item_db_import). Load it once and
## look items up by id:
##
##     var db := load("res://data/items/item_database.tres")
##     var bandage = db.get_item("bandage")
##
## Free to edit: this file was copied into your project and is yours now.

@export var items: Array[Resource] = []

var _by_id := {}


func get_item(item_id: String) -> Resource:
	if _by_id.size() != items.size():
		_rebuild()
	return _by_id.get(item_id)


func has_item(item_id: String) -> bool:
	return get_item(item_id) != null


func get_ids() -> PackedStringArray:
	var out := PackedStringArray()
	for item in items:
		if item != null:
			out.append(item.get("item_id"))
	return out


## Items whose `property` equals `value`, e.g. find_by("category", "medical").
func find_by(property: StringName, value: Variant) -> Array[Resource]:
	var out: Array[Resource] = []
	for item in items:
		if item != null and item.get(property) == value:
			out.append(item)
	return out


func find_by_tag(tag: String) -> Array[Resource]:
	var out: Array[Resource] = []
	for item in items:
		if item != null and PackedStringArray(item.get("tags")).has(tag):
			out.append(item)
	return out


func _rebuild() -> void:
	_by_id.clear()
	for item in items:
		if item != null:
			_by_id[item.get("item_id")] = item
