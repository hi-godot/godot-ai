extends Resource

## One item (generated by item_db_import). Each row of the item spreadsheet
## becomes one .tres using this script.
##
## Free to edit: this file was copied into your project and is yours now.
## Add an @export var and a spreadsheet column with the same name, and the
## next import fills it in (numbers, bools, strings, enums, arrays and
## res:// resource paths are converted for you).

@export var item_id := ""
@export var display_name := ""
@export_multiline var description := ""
@export_enum("weapon", "ammo", "armor", "helmet", "backpack", "medical", "food", "key", "valuable", "material", "misc") var category := "misc"
@export_enum("common", "uncommon", "rare", "epic", "legendary") var rarity := "common"
@export var icon: Texture2D
## Kilograms per unit.
@export var weight := 0.1
## Sell price per unit.
@export var value := 10
## 1 = does not stack.
@export var max_stack := 1
## Cells the item takes in a grid inventory.
@export var grid_width := 1
@export var grid_height := 1
## Weapon stats .tres from weapon_create, for category "weapon".
@export var weapon: Resource
## Ammo type this item is, or a weapon uses (e.g. 9mm).
@export var ammo_type := ""
## Free-form labels for loot tables and filters (e.g. quest, food).
@export var tags: Array[String] = []
## Spreadsheet columns with no matching property, as column -> value.
@export var extra := {}


func get_stack_weight(count: int) -> float:
	return weight * count


func get_stack_value(count: int) -> int:
	return value * count


func has_tag(tag: String) -> bool:
	return tags.has(tag)
