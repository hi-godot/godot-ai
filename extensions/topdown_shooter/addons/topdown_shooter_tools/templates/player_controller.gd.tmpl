extends CharacterBody3D

## Top-down player controller (generated by player_controller_scaffold).
##
## WASD moves relative to the active camera, the body's Aim pivot turns
## toward the mouse cursor on a horizontal plane, and the dodge action
## performs a short dash (optionally invulnerable). A weapon placed under
## Aim/WeaponMount that has try_fire()/reload() is driven by the fire and
## reload actions. Anything can damage the player through take_damage().
##
## Free to edit: this file was copied into your project and is yours now.

signal health_changed(current: float, maximum: float)
signal died
signal dodged(direction: Vector3)

@export_group("Movement")
@export var move_speed := 6.0
@export var acceleration := 40.0
@export var deceleration := 50.0
## How fast the aim pivot turns toward the cursor. 0 turns instantly.
@export var turn_speed := 20.0

@export_group("Dodge")
@export var dodge_speed := 14.0
@export var dodge_duration := 0.25
@export var dodge_cooldown := 0.6
@export var invulnerable_while_dodging := true

@export_group("Health")
@export var max_health := 100.0

@export_group("Aim")
## Height above the player's origin of the plane the cursor is projected on.
@export var aim_height := 1.2
@export var aim_pivot_path: NodePath = ^"Aim"
@export var weapon_mount_path: NodePath = ^"Aim/WeaponMount"

@export_group("Input actions")
@export var action_move_left: StringName = &"move_left"
@export var action_move_right: StringName = &"move_right"
@export var action_move_forward: StringName = &"move_forward"
@export var action_move_back: StringName = &"move_back"
@export var action_dodge: StringName = &"dodge"
@export var action_fire: StringName = &"fire"
@export var action_reload: StringName = &"reload"

var health := 0.0
## World point the player is aiming at (on the aim plane).
var aim_point := Vector3.ZERO
var is_dead := false

var _dodge_time_left := 0.0
var _dodge_cooldown_left := 0.0
var _dodge_direction := Vector3.ZERO
## Last cursor position seen in a mouse event (viewport coordinates), so
## synthetic input (tests, MCP game_manage input_mouse) can aim as well.
var _cursor: Variant = null

@onready var _aim_pivot: Node3D = get_node_or_null(aim_pivot_path) as Node3D
@onready var _gravity: float = ProjectSettings.get_setting("physics/3d/default_gravity", 9.8)


func _ready() -> void:
	add_to_group("player")
	health = max_health
	aim_point = global_position - global_basis.z


func _input(event: InputEvent) -> void:
	if event is InputEventMouse:
		_cursor = event.position


func is_dodging() -> bool:
	return _dodge_time_left > 0.0


func _physics_process(delta: float) -> void:
	if is_dead:
		return
	_dodge_time_left = maxf(_dodge_time_left - delta, 0.0)
	_dodge_cooldown_left = maxf(_dodge_cooldown_left - delta, 0.0)

	var input := Input.get_vector(action_move_left, action_move_right, action_move_forward, action_move_back)
	var move_dir := _camera_relative(input)

	if Input.is_action_just_pressed(action_dodge) and _dodge_cooldown_left <= 0.0:
		_start_dodge(move_dir)

	var horizontal := Vector3(velocity.x, 0.0, velocity.z)
	if is_dodging():
		horizontal = _dodge_direction * dodge_speed
	elif move_dir != Vector3.ZERO:
		horizontal = horizontal.move_toward(move_dir * move_speed, acceleration * delta)
	else:
		horizontal = horizontal.move_toward(Vector3.ZERO, deceleration * delta)
	velocity.x = horizontal.x
	velocity.z = horizontal.z
	if is_on_floor():
		velocity.y = 0.0
	else:
		velocity.y -= _gravity * delta
	move_and_slide()

	_update_aim(delta)
	_drive_weapon()


## Applies damage unless the player is dodging with invulnerability.
## `info` is free-form (source, position, direction, weapon...).
func take_damage(amount: float, _info: Dictionary = {}) -> void:
	if is_dead or (is_dodging() and invulnerable_while_dodging):
		return
	health = maxf(health - amount, 0.0)
	health_changed.emit(health, max_health)
	if health <= 0.0:
		is_dead = true
		died.emit()


func heal(amount: float) -> void:
	if is_dead:
		return
	health = minf(health + amount, max_health)
	health_changed.emit(health, max_health)


## First node under the weapon mount that can fire, or null.
func get_weapon() -> Node:
	var mount := get_node_or_null(weapon_mount_path)
	if mount == null:
		return null
	for child in mount.get_children():
		if child.has_method("try_fire"):
			return child
	return null


func _start_dodge(move_dir: Vector3) -> void:
	var dir := move_dir
	if dir == Vector3.ZERO:
		dir = _facing()
	_dodge_direction = dir.normalized()
	_dodge_time_left = dodge_duration
	_dodge_cooldown_left = dodge_cooldown
	dodged.emit(_dodge_direction)


func _camera_relative(input: Vector2) -> Vector3:
	if input == Vector2.ZERO:
		return Vector3.ZERO
	var camera := get_viewport().get_camera_3d()
	if camera == null:
		return Vector3(input.x, 0.0, input.y).limit_length(1.0)
	var forward := -camera.global_basis.z
	forward.y = 0.0
	var right := camera.global_basis.x
	right.y = 0.0
	if forward.length_squared() < 0.0001 or right.length_squared() < 0.0001:
		return Vector3(input.x, 0.0, input.y).limit_length(1.0)
	var dir := right.normalized() * input.x - forward.normalized() * input.y
	return dir.limit_length(1.0)


func _update_aim(delta: float) -> void:
	var camera := get_viewport().get_camera_3d()
	if camera != null:
		var mouse: Vector2 = _cursor if _cursor != null else get_viewport().get_mouse_position()
		var plane := Plane(Vector3.UP, global_position.y + aim_height)
		var hit: Variant = plane.intersects_ray(camera.project_ray_origin(mouse), camera.project_ray_normal(mouse))
		if hit != null:
			aim_point = hit
	if _aim_pivot == null:
		return
	var look := aim_point - global_position
	look.y = 0.0
	if look.length_squared() < 0.0001:
		return
	var target_yaw := atan2(-look.x, -look.z)
	var current := _aim_pivot.global_rotation
	if turn_speed <= 0.0:
		current.y = target_yaw
	else:
		current.y = lerp_angle(current.y, target_yaw, 1.0 - exp(-turn_speed * delta))
	_aim_pivot.global_rotation = current


func _facing() -> Vector3:
	var pivot_basis := _aim_pivot.global_basis if _aim_pivot != null else global_basis
	var forward := -pivot_basis.z
	forward.y = 0.0
	return forward.normalized() if forward != Vector3.ZERO else Vector3.FORWARD


func _drive_weapon() -> void:
	var weapon := get_weapon()
	if weapon == null:
		return
	if Input.is_action_just_pressed(action_reload) and weapon.has_method("reload"):
		weapon.reload()
	if is_dodging():
		return
	var automatic: bool = weapon.has_method("is_automatic") and weapon.is_automatic()
	var wants_fire := Input.is_action_pressed(action_fire) if automatic else Input.is_action_just_pressed(action_fire)
	if wants_fire:
		weapon.try_fire(aim_point)
