extends Area3D

## A dropped item on the ground (generated by loot_table_edit). It builds
## its own collision, a box colored by rarity and a name label, bobs in
## place, and is collected when a body in `collector_group` touches it.
##
## Collecting calls `add_item(item, count)` on the collector when it has
## that method (an inventory). If add_item returns false (full), the pickup
## stays. Without the method the pickup is collected anyway and only the
## `picked_up` signal reports it.
##
## Free to edit: this file was copied into your project and is yours now.

signal picked_up(collector: Node, item_id: String, count: int)

const RARITY_COLORS := {
	"common": Color(0.8, 0.8, 0.8),
	"uncommon": Color(0.35, 0.85, 0.35),
	"rare": Color(0.3, 0.55, 1.0),
	"epic": Color(0.7, 0.35, 1.0),
	"legendary": Color(1.0, 0.65, 0.1),
}

@export var item_id := ""
@export var count := 1
@export var item: Resource
@export var collector_group: StringName = &"player"
## Seconds after spawning before it can be collected.
@export var pickup_delay := 0.4
@export var radius := 0.6
@export var bob_height := 0.12
@export var hover_height := 0.35

var _age := 0.0
var _visual: Node3D


func _ready() -> void:
	add_to_group(&"loot_pickup")
	monitoring = true
	monitorable = false
	if get_child_count() == 0:
		_build()
	_visual = get_node_or_null(^"Visual") as Node3D
	body_entered.connect(_on_body_entered)


func _process(delta: float) -> void:
	_age += delta
	if _visual != null:
		_visual.position.y = hover_height + sin(_age * 3.0) * bob_height
		_visual.rotate_y(delta * 1.5)
	if _age >= pickup_delay and _age - delta < pickup_delay:
		for body in get_overlapping_bodies():
			if _try_collect(body):
				return


func get_display_name() -> String:
	var label := item_id
	if item != null and String(item.get("display_name")) != "":
		label = String(item.get("display_name"))
	return label if count <= 1 else "%s x%d" % [label, count]


func _on_body_entered(body: Node) -> void:
	if _age >= pickup_delay:
		_try_collect(body)


func _try_collect(body: Node) -> bool:
	if not body.is_in_group(collector_group) or is_queued_for_deletion():
		return false
	if body.has_method("add_item"):
		var accepted: Variant = body.add_item(item if item != null else item_id, count)
		if accepted is bool and not accepted:
			return false
	picked_up.emit(body, item_id, count)
	queue_free()
	return true


func _build() -> void:
	var shape := CollisionShape3D.new()
	var sphere := SphereShape3D.new()
	sphere.radius = radius
	shape.shape = sphere
	shape.position.y = hover_height
	add_child(shape)

	var visual := Node3D.new()
	visual.name = "Visual"
	add_child(visual)
	var mesh := MeshInstance3D.new()
	var box := BoxMesh.new()
	box.size = Vector3(0.3, 0.3, 0.3)
	var mat := StandardMaterial3D.new()
	var rarity := String(item.get("rarity")) if item != null else "common"
	mat.albedo_color = RARITY_COLORS.get(rarity, RARITY_COLORS.common)
	mat.emission_enabled = true
	mat.emission = mat.albedo_color * 0.4
	box.material = mat
	mesh.mesh = box
	visual.add_child(mesh)

	var label := Label3D.new()
	label.text = get_display_name()
	label.billboard = BaseMaterial3D.BILLBOARD_ENABLED
	label.no_depth_test = true
	label.font_size = 28
	label.pixel_size = 0.01
	label.outline_size = 6
	label.position.y = hover_height + 0.45
	add_child(label)
