extends CanvasLayer

## Inventory screen (generated by inventory_ui_scaffold).
##
## Shows the inventory.gd grid of `inventory_path` (default: the first node
## in group "inventory"). The toggle action (Tab / I) opens and closes it;
## Esc closes it. While it is open the owner (the player) stops moving and
## shooting when `block_owner_while_open` is on.
##
##   drag          move a stack (drop on the same item to merge)
##   R (dragging)  rotate
##   right click   drop the stack on the ground
##   Shift+click   split a stack in half
##
## A small HUD line shows the bag weight while the screen is closed, and
## pickups / full-bag messages appear above it.
##
## Builds all its controls in code, so there is no scene to keep in sync.
## Free to edit: this file was copied into your project and is yours now.

signal opened
signal closed

const RARITY_COLORS := {
	"common": Color(0.62, 0.62, 0.62),
	"uncommon": Color(0.3, 0.75, 0.3),
	"rare": Color(0.3, 0.5, 0.95),
	"epic": Color(0.65, 0.3, 0.95),
	"legendary": Color(0.95, 0.6, 0.1),
}
const CATEGORY_NAMES := {
	"weapon": "무기", "ammo": "탄약", "armor": "방어구", "helmet": "헬멧",
	"backpack": "가방", "medical": "의료", "food": "음식", "key": "열쇠",
	"valuable": "귀중품", "material": "재료", "misc": "기타",
}
const RARITY_NAMES := {
	"common": "일반", "uncommon": "고급", "rare": "희귀", "epic": "영웅", "legendary": "전설",
}

@export var inventory_path: NodePath
@export var toggle_action: StringName = &"inventory"
@export var title := "인벤토리"
@export_range(24, 128) var cell_size := 56
@export var block_owner_while_open := true
@export var show_hud := true
@export var start_open := false

var inventory: Node
var is_open := false

var _root: Control
var _panel: PanelContainer
var _grid: GridView
var _weight_label: Label
var _value_label: Label
var _tooltip: PanelContainer
var _tooltip_label: Label
var _hud: Label
var _toasts: VBoxContainer


func _ready() -> void:
	layer = 10
	inventory = get_node_or_null(inventory_path) if not inventory_path.is_empty() else null
	if inventory == null:
		inventory = get_tree().get_first_node_in_group(&"inventory")
	if inventory == null:
		## The inventory may be added after us (instanced later in the tree).
		await get_tree().process_frame
		inventory = get_tree().get_first_node_in_group(&"inventory")
	_build()
	if inventory == null:
		push_warning("InventoryUI: no inventory found (set inventory_path)")
		return
	inventory.changed.connect(_refresh)
	inventory.item_added.connect(func(item, count): _toast("+ %s" % _label_for(item, count), Color(0.75, 1.0, 0.75)))
	inventory.add_failed.connect(_on_add_failed)
	inventory.item_dropped.connect(func(item, count, _p): _toast("- %s" % _label_for(item, count), Color(1.0, 0.85, 0.6)))
	_grid.inventory = inventory
	_refresh()
	set_open(start_open)


func _input(event: InputEvent) -> void:
	if event is InputEventKey and event.pressed and not event.echo:
		if toggle_action != &"" and InputMap.has_action(toggle_action) and event.is_action_pressed(toggle_action):
			toggle()
			get_viewport().set_input_as_handled()
		elif is_open and event.keycode == KEY_ESCAPE:
			set_open(false)
			get_viewport().set_input_as_handled()
		elif is_open and event.physical_keycode == KEY_R and _grid.drag_index >= 0:
			_grid.rotate_drag()
			get_viewport().set_input_as_handled()


func toggle() -> void:
	set_open(not is_open)


func set_open(value: bool) -> void:
	if _root == null:
		return
	if value and inventory == null:
		return
	var was := is_open
	is_open = value
	_panel.visible = value
	_root.get_node("Dim").visible = value
	_tooltip.visible = false
	_hud.visible = show_hud and not value and inventory != null
	_grid.cancel_drag()
	_block_owner(value)
	if value != was:
		if value:
			opened.emit()
		else:
			closed.emit()


func _block_owner(block: bool) -> void:
	if not block_owner_while_open or inventory == null:
		return
	var body := inventory.get_parent()
	if body == null:
		return
	body.set_physics_process(not block)
	if block and "velocity" in body:
		body.set("velocity", Vector3.ZERO)


# --- building -------------------------------------------------------------------

func _build() -> void:
	_root = Control.new()
	_root.name = "Root"
	_root.set_anchors_preset(Control.PRESET_FULL_RECT)
	_root.mouse_filter = Control.MOUSE_FILTER_IGNORE
	add_child(_root)

	var dim := ColorRect.new()
	dim.name = "Dim"
	dim.color = Color(0, 0, 0, 0.45)
	dim.set_anchors_preset(Control.PRESET_FULL_RECT)
	dim.mouse_filter = Control.MOUSE_FILTER_STOP
	dim.visible = false
	_root.add_child(dim)

	var center := CenterContainer.new()
	center.set_anchors_preset(Control.PRESET_FULL_RECT)
	center.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_root.add_child(center)

	_panel = PanelContainer.new()
	_panel.name = "Panel"
	_panel.visible = false
	_panel.add_theme_stylebox_override("panel", _box(Color(0.09, 0.1, 0.12, 0.96), Color(0.35, 0.38, 0.42), 2, 8))
	center.add_child(_panel)

	var margin := MarginContainer.new()
	for side in ["left", "right", "top", "bottom"]:
		margin.add_theme_constant_override("margin_" + side, 14)
	_panel.add_child(margin)
	var column := VBoxContainer.new()
	column.add_theme_constant_override("separation", 10)
	margin.add_child(column)

	var header := HBoxContainer.new()
	header.add_theme_constant_override("separation", 16)
	column.add_child(header)
	var title_label := Label.new()
	title_label.text = title
	title_label.add_theme_font_size_override("font_size", 22)
	header.add_child(title_label)
	var spacer := Control.new()
	spacer.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	header.add_child(spacer)
	_weight_label = Label.new()
	header.add_child(_weight_label)
	_value_label = Label.new()
	_value_label.add_theme_color_override("font_color", Color(1.0, 0.85, 0.4))
	header.add_child(_value_label)

	_grid = GridView.new()
	_grid.name = "Grid"
	_grid.ui = self
	_grid.cell = cell_size
	_grid.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
	column.add_child(_grid)

	var footer := HBoxContainer.new()
	footer.add_theme_constant_override("separation", 8)
	column.add_child(footer)
	var hint := Label.new()
	hint.text = "드래그: 이동 · R: 회전 · 우클릭: 버리기 · Shift+클릭: 나누기"
	hint.add_theme_font_size_override("font_size", 12)
	hint.add_theme_color_override("font_color", Color(0.65, 0.67, 0.7))
	hint.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	footer.add_child(hint)
	for spec in [["정렬", _on_sort], ["닫기", func(): set_open(false)]]:
		var button := Button.new()
		button.text = spec[0]
		button.focus_mode = Control.FOCUS_NONE
		button.pressed.connect(spec[1])
		footer.add_child(button)

	_tooltip = PanelContainer.new()
	_tooltip.name = "Tooltip"
	_tooltip.visible = false
	_tooltip.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_tooltip.add_theme_stylebox_override("panel", _box(Color(0.05, 0.05, 0.06, 0.95), Color(0.5, 0.5, 0.55), 1, 4, 8))
	_tooltip_label = Label.new()
	_tooltip_label.add_theme_font_size_override("font_size", 13)
	_tooltip.add_child(_tooltip_label)
	_root.add_child(_tooltip)

	var bottom := VBoxContainer.new()
	bottom.anchor_top = 1.0
	bottom.anchor_bottom = 1.0
	bottom.offset_left = 16
	bottom.offset_top = -16
	bottom.offset_bottom = -16
	bottom.grow_vertical = Control.GROW_DIRECTION_BEGIN
	bottom.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_root.add_child(bottom)
	_toasts = VBoxContainer.new()
	_toasts.mouse_filter = Control.MOUSE_FILTER_IGNORE
	bottom.add_child(_toasts)
	_hud = Label.new()
	_hud.add_theme_color_override("font_outline_color", Color.BLACK)
	_hud.add_theme_constant_override("outline_size", 4)
	bottom.add_child(_hud)


func _box(fill: Color, border: Color, width: int, radius: int, pad := 0) -> StyleBoxFlat:
	var box := StyleBoxFlat.new()
	box.bg_color = fill
	box.border_color = border
	box.set_border_width_all(width)
	box.set_corner_radius_all(radius)
	box.set_content_margin_all(pad)
	return box


# --- updates --------------------------------------------------------------------

func _refresh() -> void:
	if inventory == null:
		return
	var weight: float = inventory.get_total_weight()
	var limit: float = inventory.max_weight
	var text := "무게 %.1f" % weight + (" / %.0f kg" % limit if limit > 0.0 else " kg")
	var factor: float = inventory.get_speed_factor()
	if factor < 0.999:
		text += "  (속도 %d%%)" % roundi(factor * 100.0)
	_weight_label.text = text
	var heavy: bool = factor < 0.999 or (limit > 0.0 and weight >= limit * 0.95)
	_weight_label.add_theme_color_override("font_color", Color(1.0, 0.55, 0.45) if heavy else Color(0.85, 0.88, 0.9))
	_value_label.text = "가치 ₩%s" % _thousands(inventory.get_total_value())
	_hud.text = "가방 %.1f%s  [%s]" % [weight, "/%.0fkg" % limit if limit > 0.0 else "kg", _toggle_key_name()]
	_grid.refresh()


func _on_sort() -> void:
	if not inventory.sort_items():
		_toast("정렬할 공간이 없습니다", Color(1.0, 0.6, 0.5))


func _on_add_failed(item: Resource, count: int, reason: String) -> void:
	var why: String = {"weight": "너무 무겁습니다", "space": "가방에 공간이 없습니다"}.get(reason, "알 수 없는 아이템")
	_toast("%s: %s" % [_label_for(item, count) if item != null else "?", why], Color(1.0, 0.55, 0.45))


func _toast(text: String, color: Color) -> void:
	if _toasts == null:
		return
	var label := Label.new()
	label.text = text
	label.add_theme_color_override("font_color", color)
	label.add_theme_color_override("font_outline_color", Color.BLACK)
	label.add_theme_constant_override("outline_size", 4)
	_toasts.add_child(label)
	while _toasts.get_child_count() > 5:
		_toasts.get_child(0).free()
	var tween := label.create_tween()
	tween.tween_interval(1.8)
	tween.tween_property(label, "modulate:a", 0.0, 0.6)
	tween.tween_callback(label.queue_free)


func show_tooltip(index: int, at: Vector2) -> void:
	if index < 0 or inventory == null or index >= inventory.entries.size():
		_tooltip.visible = false
		return
	var e: Dictionary = inventory.entries[index]
	var item: Resource = e.item
	var lines: Array[String] = [_label_for(item, int(e.count))]
	var category := String(item.get("category")) if "category" in item else ""
	var rarity := String(item.get("rarity")) if "rarity" in item else ""
	lines.append("%s · %s" % [CATEGORY_NAMES.get(category, category), RARITY_NAMES.get(rarity, rarity)])
	lines.append("무게 %.2f kg (개당 %.2f)" % [inventory.weight_of(item, e.count), inventory.weight_of(item)])
	lines.append("가치 ₩%s (개당 ₩%s)" % [_thousands(inventory.value_of(item, e.count)), _thousands(inventory.value_of(item))])
	var size: Vector2i = inventory.item_size(item)
	lines.append("크기 %dx%d · 최대 %d개" % [size.x, size.y, inventory.max_stack_of(item)])
	if "description" in item and String(item.get("description")) != "":
		lines.append(String(item.get("description")))
	_tooltip_label.text = "\n".join(lines)
	_tooltip.visible = true
	_tooltip.reset_size()
	var view := _root.get_viewport_rect().size
	_tooltip.position = (at + Vector2(16, 16)).min(view - _tooltip.size)


func hide_tooltip() -> void:
	_tooltip.visible = false


func _label_for(item: Resource, count: int) -> String:
	var text := ""
	if item != null and "display_name" in item:
		text = String(item.get("display_name"))
	if text.is_empty() and item != null and "item_id" in item:
		text = String(item.get("item_id"))
	return text if count <= 1 else "%s x%d" % [text, count]


func _toggle_key_name() -> String:
	if toggle_action == &"" or not InputMap.has_action(toggle_action):
		return "?"
	var names: Array[String] = []
	for ev in InputMap.action_get_events(toggle_action):
		if ev is InputEventKey:
			var code: Key = ev.physical_keycode if ev.physical_keycode != KEY_NONE else ev.keycode
			names.append(OS.get_keycode_string(code))
	return "/".join(names)


static func _thousands(n: int) -> String:
	var s := str(absi(n))
	var out := ""
	while s.length() > 3:
		out = "," + s.substr(s.length() - 3) + out
		s = s.substr(0, s.length() - 3)
	return ("-" if n < 0 else "") + s + out


static func rarity_color(item: Resource) -> Color:
	var rarity := String(item.get("rarity")) if item != null and "rarity" in item else "common"
	return RARITY_COLORS.get(rarity, RARITY_COLORS.common)


# =============================================================================
# grid
# =============================================================================

class GridView extends Control:
	var ui: Node
	var inventory: Node
	var cell := 56
	var drag_index := -1
	var drag_rotated := false
	var drag_grab := Vector2.ZERO
	var _mouse := Vector2.ZERO
	var _hover := -1

	func _init() -> void:
		mouse_filter = Control.MOUSE_FILTER_STOP
		mouse_exited.connect(func():
			_hover = -1
			ui.hide_tooltip()
			queue_redraw())

	func refresh() -> void:
		if inventory == null:
			return
		custom_minimum_size = Vector2(inventory.grid_width, inventory.grid_height) * cell
		if drag_index >= inventory.entries.size():
			cancel_drag()
		queue_redraw()

	func cancel_drag() -> void:
		drag_index = -1
		queue_redraw()

	func rotate_drag() -> void:
		if drag_index >= 0 and inventory.allow_rotation:
			drag_rotated = not drag_rotated
			var size: Vector2i = inventory.item_size(inventory.entries[drag_index].item, drag_rotated)
			drag_grab = Vector2(size) * cell * 0.5
			queue_redraw()

	func _cell_at(pos: Vector2) -> Vector2i:
		return Vector2i(floori(pos.x / cell), floori(pos.y / cell))

	func _drop_cell() -> Vector2i:
		return _cell_at(_mouse - drag_grab + Vector2(cell, cell) * 0.5)

	func _gui_input(event: InputEvent) -> void:
		if inventory == null:
			return
		if event is InputEventMouseMotion:
			_mouse = event.position
			var hover: int = inventory.entry_at(_cell_at(_mouse)) if drag_index < 0 else -1
			_hover = hover
			ui.show_tooltip(hover, get_global_transform_with_canvas() * _mouse)
			queue_redraw()
		elif event is InputEventMouseButton:
			_mouse = event.position
			var index: int = inventory.entry_at(_cell_at(_mouse))
			if event.button_index == MOUSE_BUTTON_LEFT and event.pressed:
				if index < 0:
					return
				if event.shift_pressed:
					inventory.split_entry(index)
					return
				drag_index = index
				var e: Dictionary = inventory.entries[index]
				drag_rotated = e.rotated
				drag_grab = _mouse - Vector2(e.x, e.y) * cell
				ui.hide_tooltip()
				queue_redraw()
			elif event.button_index == MOUSE_BUTTON_LEFT and not event.pressed and drag_index >= 0:
				var moving := drag_index
				drag_index = -1
				inventory.move_entry(moving, _drop_cell(), drag_rotated)
				queue_redraw()
			elif event.button_index == MOUSE_BUTTON_RIGHT and event.pressed and index >= 0 and drag_index < 0:
				inventory.drop_entry(index)
				ui.hide_tooltip()
			accept_event()

	func _draw() -> void:
		if inventory == null:
			return
		var font := get_theme_default_font()
		var w: int = inventory.grid_width
		var h: int = inventory.grid_height
		draw_rect(Rect2(Vector2.ZERO, Vector2(w, h) * cell), Color(0.13, 0.14, 0.16))
		for y in h:
			for x in w:
				draw_rect(Rect2(Vector2(x, y) * cell + Vector2.ONE, Vector2(cell, cell) - Vector2.ONE * 2), Color(0.18, 0.19, 0.22))
		for i in inventory.entries.size():
			if i == drag_index:
				continue
			_draw_entry(font, inventory.entries[i], Vector2(inventory.entries[i].x, inventory.entries[i].y) * cell, inventory.item_size(inventory.entries[i].item, inventory.entries[i].rotated), 1.0, i == _hover)
		if drag_index >= 0 and drag_index < inventory.entries.size():
			var e: Dictionary = inventory.entries[drag_index]
			var size: Vector2i = inventory.item_size(e.item, drag_rotated)
			var target := _drop_cell()
			var under: int = inventory.entry_at(target)
			var ok: bool = inventory.is_area_free(target, size, drag_index) or (under >= 0 and under != drag_index and inventory.item_id_of(inventory.entries[under].item) == inventory.item_id_of(e.item))
			var tint := Color(0.3, 0.9, 0.4, 0.35) if ok else Color(0.95, 0.3, 0.3, 0.35)
			draw_rect(Rect2(Vector2(target) * cell, Vector2(size) * cell), tint)
			_draw_entry(font, e, _mouse - drag_grab, size, 0.85, false)

	func _draw_entry(font: Font, e: Dictionary, at: Vector2, size: Vector2i, alpha: float, hovered: bool) -> void:
		var rect := Rect2(at + Vector2(2, 2), Vector2(size) * cell - Vector2(4, 4))
		var color: Color = ui.rarity_color(e.item)
		var fill := color.darkened(0.55)
		if hovered:
			fill = color.darkened(0.35)
		fill.a = alpha
		draw_rect(rect, fill)
		var border := color
		border.a = alpha
		draw_rect(rect, border, false, 2.0)
		var label_text: String = ui._label_for(e.item, 1)
		var font_size := 12 if cell >= 48 else 10
		var text_width := rect.size.x - 8
		draw_multiline_string(font, rect.position + Vector2(4, 4 + font_size), label_text, HORIZONTAL_ALIGNMENT_LEFT, text_width, font_size, 2, Color(1, 1, 1, alpha))
		if int(e.count) > 1:
			draw_string(font, rect.position + Vector2(4, rect.size.y - 5), "x%d" % e.count, HORIZONTAL_ALIGNMENT_RIGHT, text_width, font_size + 1, Color(1, 0.95, 0.7, alpha))
