extends Node3D

## Bullet projectile (generated by weapon_create).
##
## Moves in a straight line and ray-checks each physics step so fast
## bullets cannot tunnel through thin walls. On a hit it lets the weapon
## that fired it apply damage, then frees itself.
##
## Free to edit: this file was copied into your project and is yours now.

var velocity := Vector3.ZERO
var max_distance := 50.0
var collision_mask := 1

var _weapon: Node = null
var _exclude: Array[RID] = []
var _travelled := 0.0


func setup(weapon: Node, initial_velocity: Vector3, distance: float, mask: int, exclude: Array[RID]) -> void:
	_weapon = weapon
	velocity = initial_velocity
	max_distance = distance
	collision_mask = mask
	_exclude = exclude
	if velocity.length_squared() > 0.0001:
		look_at(global_position + velocity, Vector3.UP)


func _physics_process(delta: float) -> void:
	var step := velocity * delta
	var from := global_position
	var to := from + step
	var query := PhysicsRayQueryParameters3D.create(from, to, collision_mask, _exclude)
	var result := get_world_3d().direct_space_state.intersect_ray(query)
	if not result.is_empty():
		if is_instance_valid(_weapon) and _weapon.has_method("apply_hit"):
			_weapon.apply_hit(result.collider, result.position, velocity.normalized())
		queue_free()
		return
	global_position = to
	_travelled += step.length()
	if _travelled >= max_distance:
		queue_free()
