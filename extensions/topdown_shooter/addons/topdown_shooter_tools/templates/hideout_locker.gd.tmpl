extends StaticBody3D

## Stash locker of the 3D hideout (generated by hideout_scaffold with
## style="map").
##
## The hideout map (hideout_map.gd) opens the stash screen when the player
## presses interact within `interact_radius` meters of this locker. The
## label lights up while the player is in reach.
##
## Free to edit: this file was copied into your project and is yours now.

@export var locker_name := "창고"
## Reach, in meters on the floor plane, from the locker's origin.
@export var interact_radius := 2.2
@export var player_group: StringName = &"player"

var _label: Label3D
var _lit := false


func _ready() -> void:
	add_to_group(&"hideout_locker")
	_label = get_node_or_null(^"Label") as Label3D
	if _label != null:
		_label.text = locker_name
	set_process(not Engine.is_editor_hint())


func _process(_delta: float) -> void:
	var player := get_tree().get_first_node_in_group(player_group) as Node3D
	var lit := player != null and can_reach(player)
	if lit == _lit or _label == null:
		return
	_lit = lit
	_label.modulate = Color(1.0, 0.9, 0.4) if lit else Color(0.75, 0.85, 1.0)


func can_reach(body: Node3D) -> bool:
	var a := global_position
	var b := body.global_position
	return Vector2(a.x - b.x, a.z - b.z).length() <= interact_radius
