extends StaticBody3D

## A lootable crate (generated by raid_map_blockout).
##
## Walk up to it and press `interact_action` (E by default) to search it.
## After `search_time` seconds it opens and emits `opened`; a LootDropper
## child (loot_table_edit, trigger_signal "opened") turns that into pickups
## on the floor. Walking away cancels the search.
##
## Free to edit: this file was copied into your project and is yours now.

signal search_started(by: Node)
signal search_cancelled(by: Node)
signal opened(by: Node)

@export var crate_name := "상자"
@export var interact_action: StringName = &"interact"
## Meters (on the ground plane) a player must be within to search.
@export var interact_radius := 1.8
## Seconds of searching before it opens; 0 opens at once.
@export var search_time := 1.0
@export var player_group: StringName = &"player"
@export var opened_color := Color(0.3, 0.27, 0.22)

var is_open := false
var _searcher: Node3D
var _progress := 0.0
var _label: Label3D


func _ready() -> void:
	add_to_group(&"loot_crate")
	_label = get_node_or_null(^"Label") as Label3D
	if _label != null:
		_label.visible = false


func _process(delta: float) -> void:
	if Engine.is_editor_hint() or is_open:
		return
	var near := nearest_player()
	if _searcher != null:
		if near != _searcher:
			var who := _searcher
			_searcher = null
			search_cancelled.emit(who)
		else:
			_progress += delta
			if _progress >= search_time:
				open(_searcher)
				return
	_update_label(near)


func _unhandled_input(event: InputEvent) -> void:
	if is_open or _searcher != null or not InputMap.has_action(interact_action):
		return
	if event.is_action_pressed(interact_action):
		var player := nearest_player()
		if player == null:
			return
		get_viewport().set_input_as_handled()
		start_search(player)


## Starts searching for `by` (a player). Opens at once when search_time is 0.
func start_search(by: Node3D) -> void:
	if is_open:
		return
	_searcher = by
	_progress = 0.0
	search_started.emit(by)
	if search_time <= 0.0:
		open(by)


## Opens the crate (once) and emits `opened`.
func open(by: Node = null) -> void:
	if is_open:
		return
	is_open = true
	_searcher = null
	var body := get_node_or_null(^"Body") as MeshInstance3D
	if body != null:
		var mat := StandardMaterial3D.new()
		mat.albedo_color = opened_color
		body.material_override = mat
	if _label != null:
		_label.visible = false
	opened.emit(by)


## The closest node of `player_group` within interact_radius, or null.
func nearest_player() -> Node3D:
	if not is_inside_tree():
		return null
	var best: Node3D = null
	var best_d := interact_radius
	for node in get_tree().get_nodes_in_group(player_group):
		var n := node as Node3D
		if n == null:
			continue
		var d := Vector2(n.global_position.x - global_position.x, n.global_position.z - global_position.z).length()
		if d <= best_d:
			best = n
			best_d = d
	return best


func _update_label(near: Node3D) -> void:
	if _label == null:
		return
	if near == null:
		_label.visible = false
		return
	_label.visible = true
	if _searcher != null and search_time > 0.0:
		_label.text = "수색 중... %d%%" % int(clampf(_progress / search_time, 0.0, 1.0) * 100.0)
	else:
		_label.text = "[%s] %s 열기" % [_key_name(), crate_name]


func _key_name() -> String:
	if InputMap.has_action(interact_action):
		for ev in InputMap.action_get_events(interact_action):
			var key := ev as InputEventKey
			if key != null:
				var code := key.physical_keycode if key.physical_keycode != KEY_NONE else key.keycode
				return OS.get_keycode_string(code)
	return String(interact_action)
