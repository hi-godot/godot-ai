extends CharacterBody3D

## Enemy AI (generated by enemy_ai_scaffold).
##
## A small state machine: PATROL (walk patrol_points, or wander around the
## spawn point) -> CHASE (a target was seen, heard through damage, or
## reported by an ally) -> ATTACK (in range) -> SEARCH (lost sight: go to
## the last known position and look around) -> back to PATROL. DEAD ends it.
##
## Targets are nodes in `target_group` (the player scaffold joins "player").
## They are seen inside a vision cone (sight_range, sight_angle_degrees) or
## anywhere within proximity_radius, and only with a clear line of sight.
## Movement uses the NavigationAgent3D child when the world has a baked
## navigation mesh, and steers straight at the goal otherwise.
##
## Damage in and out follows the shared convention: take_damage(amount,
## info). A ranged enemy with a weapon (anything with try_fire(aim_point))
## under WeaponMount shoots with it; without one it fires its own ray.
##
## Free to edit: this file was copied into your project and is yours now.

enum State { PATROL, CHASE, ATTACK, SEARCH, DEAD }

signal state_changed(previous: State, current: State)
signal target_spotted(target: Node3D)
signal target_lost
signal attack_started(target: Node3D)
signal attacked(target: Node, damage: float)
signal health_changed(current: float, maximum: float)
signal died

@export_group("Movement")
@export var patrol_speed := 2.5
@export var chase_speed := 4.5
@export var acceleration := 20.0
## How fast the body turns toward where it moves or aims. 0 turns instantly.
@export var turn_speed := 8.0
@export var arrive_distance := 0.6

@export_group("Patrol")
## World positions visited in order, looping. Empty: wander around the
## spawn point within wander_radius.
@export var patrol_points := PackedVector3Array()
@export var patrol_wait_time := 1.5
@export var wander_radius := 6.0

@export_group("Perception")
@export var target_group: StringName = &"player"
@export var sight_range := 15.0
## Full width of the vision cone in degrees (360 sees all around).
@export_range(1.0, 360.0) var sight_angle_degrees := 110.0
## Targets this close are noticed in any direction (still needs a clear line).
@export var proximity_radius := 2.5
## Height of the eyes and of the point aimed at on a target.
@export var eye_height := 1.4
## Physics layers that block sight and that the enemy's own ray hits.
@export_flags_3d_physics var sight_mask := 1
## Seconds the enemy keeps chasing the last seen position before searching.
@export var lose_sight_time := 3.0
## Seconds spent looking around the last known position before patrolling.
@export var search_time := 4.0
## Allies (group "enemy") within this radius join the chase. 0 disables.
@export var alert_radius := 8.0
## Chase whoever damaged this enemy, even unseen.
@export var aggro_on_damage := true
@export var perception_interval := 0.1

@export_group("Attack")
@export_enum("melee", "ranged") var attack_mode: String = "melee"
@export var attack_range := 1.8
@export var attack_damage := 10.0
@export var attack_cooldown := 1.0
## Telegraph before each attack (melee and weapon-less ranged); for a ranged
## enemy with a weapon it is the reaction time before it opens fire.
@export var attack_windup := 0.35
## Random spread of the weapon-less ranged ray, total cone in degrees.
@export var aim_error_degrees := 4.0
@export var weapon_mount_path: NodePath = ^"WeaponMount"

@export_group("Health")
@export var max_health := 60.0
@export var free_on_death := true
@export var death_free_delay := 2.0

@export_group("Navigation")
@export var navigation_agent_path: NodePath = ^"NavigationAgent3D"

var state: State = State.PATROL
var health := 0.0
var is_dead := false
## Current target (a node in target_group), or null.
var target: Node3D = null
## Where the target was last seen or heard.
var last_known_position := Vector3.ZERO

var _home := Vector3.ZERO
var _patrol_index := 0
var _wait_left := 0.0
var _wander_goal: Variant = null
var _leg_time := 0.0
var _sees_target := false
var _since_seen := INF
var _search_left := 0.0
var _looking_around := false
var _cooldown_left := 0.0
var _windup_left := -1.0
var _weapon_ready := false
var _perceive_left := 0.0
## Where to walk this frame (Vector3) or null to stand still.
var _goal: Variant = null
var _speed := 0.0
## Where to look this frame (Vector3) or null to look where we walk.
var _look_at: Variant = null

@onready var _agent: NavigationAgent3D = get_node_or_null(navigation_agent_path) as NavigationAgent3D
@onready var _gravity: float = ProjectSettings.get_setting("physics/3d/default_gravity", 9.8)


func _ready() -> void:
	add_to_group("enemy")
	health = max_health
	_home = global_position


func _physics_process(delta: float) -> void:
	if is_dead:
		return
	think(delta)
	_move(delta)


## One AI step without moving the body: perception, then the state machine.
## Sets the walk goal, speed and look direction that _move() applies.
func think(delta: float) -> void:
	if is_dead:
		return
	_cooldown_left = maxf(_cooldown_left - delta, 0.0)
	if target != null and not _is_valid_target(target):
		target = null
		_sees_target = false
	_perceive_left -= delta
	if _perceive_left <= 0.0:
		_perceive_left = perception_interval
		_update_perception()
	if _sees_target:
		_since_seen = 0.0
		last_known_position = target.global_position
	else:
		_since_seen += delta

	_goal = null
	_look_at = null
	match state:
		State.PATROL:
			_patrol(delta)
		State.CHASE:
			_chase(delta)
		State.ATTACK:
			_attack(delta)
		State.SEARCH:
			_search(delta)


func get_state_name() -> String:
	return State.keys()[state]


## True when `node` is inside the vision cone (or proximity radius) and in
## sight range, with nothing on sight_mask between the eyes and it.
func can_see(node: Node3D) -> bool:
	if not _is_valid_target(node):
		return false
	var to := node.global_position - global_position
	to.y = 0.0
	var distance := to.length()
	if distance > sight_range:
		return false
	if distance > proximity_radius and sight_angle_degrees < 360.0:
		var facing := _facing()
		if to.length_squared() > 0.0001 and rad_to_deg(facing.angle_to(to.normalized())) > sight_angle_degrees * 0.5:
			return false
	return _line_clear(node)


## Applies damage. `info.source` (who hit us) becomes the target when it is
## in target_group and aggro_on_damage is on.
func take_damage(amount: float, info: Dictionary = {}) -> void:
	if is_dead:
		return
	health = maxf(health - amount, 0.0)
	health_changed.emit(health, max_health)
	if health <= 0.0:
		_die()
		return
	if not aggro_on_damage:
		return
	var source: Variant = info.get("source")
	if source is Node3D and _is_valid_target(source):
		alert(source, source.global_position)
		_alert_allies()


func heal(amount: float) -> void:
	if is_dead:
		return
	health = minf(health + amount, max_health)
	health_changed.emit(health, max_health)


## Makes this enemy hunt `new_target` from `position` (allies call this).
func alert(new_target: Node3D, position: Vector3) -> void:
	if is_dead or not _is_valid_target(new_target):
		return
	target = new_target
	last_known_position = position
	_since_seen = 0.0
	if state == State.PATROL or state == State.SEARCH:
		_set_state(State.CHASE)


## First node under the weapon mount that can fire, or null.
func get_weapon() -> Node:
	var mount := get_node_or_null(weapon_mount_path)
	if mount == null:
		return null
	for child in mount.get_children():
		if child.has_method("try_fire"):
			return child
	return null


# --- states -------------------------------------------------------------------

func _patrol(delta: float) -> void:
	_speed = patrol_speed
	if _wait_left > 0.0:
		_wait_left -= delta
		return
	var goal := _patrol_goal()
	_leg_time += delta
	## A goal that cannot be reached (wall, off the navmesh) is skipped.
	if _flat_distance(goal) <= arrive_distance or _leg_time > 12.0:
		_leg_time = 0.0
		_wait_left = patrol_wait_time
		if patrol_points.is_empty():
			_wander_goal = null
		else:
			_patrol_index = (_patrol_index + 1) % patrol_points.size()
		return
	_goal = goal


func _chase(_delta: float) -> void:
	_speed = chase_speed
	if target == null:
		_set_state(State.SEARCH)
		return
	if _sees_target:
		_look_at = target.global_position
		if _flat_distance(target.global_position) <= attack_range:
			_set_state(State.ATTACK)
			return
	elif _since_seen > lose_sight_time or _flat_distance(last_known_position) <= arrive_distance:
		_set_state(State.SEARCH)
		return
	_goal = last_known_position


func _attack(delta: float) -> void:
	if target == null:
		_set_state(State.SEARCH)
		return
	_look_at = target.global_position
	var too_far := _flat_distance(target.global_position) > attack_range * 1.15
	if too_far or (attack_mode == "ranged" and not _sees_target):
		_set_state(State.CHASE)
		return
	var weapon := get_weapon() if attack_mode == "ranged" else null
	if weapon != null and _weapon_ready:
		if _facing_toward(target.global_position, 20.0):
			weapon.try_fire(_aim_point_of(target))
		return
	if _windup_left < 0.0:
		if _cooldown_left > 0.0:
			return
		_windup_left = attack_windup
		attack_started.emit(target)
	_windup_left -= delta
	if _windup_left > 0.0:
		return
	_windup_left = -1.0
	if weapon != null:
		_weapon_ready = true
		weapon.try_fire(_aim_point_of(target))
		return
	_cooldown_left = attack_cooldown
	if attack_mode == "melee":
		_melee_hit()
	else:
		_ranged_hit()


func _search(delta: float) -> void:
	_speed = patrol_speed
	if not _looking_around:
		_leg_time += delta
		if _flat_distance(last_known_position) > arrive_distance and _leg_time < 10.0:
			_goal = last_known_position
			return
		_looking_around = true
	## Look around the spot, then give up.
	_search_left -= delta
	var sweep := global_position + Vector3(sin(_search_left * 2.0), 0.0, cos(_search_left * 2.0))
	_look_at = sweep
	if _search_left <= 0.0:
		target = null
		target_lost.emit()
		_set_state(State.PATROL)


func _set_state(next: State) -> void:
	if next == state:
		return
	var previous := state
	state = next
	_windup_left = -1.0
	_leg_time = 0.0
	if next == State.SEARCH:
		_search_left = search_time
		_looking_around = false
	if next != State.ATTACK:
		_weapon_ready = false
	if next == State.PATROL:
		_wander_goal = null
		_wait_left = 0.0
	state_changed.emit(previous, next)


# --- perception -----------------------------------------------------------------

func _update_perception() -> void:
	if target != null:
		_sees_target = can_see(target)
		if _sees_target:
			return
	## Look for the nearest visible candidate (or a new one while chasing).
	var best: Node3D = null
	var best_distance := INF
	for node in get_tree().get_nodes_in_group(target_group):
		var candidate := node as Node3D
		if candidate == null or candidate == target or not can_see(candidate):
			continue
		var d := global_position.distance_squared_to(candidate.global_position)
		if d < best_distance:
			best_distance = d
			best = candidate
	if best == null:
		_sees_target = false
		return
	var was_hunting := state == State.CHASE or state == State.ATTACK
	target = best
	_sees_target = true
	last_known_position = best.global_position
	if not was_hunting:
		target_spotted.emit(best)
		_alert_allies()
		_set_state(State.CHASE)


func _line_clear(node: Node3D) -> bool:
	if not is_inside_tree():
		return false
	var from := global_position + Vector3.UP * eye_height
	var to := _aim_point_of(node)
	var query := PhysicsRayQueryParameters3D.create(from, to, sight_mask, [get_rid()])
	var result := get_world_3d().direct_space_state.intersect_ray(query)
	if result.is_empty():
		return true
	var collider := result.collider as Node
	return collider != null and (collider == node or node.is_ancestor_of(collider))


func _alert_allies() -> void:
	if alert_radius <= 0.0 or target == null:
		return
	for ally in get_tree().get_nodes_in_group("enemy"):
		if ally == self or not ally is Node3D or not ally.has_method("alert"):
			continue
		if global_position.distance_to(ally.global_position) <= alert_radius:
			ally.alert(target, last_known_position)


func _is_valid_target(node: Variant) -> bool:
	if not is_instance_valid(node) or not node is Node3D or not node.is_inside_tree():
		return false
	if not node.is_in_group(target_group):
		return false
	return node.get("is_dead") != true


# --- attacks ---------------------------------------------------------------------

func _melee_hit() -> void:
	if _flat_distance(target.global_position) > attack_range * 1.25:
		return
	var dir := target.global_position - global_position
	dir.y = 0.0
	_deal_damage(target, target.global_position, dir.normalized())


func _ranged_hit() -> void:
	var from := global_position + Vector3.UP * eye_height
	var dir := (_aim_point_of(target) - from).normalized()
	var half_error := deg_to_rad(aim_error_degrees) * 0.5
	dir = dir.rotated(Vector3.UP, randf_range(-half_error, half_error))
	var reach := maxf(attack_range * 1.5, sight_range)
	var query := PhysicsRayQueryParameters3D.create(from, from + dir * reach, sight_mask, [get_rid()])
	var result := get_world_3d().direct_space_state.intersect_ray(query)
	if result.is_empty():
		return
	var receiver := result.collider as Node
	while receiver != null and not receiver.has_method("take_damage"):
		receiver = receiver.get_parent()
	if receiver != null:
		_deal_damage(receiver, result.position, dir)


func _deal_damage(receiver: Node, at: Vector3, dir: Vector3) -> void:
	receiver.take_damage(attack_damage, {
		"source": self,
		"weapon": "enemy_" + attack_mode,
		"position": at,
		"direction": dir,
	})
	attacked.emit(receiver, attack_damage)


func _die() -> void:
	is_dead = true
	var previous := state
	state = State.DEAD
	state_changed.emit(previous, state)
	velocity = Vector3.ZERO
	target = null
	## Bullets and bodies pass through the corpse.
	collision_layer = 0
	died.emit()
	if free_on_death and is_inside_tree():
		get_tree().create_timer(death_free_delay).timeout.connect(queue_free)


# --- movement ---------------------------------------------------------------------

func _move(delta: float) -> void:
	var desired := Vector3.ZERO
	if _goal != null:
		var next := _next_path_point(_goal)
		var dir := next - global_position
		dir.y = 0.0
		if dir.length_squared() > 0.0001:
			desired = dir.normalized() * _speed
	var horizontal := Vector3(velocity.x, 0.0, velocity.z).move_toward(desired, acceleration * delta)
	velocity.x = horizontal.x
	velocity.z = horizontal.z
	if is_on_floor():
		velocity.y = 0.0
	else:
		velocity.y -= _gravity * delta
	move_and_slide()

	var look: Variant = _look_at
	if look == null and horizontal.length_squared() > 0.01:
		look = global_position + horizontal
	if look != null:
		_turn_toward(look, delta)


func _next_path_point(goal: Vector3) -> Vector3:
	if not _navigation_ready():
		return goal
	if _agent.target_position.distance_squared_to(goal) > 0.04:
		_agent.target_position = goal
	if _agent.is_navigation_finished():
		return goal
	var next := _agent.get_next_path_position()
	## No path (goal off the navigation mesh, or the mesh is empty): steer
	## straight instead of standing still.
	if Vector2(next.x - global_position.x, next.z - global_position.z).length_squared() < 0.0025:
		return goal
	return next


func _navigation_ready() -> bool:
	if _agent == null or not _agent.is_inside_tree():
		return false
	var map := _agent.get_navigation_map()
	return NavigationServer3D.map_get_iteration_id(map) > 0 and not NavigationServer3D.map_get_regions(map).is_empty()


func _patrol_goal() -> Vector3:
	if not patrol_points.is_empty():
		return patrol_points[_patrol_index % patrol_points.size()]
	if _wander_goal == null:
		var angle := randf() * TAU
		var radius := sqrt(randf()) * wander_radius
		_wander_goal = _home + Vector3(cos(angle) * radius, 0.0, sin(angle) * radius)
	return _wander_goal


func _turn_toward(point: Vector3, delta: float) -> void:
	var look := point - global_position
	look.y = 0.0
	if look.length_squared() < 0.0001:
		return
	var target_yaw := atan2(-look.x, -look.z)
	if turn_speed <= 0.0:
		rotation.y = target_yaw
	else:
		rotation.y = lerp_angle(rotation.y, target_yaw, 1.0 - exp(-turn_speed * delta))


func _facing() -> Vector3:
	var forward := -global_basis.z
	forward.y = 0.0
	return forward.normalized() if forward.length_squared() > 0.0001 else Vector3.FORWARD


func _facing_toward(point: Vector3, tolerance_degrees: float) -> bool:
	var to := point - global_position
	to.y = 0.0
	if to.length_squared() < 0.0001:
		return true
	return rad_to_deg(_facing().angle_to(to.normalized())) <= tolerance_degrees


func _aim_point_of(node: Node3D) -> Vector3:
	return node.global_position + Vector3.UP * eye_height


func _flat_distance(point: Vector3) -> float:
	return Vector2(point.x - global_position.x, point.z - global_position.z).length()
