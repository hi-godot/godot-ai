extends Resource

## Weapon stats (generated by weapon_create). One .tres per weapon uses
## this script; the weapon scene reads it at runtime.
##
## Free to edit: this file was copied into your project and is yours now.

@export var weapon_id := ""
@export var display_name := ""
@export_enum("hitscan", "projectile") var fire_mode := "hitscan"
@export var damage := 20.0
## Shots per second.
@export var fire_rate := 5.0
## Hold the fire button to keep shooting.
@export var automatic := false
@export var magazine_size := 12
## Seconds.
@export var reload_time := 1.5
## Reload automatically when trying to fire an empty magazine.
@export var auto_reload := true
## Total cone angle, in degrees, each pellet is randomly rotated within.
@export var spread_degrees := 3.0
## Rays or projectiles per shot (shotguns use more than 1).
@export var pellets := 1
## Hitscan ray length, or projectile travel distance, in meters.
@export var max_range := 50.0
## Meters per second (projectile mode only).
@export var projectile_speed := 40.0
## Scene spawned per pellet in projectile mode; needs setup(...).
@export var projectile_scene: PackedScene
## Physics layers bullets collide with.
@export_flags_3d_physics var collision_mask := 1
