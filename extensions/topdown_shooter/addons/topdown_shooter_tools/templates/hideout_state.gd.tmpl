extends Node

## Raid profile: stash, raid bag, stats and the save file (generated by
## hideout_scaffold; registered as the HideoutState autoload).
##
## The game loop it runs:
##
##   hideout  --deploy()-->  raid scene  --extracted-->  hideout (bag -> stash)
##                                       --died------->  hideout (bag lost)
##
## In the hideout, the stash and the raid bag are two inventory.gd grids
## (see hideout.gd). deploy() saves, marks the raid as running and loads
## the raid scene; when it is up, the player's Inventory is replaced by the
## bag. Extracting keeps the whole bag (kit plus loot) and moves it into the
## stash back in the hideout; dying loses it. Quitting the game during a
## raid counts as dying when quit_counts_as_death is on.
##
## A raid scene started on its own (F6, or a playtest) is tracked too when
## track_direct_raids is on: the player keeps the scene's starting items and
## extracting still brings everything home.
##
## Settings live in Project Settings under game/hideout/ (written by the
## tool). The save is JSON at save_path (user://, so per user and machine).
##
## Free to edit: this file was copied into your project and is yours now.

signal raid_started(from_hideout: bool)
signal raid_ended(result: String, summary: Dictionary)
signal hideout_ready(hideout: Node, summary: Dictionary)
signal saved(path: String)

const SETTINGS_PREFIX := "game/hideout/"
const SAVE_VERSION := 1
## Where an automatic playtest (raid_playtest) saves, so it never touches
## the player's real save.
const SANDBOX_SAVE := "user://hideout/playtest_save.json"

var save_path := "user://hideout/save.json"
var hideout_scene := ""
var raid_scene := ""
var item_database_path := "res://data/items/item_database.tres"
## Seconds the result stays on screen before going back to the hideout.
var return_delay := 3.0
var quit_counts_as_death := true
var track_direct_raids := true
## Items in the stash of a new game: [{"item_id", "count"}].
var starting_stash: Array = []

# --- saved state ---------------------------------------------------------------
## inventory.gd to_data() of the stash.
var stash: Array = []
## inventory.gd to_data() of the raid bag (the kit for the next raid, or
## what came home from the last one).
var loadout: Array = []
## Items waiting for stash room: [{"item_id", "count"}].
var overflow: Array = []
var stats := _empty_stats()
var last_raid := {}
## True from deploy() until the raid ends; still true on the next start
## means the game was closed during a raid.
var in_raid := false
## The bag came home and still has to move into the stash.
var pending_return := false

var is_loaded := false
var sandbox := false
## A raid scene is running and its end is handled here.
var raid_active := false

var _scene: Node
var _deploy_pending := false
var _raid_from_hideout := false
var _ending := false
var _raid_started_msec := 0
var _kit_value := 0
var _player: Node
var _overlay: CanvasLayer
var _db: Resource


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	read_settings()
	load_game()


func read_settings() -> void:
	save_path = str(_setting("save_path", save_path))
	hideout_scene = str(_setting("hideout_scene", hideout_scene))
	raid_scene = str(_setting("raid_scene", raid_scene))
	item_database_path = str(_setting("item_database", item_database_path))
	return_delay = float(_setting("return_delay", return_delay))
	quit_counts_as_death = bool(_setting("quit_counts_as_death", quit_counts_as_death))
	track_direct_raids = bool(_setting("track_direct_raids", track_direct_raids))
	var start: Variant = _setting("starting_stash", starting_stash)
	starting_stash = start if start is Array else []


func _setting(key: String, fallback: Variant) -> Variant:
	return ProjectSettings.get_setting(SETTINGS_PREFIX + key, fallback)


func _process(_delta: float) -> void:
	var scene := get_tree().current_scene
	if scene != _scene:
		_scene = scene
		if scene != null:
			_on_scene_changed.call_deferred(scene)


# =============================================================================
# save file
# =============================================================================

func load_game() -> void:
	is_loaded = true
	if not FileAccess.file_exists(save_path):
		new_game(false)
		return
	var json := JSON.new()
	var data: Variant = json.data if json.parse(FileAccess.get_file_as_string(save_path)) == OK else null
	if not data is Dictionary or int(data.get("version", 0)) < 1:
		push_warning("HideoutState: %s is not a save file; starting a new game (the old file is kept as .bad)" % save_path)
		DirAccess.rename_absolute(ProjectSettings.globalize_path(save_path), ProjectSettings.globalize_path(save_path + ".bad"))
		new_game()
		return
	apply_save_data(data)
	if in_raid:
		## Closed during a raid.
		if quit_counts_as_death:
			_record_loss("mia", loadout)
			loadout = []
		in_raid = false
		save_game()


func apply_save_data(data: Dictionary) -> void:
	stash = _array(data.get("stash"))
	loadout = _array(data.get("loadout"))
	overflow = _array(data.get("overflow"))
	stats = _empty_stats()
	var saved_stats: Variant = data.get("stats")
	if saved_stats is Dictionary:
		for k in stats:
			if saved_stats.has(k):
				stats[k] = int(saved_stats[k])
	last_raid = data.get("last_raid") if data.get("last_raid") is Dictionary else {}
	in_raid = bool(data.get("in_raid", false))
	pending_return = bool(data.get("pending_return", false))


func to_save_data() -> Dictionary:
	return {
		"version": SAVE_VERSION,
		"saved_unix": int(Time.get_unix_time_from_system()),
		"stash": stash,
		"loadout": loadout,
		"overflow": overflow,
		"stats": stats,
		"last_raid": last_raid,
		"in_raid": in_raid,
		"pending_return": pending_return,
	}


## Writes the save atomically (temp file + rename). Returns OK or an error.
func save_game() -> Error:
	var dir := save_path.get_base_dir()
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(dir))
	var tmp := save_path + ".tmp"
	var file := FileAccess.open(tmp, FileAccess.WRITE)
	if file == null:
		var err := FileAccess.get_open_error()
		push_warning("HideoutState: cannot write %s: %s" % [tmp, error_string(err)])
		return err
	file.store_string(JSON.stringify(to_save_data(), "\t"))
	file.close()
	var err := DirAccess.rename_absolute(ProjectSettings.globalize_path(tmp), ProjectSettings.globalize_path(save_path))
	if err != OK:
		push_warning("HideoutState: cannot replace %s: %s" % [save_path, error_string(err)])
		return err
	saved.emit(save_path)
	return OK


## Starts over: empty bag, starting_stash waiting for the stash, stats reset.
func new_game(write := true) -> void:
	stash = []
	loadout = []
	overflow = []
	for s in starting_stash:
		if s is Dictionary and str(s.get("item_id", "")) != "":
			overflow.append({"item_id": str(s.item_id), "count": int(s.get("count", 1))})
	stats = _empty_stats()
	last_raid = {}
	in_raid = false
	pending_return = false
	if write:
		save_game()


## Keeps the save away from the real one (used by raid_playtest).
func use_sandbox(path := SANDBOX_SAVE) -> void:
	if sandbox:
		return
	sandbox = true
	save_path = path
	save_game()


static func _empty_stats() -> Dictionary:
	return {
		"raids": 0, "extracted": 0, "died": 0, "mia": 0,
		"value_extracted": 0, "value_lost": 0, "items_extracted": 0,
	}


static func _array(v: Variant) -> Array:
	return (v as Array).duplicate(true) if v is Array else []


# =============================================================================
# hideout
# =============================================================================

## Called by the hideout scene when it is ready. Fills its stash and bag
## grids from the save, moves a bag that came home into the stash, places
## items waiting for room, saves, and returns a summary for the screen.
func enter_hideout(hideout: Node, stash_inv: Node, bag_inv: Node) -> Dictionary:
	_clear_overlay()
	raid_active = false
	_ending = false
	if not is_loaded:
		load_game()
	var summary := {"returned": pending_return, "moved": {}, "left_in_bag": {}, "placed_waiting": {}, "dropped_unknown": []}
	var left := fill_inventory(stash_inv, stash)
	left.append_array(fill_inventory(bag_inv, loadout))
	for d in left:
		if d.has("unknown"):
			summary.dropped_unknown.append(d.item_id)
		else:
			overflow.append({"item_id": d.item_id, "count": d.count})
	if pending_return:
		var moved := move_all(bag_inv, stash_inv)
		summary.moved = moved
		summary.left_in_bag = count_items(bag_inv.to_data())
		pending_return = false
	if not overflow.is_empty():
		var waiting := overflow
		overflow = []
		for d in waiting:
			var item: Resource = stash_inv.resolve_item(d.item_id)
			if item == null:
				summary.dropped_unknown.append(d.item_id)
				continue
			var placed := add_partial(stash_inv, item, int(d.count))
			if placed > 0:
				summary.placed_waiting[d.item_id] = int(summary.placed_waiting.get(d.item_id, 0)) + placed
			if placed < int(d.count):
				overflow.append({"item_id": d.item_id, "count": int(d.count) - placed})
	summary["waiting"] = overflow.duplicate(true)
	summary["last_raid"] = last_raid.duplicate(true)
	store(stash_inv, bag_inv)
	hideout_ready.emit(hideout, summary)
	return summary


## Saves the hideout grids.
func store(stash_inv: Node, bag_inv: Node) -> void:
	stash = stash_inv.to_data()
	loadout = bag_inv.to_data()
	save_game()


## Saves, then loads `scene` (default raid_scene) with the bag as the
## player's inventory. Returns OK or an error.
func deploy(stash_inv: Node, bag_inv: Node, scene := "") -> Error:
	var target := scene if not scene.is_empty() else raid_scene
	if target.is_empty() or not ResourceLoader.exists(target):
		push_warning("HideoutState: raid scene '%s' does not exist" % target)
		return ERR_FILE_NOT_FOUND
	stash = stash_inv.to_data()
	loadout = bag_inv.to_data()
	in_raid = true
	pending_return = false
	save_game()
	_deploy_pending = true
	return get_tree().change_scene_to_file(target)


func go_to_hideout() -> Error:
	if hideout_scene.is_empty() or not ResourceLoader.exists(hideout_scene):
		push_warning("HideoutState: hideout scene '%s' does not exist" % hideout_scene)
		return ERR_FILE_NOT_FOUND
	return get_tree().change_scene_to_file(hideout_scene)


# =============================================================================
# raid
# =============================================================================

func _on_scene_changed(scene: Node) -> void:
	if not is_instance_valid(scene) or scene != get_tree().current_scene:
		return
	_clear_overlay()
	if scene.is_in_group(&"hideout") or scene.has_method(&"is_hideout"):
		return
	var is_raid := not get_tree().get_nodes_in_group(&"extraction").is_empty() \
		or (not raid_scene.is_empty() and scene.scene_file_path == raid_scene)
	if not is_raid:
		_deploy_pending = false
		return
	begin_raid(scene)


## Hooks the running raid: gives the player the bag (after deploy()), and
## handles extraction and death.
func begin_raid(_scene_root: Node = null) -> void:
	var from_hideout := _deploy_pending
	_deploy_pending = false
	if not from_hideout and not track_direct_raids:
		return
	raid_active = true
	_ending = false
	_raid_from_hideout = from_hideout
	_raid_started_msec = Time.get_ticks_msec()
	_player = get_tree().get_first_node_in_group(&"player")
	var bag := _bag()
	if from_hideout and bag != null:
		var left := fill_inventory(bag, loadout)
		for d in left:
			if not d.has("unknown"):
				overflow.append({"item_id": d.item_id, "count": d.count})
		if not left.is_empty():
			push_warning("HideoutState: %d stacks did not fit the raid bag and stay in the stash" % left.size())
			loadout = bag.to_data()
			save_game()
	_kit_value = value_of_data(bag.to_data()) if bag != null else 0
	if _player != null and _player.has_signal(&"died") and not _player.is_connected(&"died", _on_player_died):
		_player.connect(&"died", _on_player_died)
	for zone in get_tree().get_nodes_in_group(&"extraction"):
		if zone.has_signal(&"extracted") and not zone.is_connected(&"extracted", _on_extracted):
			zone.connect(&"extracted", _on_extracted)
		## The zone would reload the raid; this node returns to the hideout.
		if "restart_delay" in zone and not hideout_scene.is_empty():
			zone.set("restart_delay", 0.0)
	raid_started.emit(from_hideout)


func _bag() -> Node:
	if _player == null or not is_instance_valid(_player):
		return null
	var bag := _player.get_node_or_null(^"Inventory")
	if bag == null:
		for child in _player.get_children():
			if child.is_in_group(&"inventory"):
				return child
	return bag


func _on_extracted(_body: Node = null) -> void:
	if _ending or not raid_active:
		return
	_ending = true
	var bag := _bag()
	var data: Array = bag.to_data() if bag != null else []
	var value := value_of_data(data)
	var items := count_items(data)
	var count := 0
	for id in items:
		count += int(items[id])
	stats.raids = int(stats.raids) + 1
	stats.extracted = int(stats.extracted) + 1
	stats.value_extracted = int(stats.value_extracted) + value
	stats.items_extracted = int(stats.items_extracted) + count
	last_raid = {
		"result": "extracted",
		"value": value,
		"kit_value": _kit_value,
		"profit": value - _kit_value,
		"items": items,
		"seconds": snappedf(float(Time.get_ticks_msec() - _raid_started_msec) / 1000.0, 0.1),
		"from_hideout": _raid_from_hideout,
		"unix": int(Time.get_unix_time_from_system()),
	}
	loadout = data
	pending_return = true
	in_raid = false
	save_game()
	raid_ended.emit("extracted", last_raid)
	_show_overlay("탈출 성공!\n가져온 물건 ₩%s · %d개\n은신처로 돌아갑니다" % [_thousands(value), count], Color(0.5, 1.0, 0.6))
	_return_later()


func _on_player_died() -> void:
	if _ending or not raid_active:
		return
	_ending = true
	var bag := _bag()
	var data: Array = bag.to_data() if bag != null else []
	_record_loss("died", data)
	loadout = []
	pending_return = false
	in_raid = false
	save_game()
	raid_ended.emit("died", last_raid)
	_show_overlay("사망\n가지고 간 물건 ₩%s를 잃었습니다\n은신처로 돌아갑니다" % _thousands(int(last_raid.get("value_lost", 0))), Color(1.0, 0.45, 0.4))
	_return_later()


func _record_loss(result: String, data: Array) -> void:
	var value := value_of_data(data)
	stats.raids = int(stats.raids) + 1
	stats[result] = int(stats.get(result, 0)) + 1
	stats.value_lost = int(stats.value_lost) + value
	last_raid = {
		"result": result,
		"value_lost": value,
		"items_lost": count_items(data),
		"seconds": snappedf(float(Time.get_ticks_msec() - _raid_started_msec) / 1000.0, 0.1) if raid_active else 0.0,
		"from_hideout": _raid_from_hideout,
		"unix": int(Time.get_unix_time_from_system()),
	}


func _return_later() -> void:
	if hideout_scene.is_empty():
		raid_active = false
		return
	await get_tree().create_timer(maxf(return_delay, 0.0), true, false, true).timeout
	raid_active = false
	go_to_hideout()


# =============================================================================
# inventory helpers (work on any inventory.gd node)
# =============================================================================

## Replaces the inventory's contents with `data` (to_data() format). Stacks
## go back to their saved cell when it is free, else anywhere they fit.
## Returns what did not fit: [{"item_id", "count"}] (plus "unknown": true
## for ids the item database no longer has).
static func fill_inventory(inv: Node, data: Array) -> Array:
	var left: Array = []
	inv.entries.clear()
	var later: Array = []
	for d in data:
		if not d is Dictionary:
			continue
		var id := str(d.get("item_id", ""))
		var count := int(d.get("count", 1))
		if id.is_empty() or count <= 0:
			continue
		var item: Resource = inv.resolve_item(id)
		if item == null:
			left.append({"item_id": id, "count": count, "unknown": true})
			continue
		var rotated := bool(d.get("rotated", false)) and bool(inv.allow_rotation)
		var cell := Vector2i(int(d.get("x", 0)), int(d.get("y", 0)))
		if count <= inv.max_stack_of(item) and inv.is_area_free(cell, inv.item_size(item, rotated)):
			inv.entries.append({"item": item, "count": count, "x": cell.x, "y": cell.y, "rotated": rotated})
		else:
			later.append([item, count])
	for pair in later:
		var placed := add_partial(inv, pair[0], pair[1], false)
		if placed < pair[1]:
			left.append({"item_id": str(pair[0].get("item_id")), "count": pair[1] - placed})
	_changed(inv)
	return left


## Adds as many of `count` as fit (by space and, with check_weight, by
## weight). Returns how many went in.
static func add_partial(inv: Node, item: Resource, count: int, check_weight := true) -> int:
	if count <= 0:
		return 0
	var n := count
	if check_weight:
		n = mini(n, weight_room(inv, item))
	var limit: float = inv.max_weight
	if not check_weight:
		inv.max_weight = 0.0
	var placed := 0
	## add_item is all-or-nothing: try everything, then halve.
	while n > 0:
		if inv.add_item(item, n):
			placed += n
			n = mini(count - placed, n)
			if check_weight:
				n = mini(n, weight_room(inv, item))
		else:
			n /= 2
	inv.max_weight = limit
	return placed


## How many more of `item` the inventory's weight limit allows.
static func weight_room(inv: Node, item: Resource) -> int:
	var limit := float(inv.max_weight)
	var w: float = inv.weight_of(item)
	if limit <= 0.0 or w <= 0.0:
		return 1 << 30
	return maxi(floori((limit - float(inv.get_total_weight())) / w + 0.0001), 0)


## Moves every stack of `src` into `dst` (wherever it fits). Returns
## {item_id: count moved}; what does not fit stays in src.
static func move_all(src: Node, dst: Node) -> Dictionary:
	var moved := {}
	var i := 0
	while i < src.entries.size():
		var e: Dictionary = src.entries[i]
		var placed := add_partial(dst, e.item, int(e.count))
		if placed > 0:
			var id: String = src.item_id_of(e.item)
			moved[id] = int(moved.get(id, 0)) + placed
			var whole := placed >= int(e.count)
			src.take_from(i, placed)
			if whole:
				continue
		i += 1
	return moved


## Moves stack `index` of `src` into `dst`. With a cell, it goes there
## (merging onto the same item, partly if the stack is full); without one
## (Vector2i(-1, -1)) it goes wherever it fits. Respects dst's weight
## limit. Returns how many moved (0 = nothing changed).
static func transfer(src: Node, index: int, dst: Node, cell := Vector2i(-1, -1), rotated := false, count := -1) -> int:
	if index < 0 or index >= src.entries.size():
		return 0
	var e: Dictionary = src.entries[index]
	var item: Resource = e.item
	var n := int(e.count) if count < 0 else mini(count, int(e.count))
	n = mini(n, weight_room(dst, item))
	if n <= 0:
		return 0
	var put := 0
	if cell.x < 0:
		put = add_partial(dst, item, n)
	else:
		if rotated and not bool(dst.allow_rotation):
			rotated = false
		var target: int = dst.entry_at(cell)
		var stack: int = dst.max_stack_of(item)
		if target >= 0 and dst.item_id_of(dst.entries[target].item) == dst.item_id_of(item):
			put = mini(stack - int(dst.entries[target].count), n)
			if put <= 0:
				return 0
			dst.entries[target].count = int(dst.entries[target].count) + put
		elif dst.is_area_free(cell, dst.item_size(item, rotated)):
			put = mini(n, stack)
			dst.entries.append({"item": item, "count": put, "x": cell.x, "y": cell.y, "rotated": rotated})
		else:
			return 0
		_changed(dst)
	if put > 0:
		src.take_from(index, put)
	return put


static func _changed(inv: Node) -> void:
	if inv.has_method(&"_after_change"):
		inv.call(&"_after_change")
	else:
		inv.emit_signal(&"changed")


## {item_id: total count} of to_data() entries.
static func count_items(data: Array) -> Dictionary:
	var out := {}
	for d in data:
		if d is Dictionary:
			var id := str(d.get("item_id", ""))
			out[id] = int(out.get(id, 0)) + int(d.get("count", 0))
	return out


## Total sell value of to_data() entries (item value x count).
func value_of_data(data: Array) -> int:
	var db := _database()
	var total := 0
	for d in data:
		if not d is Dictionary or db == null:
			continue
		var item: Resource = db.get_item(str(d.get("item_id", "")))
		if item != null and "value" in item:
			total += int(item.get("value")) * int(d.get("count", 0))
	return total


func _database() -> Resource:
	if _db == null and not item_database_path.is_empty() and ResourceLoader.exists(item_database_path):
		_db = load(item_database_path)
		if _db != null and not _db.has_method(&"get_item"):
			_db = null
	return _db


# =============================================================================
# overlay
# =============================================================================

func _show_overlay(text: String, color: Color) -> void:
	_clear_overlay()
	_overlay = CanvasLayer.new()
	_overlay.layer = 60
	add_child(_overlay)
	var dim := ColorRect.new()
	dim.color = Color(0, 0, 0, 0.55)
	dim.set_anchors_preset(Control.PRESET_FULL_RECT)
	dim.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_overlay.add_child(dim)
	var label := Label.new()
	label.text = text
	label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	label.set_anchors_preset(Control.PRESET_FULL_RECT)
	label.add_theme_font_size_override("font_size", 40)
	label.add_theme_color_override("font_color", color)
	label.add_theme_color_override("font_outline_color", Color.BLACK)
	label.add_theme_constant_override("outline_size", 8)
	_overlay.add_child(label)


func _clear_overlay() -> void:
	if _overlay != null and is_instance_valid(_overlay):
		_overlay.queue_free()
	_overlay = null


static func _thousands(n: int) -> String:
	var s := str(absi(n))
	var out := ""
	while s.length() > 3:
		out = "," + s.substr(s.length() - 3) + out
		s = s.substr(0, s.length() - 3)
	return ("-" if n < 0 else "") + s + out
