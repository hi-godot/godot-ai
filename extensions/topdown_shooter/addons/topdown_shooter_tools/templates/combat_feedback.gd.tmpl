extends Node

## Combat feel effects (generated by combat_feedback_setup).
##
## Muzzle flash, shell casings, hit particles, damage numbers, hitmarker,
## damage vignette and screen shake. Nothing else in the game is edited:
## this node finds weapons (nodes with fired/hit signals, e.g. from
## weapon_create) and damageable bodies (health_changed signal, e.g. the
## player and enemies) in the running scene, including ones spawned later,
## and reacts to their signals. Every effect has its own switch below, and
## `enabled` turns them all off.
##
## Free to edit: this file was copied into your project and is yours now.

## Master switch for every effect.
@export var enabled := true
## Shooters in this group count as "the player" (hitmarker, numbers, hurt).
@export var player_group: StringName = &"player"
## Camera to shake. Empty: the viewport's current Camera3D.
@export var camera_path: NodePath

@export_group("Muzzle flash")
@export var muzzle_flash := true
## Also flash enemy guns (weapon_create weapons and ranged enemies).
@export var muzzle_flash_for_enemies := true
@export var muzzle_flash_color := Color(1.0, 0.72, 0.3)
@export_range(0.05, 3.0, 0.01) var muzzle_flash_size := 0.35
@export_range(0.0, 30.0, 0.1) var muzzle_flash_light := 4.0
@export_range(0.01, 0.5, 0.01) var muzzle_flash_duration := 0.05

@export_group("Shell casings")
@export var shell_casings := true
@export var shell_casings_for_enemies := false
@export var casing_color := Color(0.85, 0.65, 0.25)
@export_range(0.1, 30.0, 0.1) var casing_lifetime := 2.5
@export_range(1, 500, 1) var max_casings := 60

@export_group("Hit particles")
@export var hit_particles := true
## Burst when a bullet hits something that takes damage.
@export var flesh_color := Color(0.75, 0.06, 0.06)
## Burst when a bullet hits a wall or anything else.
@export var spark_color := Color(1.0, 0.82, 0.45)
@export_range(1, 64, 1) var particle_amount := 10

@export_group("Damage numbers")
@export var damage_numbers := true
## Show numbers for enemy shots too (e.g. on the player). Off: player's shots only.
@export var damage_numbers_for_enemies := false
@export var damage_number_color := Color(1.0, 1.0, 1.0)
@export var kill_number_color := Color(1.0, 0.3, 0.2)
@export_range(8, 256, 1) var damage_number_font_size := 56
@export_range(0.1, 5.0, 0.05) var damage_number_rise := 1.0
@export_range(0.1, 3.0, 0.05) var damage_number_duration := 0.7
## Hits on one target within this many seconds add up into one number
## (shotgun pellets, fast SMG bursts). 0 shows every hit.
@export_range(0.0, 1.0, 0.01) var damage_number_merge_time := 0.12

@export_group("Hitmarker")
@export var hitmarker := true
@export var hitmarker_color := Color(1.0, 1.0, 1.0)
@export var kill_marker_color := Color(1.0, 0.25, 0.2)
@export_range(2.0, 80.0, 0.5) var hitmarker_size := 11.0
@export_range(0.5, 10.0, 0.5) var hitmarker_thickness := 2.5
@export_range(0.02, 1.0, 0.01) var hitmarker_duration := 0.16
## Draw at the mouse cursor (crosshair). Off: at the hit point on screen.
@export var hitmarker_at_cursor := true

@export_group("Damage vignette")
@export var damage_vignette := true
@export var vignette_color := Color(0.8, 0.0, 0.0)
@export_range(0.0, 1.0, 0.01) var vignette_max_alpha := 0.6
## Alpha added per point of damage, as a fraction of max health x this.
@export_range(0.0, 20.0, 0.1) var vignette_per_damage := 4.0
@export_range(0.1, 20.0, 0.1) var vignette_fade_speed := 2.0
## Below this health fraction the vignette keeps pulsing. 0 turns it off.
@export_range(0.0, 1.0, 0.01) var low_health_threshold := 0.3

@export_group("Screen shake")
@export var screen_shake := true
@export_range(0.0, 3.0, 0.05) var shake_strength := 1.0
## Largest camera offset in meters at full shake.
@export_range(0.0, 3.0, 0.01) var max_shake_offset := 0.35
@export_range(0.1, 20.0, 0.1) var shake_decay := 3.0
@export_range(0.0, 1.0, 0.01) var shake_on_fire := 0.12
@export_range(0.0, 1.0, 0.01) var shake_on_hurt := 0.45
@export_range(0.0, 1.0, 0.01) var shake_on_kill := 0.2

const VIGNETTE_SHADER := """
shader_type canvas_item;
uniform vec4 tint : source_color = vec4(0.8, 0.0, 0.0, 1.0);
uniform float intensity = 0.0;
void fragment() {
	vec2 uv = UV - vec2(0.5);
	float d = length(uv) * 1.41421;
	float a = smoothstep(0.35, 1.05, d) * intensity;
	COLOR = vec4(tint.rgb, clamp(a, 0.0, 1.0) * tint.a);
}
"""

var _fx_root: Node3D
var _overlay: CanvasLayer
var _vignette: ColorRect
var _marker_canvas: Control

var _health := {}          ## instance id -> last known health
var _pending_damage := {}  ## instance id -> health lost by the last take_damage
var _numbers := {}         ## instance id -> {label, total, time}
var _markers: Array = []
var _casings: Array = []
var _flashes := {}         ## weapon instance id -> {root, light, time}

var _vignette_alpha := 0.0
var _trauma := 0.0
var _shake_time := 0.0
var _shake_camera: Camera3D
var _camera_base_offset := Vector2.ZERO
var _time := 0.0

var _casing_mesh: BoxMesh
var _particle_mesh: BoxMesh
var _flash_mesh: SphereMesh
var _flash_material: StandardMaterial3D

## Counters for tests and playtest reports.
var stats := {"shots": 0, "hits": 0, "kills": 0, "hurts": 0}


func _ready() -> void:
	_build_resources()
	_fx_root = Node3D.new()
	_fx_root.name = "Effects"
	_fx_root.top_level = true
	add_child(_fx_root)
	_overlay = CanvasLayer.new()
	_overlay.name = "Overlay"
	_overlay.layer = 90
	add_child(_overlay)
	_vignette = ColorRect.new()
	_vignette.name = "Vignette"
	_vignette.set_anchors_preset(Control.PRESET_FULL_RECT)
	_vignette.mouse_filter = Control.MOUSE_FILTER_IGNORE
	var shader := Shader.new()
	shader.code = VIGNETTE_SHADER
	var mat := ShaderMaterial.new()
	mat.shader = shader
	_vignette.material = mat
	_vignette.visible = false
	_overlay.add_child(_vignette)
	_marker_canvas = Control.new()
	_marker_canvas.name = "Hitmarkers"
	_marker_canvas.set_anchors_preset(Control.PRESET_FULL_RECT)
	_marker_canvas.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_marker_canvas.draw.connect(_draw_markers)
	_overlay.add_child(_marker_canvas)

	get_tree().node_added.connect(_on_node_added)
	var scene_root := get_tree().current_scene if get_tree().current_scene != null else get_parent()
	if scene_root != null:
		_watch_tree(scene_root)


func _exit_tree() -> void:
	_reset_camera()


func _process(delta: float) -> void:
	_time += delta
	_update_flashes(delta)
	_update_casings(delta)
	_update_vignette(delta)
	_update_shake(delta)
	if not _markers.is_empty():
		for marker in _markers:
			marker.time += delta
		_markers = _markers.filter(func(m: Dictionary) -> bool: return m.time < hitmarker_duration)
		_marker_canvas.queue_redraw()


# --- discovery ----------------------------------------------------------------

func _watch_tree(node: Node) -> void:
	_watch(node)
	for child in node.get_children():
		_watch_tree(child)


func _on_node_added(node: Node) -> void:
	if node == self or is_ancestor_of(node):
		return
	## node_added fires before the node's _ready; wait one call so scripts and
	## exported values are in place.
	_watch.call_deferred(node)


func _watch(node: Node) -> void:
	if not is_instance_valid(node) or not node.is_inside_tree():
		return
	if node.has_signal("fired") and node.has_signal("hit") and node.has_method("try_fire"):
		_connect_once(node, "fired", _on_weapon_fired.bind(node))
		_connect_once(node, "hit", _on_weapon_hit.bind(node))
	if node.has_signal("health_changed"):
		_connect_once(node, "health_changed", _on_health_changed.bind(node))
		## Before the node's _ready health may still be 0; the first
		## health_changed then falls back to the maximum it reports.
		var hp: Variant = node.get("health")
		if (hp is float or hp is int) and float(hp) > 0.0:
			_health[node.get_instance_id()] = float(hp)
	if node.has_signal("attacked") and node.has_method("get_weapon"):
		_connect_once(node, "attacked", _on_enemy_attacked.bind(node))


func _connect_once(node: Node, signal_name: String, callable: Callable) -> void:
	for connection in node.get_signal_connection_list(signal_name):
		var other: Callable = connection.callable
		if other.get_object() == self and other.get_method() == callable.get_method():
			return
	node.connect(signal_name, callable)


# --- signal handlers ------------------------------------------------------------

func _on_weapon_fired(_ammo_left: int, weapon: Node) -> void:
	if not enabled or not is_instance_valid(weapon):
		return
	stats.shots += 1
	var by_player := _is_player_weapon(weapon)
	var muzzle := _muzzle_of(weapon)
	if muzzle_flash and (by_player or muzzle_flash_for_enemies):
		_flash(weapon, muzzle)
	if shell_casings and (by_player or shell_casings_for_enemies):
		_spawn_casing(weapon as Node3D)
	if by_player:
		add_trauma(shake_on_fire)


func _on_weapon_hit(target: Node, hit_position: Vector3, damage: float, weapon: Node) -> void:
	if not enabled:
		return
	var by_player := is_instance_valid(weapon) and _is_player_weapon(weapon)
	var from: Vector3 = (weapon as Node3D).global_position if is_instance_valid(weapon) and weapon is Node3D else hit_position + Vector3.UP
	var damageable := is_instance_valid(target) and target.has_method("take_damage")
	if hit_particles:
		_burst(hit_position, (from - hit_position).normalized(), flesh_color if damageable else spark_color)
	if not damageable:
		return
	var id := target.get_instance_id()
	var dealt := damage
	if _pending_damage.has(id):
		dealt = _pending_damage[id]
		_pending_damage.erase(id)
	elif target.has_signal("health_changed"):
		dealt = 0.0  ## health did not change: dodge i-frames, already dead
	if dealt <= 0.0:
		return
	stats.hits += 1
	var killed := _is_dead(target)
	if killed and by_player:
		stats.kills += 1
		add_trauma(shake_on_kill)
	if damage_numbers and (by_player or damage_numbers_for_enemies):
		_show_number(target, hit_position, dealt, killed)
	if hitmarker and by_player:
		_add_marker(hit_position, killed)


func _on_health_changed(current: float, maximum: float, node: Node) -> void:
	var id := node.get_instance_id()
	var before: float = _health.get(id, maximum)
	_health[id] = current
	var lost := before - current
	if lost <= 0.0:
		return
	_pending_damage[id] = lost
	## Cleared next frame: only the hit signal that follows take_damage uses it.
	_clear_pending.call_deferred(id)
	if enabled and node.is_in_group(player_group):
		stats.hurts += 1
		if damage_vignette:
			_vignette_alpha = minf(_vignette_alpha + lost / maxf(maximum, 1.0) * vignette_per_damage * vignette_max_alpha, vignette_max_alpha)
		add_trauma(shake_on_hurt)


func _clear_pending(id: int) -> void:
	_pending_damage.erase(id)


## Ranged enemies without a weapon scene shoot their own ray; flash at their
## weapon mount so the player sees where the shot came from.
func _on_enemy_attacked(_target: Node, _damage: float, enemy: Node) -> void:
	if not enabled or not muzzle_flash or not muzzle_flash_for_enemies:
		return
	if not is_instance_valid(enemy) or str(enemy.get("attack_mode")) != "ranged" or enemy.get_weapon() != null:
		return
	var mount_path: Variant = enemy.get("weapon_mount_path")
	var mount: Node3D = enemy.get_node_or_null(mount_path) as Node3D if mount_path is NodePath else null
	_flash(enemy, mount if mount != null else enemy as Node3D)


# --- public helpers -------------------------------------------------------------

## Adds screen shake (0..1). Anything in the game may call this.
func add_trauma(amount: float) -> void:
	if not enabled or not screen_shake or amount <= 0.0:
		return
	_trauma = clampf(_trauma + amount * shake_strength, 0.0, 1.0)


## Shows a damage number at a world position (e.g. for explosions).
func show_damage(at: Vector3, amount: float, killed := false) -> void:
	_show_number(null, at, amount, killed)


# --- muzzle flash ---------------------------------------------------------------

func _flash(owner_node: Node, muzzle: Node3D) -> void:
	if muzzle == null:
		return
	var id := owner_node.get_instance_id()
	var entry: Dictionary = _flashes.get(id, {})
	if entry.is_empty() or not is_instance_valid(entry.root):
		var root := Node3D.new()
		root.name = "MuzzleFlash"
		var mesh := MeshInstance3D.new()
		mesh.mesh = _flash_mesh
		mesh.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
		root.add_child(mesh)
		var light := OmniLight3D.new()
		light.omni_range = 4.0
		light.shadow_enabled = false
		root.add_child(light)
		muzzle.add_child(root)
		root.position = Vector3(0, 0, -muzzle_flash_size * 0.6)
		entry = {"root": root, "mesh": mesh, "light": light, "time": 0.0}
		_flashes[id] = entry
	entry.time = muzzle_flash_duration
	entry.root.visible = true
	var s := muzzle_flash_size * randf_range(0.8, 1.25)
	entry.mesh.scale = Vector3(s, s, s * randf_range(1.8, 2.6))
	entry.mesh.rotation.z = randf() * TAU
	_flash_material.albedo_color = muzzle_flash_color
	entry.light.light_color = muzzle_flash_color
	entry.light.light_energy = muzzle_flash_light


func _update_flashes(delta: float) -> void:
	for id in _flashes.keys():
		var entry: Dictionary = _flashes[id]
		if not is_instance_valid(entry.root):
			_flashes.erase(id)
			continue
		if entry.time > 0.0:
			entry.time -= delta
			if entry.time <= 0.0:
				entry.root.visible = false


# --- shell casings --------------------------------------------------------------

func _spawn_casing(weapon: Node3D) -> void:
	if weapon == null:
		return
	var casing := MeshInstance3D.new()
	casing.mesh = _casing_mesh
	casing.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	_fx_root.add_child(casing)
	var basis := weapon.global_basis.orthonormalized()
	casing.global_position = weapon.global_position + basis.x * 0.08
	var velocity := basis.x * randf_range(1.6, 2.6) + Vector3.UP * randf_range(1.8, 2.8) + basis.z * randf_range(0.0, 0.8)
	var shooter := _shooter_of(weapon)
	var floor_y := (shooter as Node3D).global_position.y + 0.03 if shooter is Node3D else weapon.global_position.y - 1.15
	_casings.append({"node": casing, "velocity": velocity, "spin": Vector3(randf_range(-20, 20), randf_range(-20, 20), randf_range(-20, 20)), "age": 0.0, "floor": floor_y})
	while _casings.size() > max_casings:
		var old: Dictionary = _casings.pop_front()
		if is_instance_valid(old.node):
			old.node.queue_free()


func _update_casings(delta: float) -> void:
	if _casings.is_empty():
		return
	var keep: Array = []
	for c in _casings:
		var node: MeshInstance3D = c.node
		if not is_instance_valid(node):
			continue
		c.age += delta
		if c.age >= casing_lifetime:
			node.queue_free()
			continue
		var v: Vector3 = c.velocity
		if v.length_squared() > 0.0004 or node.global_position.y > c.floor + 0.001:
			v.y -= 9.8 * delta
			var pos := node.global_position + v * delta
			if pos.y < c.floor:
				pos.y = c.floor
				v.y = -v.y * 0.3
				v.x *= 0.55
				v.z *= 0.55
				c.spin *= 0.5
				if absf(v.y) < 0.4:
					v.y = 0.0
			node.global_position = pos
			node.rotation += c.spin * delta
			c.velocity = v
		var fade_start := casing_lifetime * 0.8
		if c.age > fade_start:
			node.scale = Vector3.ONE * clampf(1.0 - (c.age - fade_start) / (casing_lifetime - fade_start), 0.0, 1.0)
		keep.append(c)
	_casings = keep


# --- hit particles --------------------------------------------------------------

func _burst(at: Vector3, normal: Vector3, color: Color) -> void:
	var p := CPUParticles3D.new()
	p.one_shot = true
	p.emitting = false
	p.amount = particle_amount
	p.lifetime = 0.35
	p.explosiveness = 1.0
	p.local_coords = false
	p.mesh = _particle_mesh
	p.direction = normal if normal.length_squared() > 0.001 else Vector3.UP
	p.spread = 50.0
	p.initial_velocity_min = 2.0
	p.initial_velocity_max = 5.0
	p.gravity = Vector3(0, -12, 0)
	p.scale_amount_min = 0.6
	p.scale_amount_max = 1.3
	p.color = color
	_fx_root.add_child(p)
	p.global_position = at
	p.emitting = true
	get_tree().create_timer(p.lifetime + 0.3, false).timeout.connect(p.queue_free)


# --- damage numbers -------------------------------------------------------------

func _show_number(target: Node, at: Vector3, amount: float, killed: bool) -> void:
	var now := _time
	var id := target.get_instance_id() if is_instance_valid(target) else 0
	if id != 0 and damage_number_merge_time > 0.0 and _numbers.has(id):
		var prev: Dictionary = _numbers[id]
		if is_instance_valid(prev.label) and now - prev.time <= damage_number_merge_time:
			prev.total += amount
			prev.time = now
			_style_number(prev.label, prev.total, killed)
			_animate_number(prev.label, prev.label.global_position)
			return
	var label := Label3D.new()
	label.billboard = BaseMaterial3D.BILLBOARD_ENABLED
	label.no_depth_test = true
	label.fixed_size = true
	label.pixel_size = 0.0008
	label.render_priority = 10
	label.outline_size = 12
	label.outline_modulate = Color(0, 0, 0, 0.85)
	_fx_root.add_child(label)
	var start := at + Vector3(randf_range(-0.25, 0.25), 0.6, randf_range(-0.15, 0.15))
	label.global_position = start
	_style_number(label, amount, killed)
	_animate_number(label, start)
	if id != 0:
		_numbers[id] = {"label": label, "total": amount, "time": now}


func _style_number(label: Label3D, amount: float, killed: bool) -> void:
	label.text = str(roundi(amount)) if absf(amount - roundf(amount)) < 0.05 else "%.1f" % amount
	label.modulate = kill_number_color if killed else damage_number_color
	label.font_size = int(damage_number_font_size * (1.3 if killed else 1.0))


func _animate_number(label: Label3D, start: Vector3) -> void:
	if label.has_meta("tween"):
		var old: Variant = label.get_meta("tween")
		if old is Tween and old.is_valid():
			old.kill()
	label.global_position = start
	label.scale = Vector3.ONE * 1.5
	var color := label.modulate
	color.a = 1.0
	label.modulate = color
	var tween := label.create_tween().set_parallel(true)
	tween.tween_property(label, "scale", Vector3.ONE, damage_number_duration * 0.25).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
	tween.tween_property(label, "global_position", start + Vector3.UP * damage_number_rise, damage_number_duration).set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_CUBIC)
	tween.tween_property(label, "modulate:a", 0.0, damage_number_duration * 0.4).set_delay(damage_number_duration * 0.6)
	tween.chain().tween_callback(label.queue_free)
	label.set_meta("tween", tween)


# --- hitmarker ------------------------------------------------------------------

func _add_marker(world_pos: Vector3, killed: bool) -> void:
	## A kill replaces the plain marker of the same shot.
	_markers = _markers.filter(func(m: Dictionary) -> bool: return m.time > 0.0)
	_markers.append({"world": world_pos, "kill": killed, "time": 0.0, "cursor": get_viewport().get_mouse_position()})
	_marker_canvas.queue_redraw()


func _draw_markers() -> void:
	var camera := get_viewport().get_camera_3d()
	for m in _markers:
		var pos: Vector2 = m.cursor
		if not hitmarker_at_cursor and camera != null and not camera.is_position_behind(m.world):
			pos = camera.unproject_position(m.world)
		var t: float = clampf(m.time / hitmarker_duration, 0.0, 1.0)
		var color: Color = kill_marker_color if m.kill else hitmarker_color
		color.a = 1.0 - t * t
		var size := hitmarker_size * (1.25 if m.kill else 1.0) * (1.0 + 0.35 * (1.0 - t))
		var gap := size * 0.45
		for dir in [Vector2(1, 1), Vector2(-1, 1), Vector2(1, -1), Vector2(-1, -1)]:
			var d: Vector2 = dir.normalized()
			_marker_canvas.draw_line(pos + d * gap, pos + d * (gap + size), color, hitmarker_thickness, true)


# --- vignette -------------------------------------------------------------------

func _update_vignette(delta: float) -> void:
	_vignette_alpha = maxf(_vignette_alpha - vignette_fade_speed * delta * maxf(_vignette_alpha, 0.15), 0.0)
	var pulse := 0.0
	if enabled and damage_vignette and low_health_threshold > 0.0:
		var frac := _player_health_fraction()
		if frac >= 0.0 and frac < low_health_threshold and frac > 0.0:
			var depth := 1.0 - frac / low_health_threshold
			pulse = vignette_max_alpha * (0.25 + 0.3 * depth) * (0.75 + 0.25 * sin(_time * 6.0))
	var alpha := maxf(_vignette_alpha, pulse) if enabled and damage_vignette else 0.0
	_vignette.visible = alpha > 0.002
	if _vignette.visible:
		var mat := _vignette.material as ShaderMaterial
		mat.set_shader_parameter("tint", vignette_color)
		mat.set_shader_parameter("intensity", alpha * 1.6)


func _player_health_fraction() -> float:
	var player := get_tree().get_first_node_in_group(player_group)
	if player == null:
		return -1.0
	var hp: Variant = player.get("health")
	var maximum: Variant = player.get("max_health")
	if not (hp is float or hp is int) or not (maximum is float or maximum is int) or float(maximum) <= 0.0:
		return -1.0
	return float(hp) / float(maximum)


# --- screen shake ---------------------------------------------------------------

func _update_shake(delta: float) -> void:
	var camera := _camera()
	if camera != _shake_camera:
		_reset_camera()
		_shake_camera = camera
		if camera != null:
			_camera_base_offset = Vector2(camera.h_offset, camera.v_offset)
	if camera == null:
		return
	if _trauma <= 0.0:
		if camera.h_offset != _camera_base_offset.x or camera.v_offset != _camera_base_offset.y:
			camera.h_offset = _camera_base_offset.x
			camera.v_offset = _camera_base_offset.y
		return
	_trauma = maxf(_trauma - shake_decay * delta * 0.5, 0.0)
	_shake_time += delta
	var amount := _trauma * _trauma * max_shake_offset
	if not enabled or not screen_shake:
		amount = 0.0
	var ox := (sin(_shake_time * 61.0) + sin(_shake_time * 37.3 + 1.7)) * 0.5
	var oy := (sin(_shake_time * 53.0 + 0.9) + sin(_shake_time * 29.1 + 4.2)) * 0.5
	camera.h_offset = _camera_base_offset.x + ox * amount
	camera.v_offset = _camera_base_offset.y + oy * amount


func _camera() -> Camera3D:
	if not camera_path.is_empty():
		return get_node_or_null(camera_path) as Camera3D
	return get_viewport().get_camera_3d()


func _reset_camera() -> void:
	if is_instance_valid(_shake_camera):
		_shake_camera.h_offset = _camera_base_offset.x
		_shake_camera.v_offset = _camera_base_offset.y
	_shake_camera = null


# --- helpers --------------------------------------------------------------------

func _shooter_of(weapon: Node) -> Node:
	if weapon.has_method("get_shooter"):
		return weapon.get_shooter()
	var node := weapon.get_parent()
	while node != null and not node is CollisionObject3D:
		node = node.get_parent()
	return node


func _is_player_weapon(weapon: Node) -> bool:
	var shooter := _shooter_of(weapon)
	return shooter != null and shooter.is_in_group(player_group)


func _muzzle_of(weapon: Node) -> Node3D:
	var path: Variant = weapon.get("muzzle_path")
	if path is NodePath and not (path as NodePath).is_empty():
		var muzzle := weapon.get_node_or_null(path) as Node3D
		if muzzle != null:
			return muzzle
	return weapon as Node3D


func _is_dead(target: Node) -> bool:
	if target.get("is_dead") == true:
		return true
	var hp: Variant = target.get("health")
	return (hp is float or hp is int) and float(hp) <= 0.0


func _build_resources() -> void:
	_casing_mesh = BoxMesh.new()
	_casing_mesh.size = Vector3(0.035, 0.035, 0.09)
	var casing_mat := StandardMaterial3D.new()
	casing_mat.albedo_color = casing_color
	casing_mat.metallic = 0.8
	casing_mat.roughness = 0.35
	_casing_mesh.material = casing_mat

	_particle_mesh = BoxMesh.new()
	_particle_mesh.size = Vector3(0.06, 0.06, 0.06)
	var particle_mat := StandardMaterial3D.new()
	particle_mat.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	particle_mat.vertex_color_use_as_albedo = true
	_particle_mesh.material = particle_mat

	_flash_mesh = SphereMesh.new()
	_flash_mesh.radius = 0.5
	_flash_mesh.height = 1.0
	_flash_mesh.radial_segments = 8
	_flash_mesh.rings = 4
	_flash_material = StandardMaterial3D.new()
	_flash_material.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	_flash_material.blend_mode = BaseMaterial3D.BLEND_MODE_ADD
	_flash_material.albedo_color = muzzle_flash_color
	_flash_material.no_depth_test = false
	_flash_mesh.material = _flash_material
