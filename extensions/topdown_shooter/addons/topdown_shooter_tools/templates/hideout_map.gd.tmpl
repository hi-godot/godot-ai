extends Node3D

## Walkable 3D hideout (generated by hideout_scaffold with style="map").
##
## The player walks around a small base room. Two things in it matter:
##
##   locker (hideout_locker.gd)  stand next to it and press interact (E):
##                               the stash and raid bag screen (hideout.gd,
##                               the same one as the menu hideout) opens on
##                               top of the room. E, Tab or Esc closes it.
##   deploy door (hideout_door.gd)  stand on the pad in front of it for a
##                               few seconds: the raid loads with the bag.
##
## The stash screen is an instance of the menu hideout scene under the
## StashScreen CanvasLayer, so the HideoutState autoload (save file, bag
## coming home from a raid, stats) works exactly as with the menu hideout.
## Coming back from a raid, HideoutState loads this scene again and the
## result shows as a banner at the top.
##
## Free to edit: this file was copied into your project and is yours now.

signal stash_opened
signal stash_closed
signal deploying(scene: String)

@export var title := "은신처"
@export var player_path: NodePath = ^"Player"
@export var stash_screen_path: NodePath = ^"StashScreen"
## The hideout.gd Control (stash + raid bag) inside the stash screen.
@export var stash_ui_path: NodePath = ^"StashScreen/Hideout"
## Opens the stash at a locker; also closes it.
@export var interact_action: StringName = &"interact"
## Also closes the stash (Tab/I from inventory_ui_scaffold).
@export var toggle_action: StringName = &"inventory"
## The deploy door is the way out: hide the screen's 출격 button.
@export var hide_menu_deploy_button := true
## Keep guns the player scene carries usable in the hideout.
@export var allow_weapons := false
## Seconds the raid result banner stays up after coming home.
@export var banner_time := 6.0

var player: Node3D
var ui: Control
var screen: CanvasLayer
var state: Node
var is_stash_open := false
var is_deploying := false

var _hud: CanvasLayer
var _info: Label
var _prompt: Label
var _banner: Label
var _banner_left := 0.0


func is_hideout() -> bool:
	return true


func _ready() -> void:
	## The stash screen (a child, ready first) may already have deployed:
	## a playtest bot redeploys straight from HideoutState.hideout_ready.
	if not is_inside_tree():
		return
	add_to_group(&"hideout_map")
	player = get_node_or_null(player_path) as Node3D
	if player == null:
		player = get_tree().get_first_node_in_group(&"player") as Node3D
	screen = get_node_or_null(stash_screen_path) as CanvasLayer
	ui = get_node_or_null(stash_ui_path) as Control
	state = get_node_or_null(^"/root/HideoutState")
	if screen != null:
		screen.visible = false
	_build_hud()
	if ui == null:
		push_warning("HideoutMap: no stash screen at %s (hideout.gd); the locker cannot open" % stash_ui_path)
	else:
		_adapt_ui()
		for inv in [get_stash(), get_loadout()]:
			if inv != null and inv.has_signal(&"changed"):
				inv.changed.connect(_refresh_info)
		_show_raid_result()
	if player != null and not allow_weapons:
		_disarm(player)
	_refresh_info()


func _process(delta: float) -> void:
	if _banner_left > 0.0:
		_banner_left -= delta
		if _banner_left <= 0.0:
			_banner.visible = false
	_refresh_prompt()


func _unhandled_input(event: InputEvent) -> void:
	if event.is_echo() or not event.is_pressed():
		return
	if is_stash_open:
		if _is(event, interact_action) or _is(event, toggle_action) or event.is_action_pressed(&"ui_cancel"):
			close_stash()
			get_viewport().set_input_as_handled()
		return
	if is_deploying:
		return
	if _is(event, interact_action) and nearest_locker() != null:
		open_stash()
		get_viewport().set_input_as_handled()


static func _is(event: InputEvent, action: StringName) -> bool:
	return action != &"" and InputMap.has_action(action) and event.is_action_pressed(action)


# --- stash ---------------------------------------------------------------------

func get_stash() -> Node:
	return ui.get("stash") if ui != null else null


func get_loadout() -> Node:
	return ui.get("loadout") if ui != null else null


## The locker the player can reach now, or null.
func nearest_locker() -> Node3D:
	if player == null or not is_instance_valid(player):
		return null
	var best: Node3D = null
	var best_d := INF
	for node in get_tree().get_nodes_in_group(&"hideout_locker"):
		var locker := node as Node3D
		if locker == null or not locker.has_method(&"can_reach") or not locker.can_reach(player):
			continue
		var d := locker.global_position.distance_squared_to(player.global_position)
		if d < best_d:
			best_d = d
			best = locker
	return best


func open_stash() -> void:
	if is_stash_open or ui == null or screen == null:
		return
	is_stash_open = true
	screen.visible = true
	_freeze_player(true)
	stash_opened.emit()
	_refresh_prompt()


func close_stash() -> void:
	if not is_stash_open:
		return
	is_stash_open = false
	if ui.has_method(&"cancel_drag"):
		ui.cancel_drag()
	if ui.has_method(&"hide_tooltip"):
		ui.hide_tooltip()
	screen.visible = false
	_freeze_player(false)
	stash_closed.emit()
	_refresh_info()


# --- deploy --------------------------------------------------------------------

## Saves and loads the raid with the bag (called by the deploy door).
## Returns OK or an error.
func deploy() -> Error:
	if is_deploying:
		return ERR_BUSY
	close_stash()
	if ui == null or not ui.has_method(&"deploy"):
		flash("출격할 수 없습니다: 창고 화면이 없습니다")
		return ERR_UNCONFIGURED
	var scene := str(ui.get_raid_scene()) if ui.has_method(&"get_raid_scene") else ""
	is_deploying = true
	deploying.emit(scene)
	var err: Error = ui.deploy()
	if err != OK:
		is_deploying = false
		flash("출격할 수 없습니다: 레이드 씬이 없습니다 (%s)" % scene)
		return err
	_freeze_player(true)
	_show_banner("출격!  %s" % scene.get_file().get_basename(), Color(1.0, 0.8, 0.4), 10.0)
	return OK


func raid_scene_name() -> String:
	if ui != null and ui.has_method(&"get_raid_scene"):
		return str(ui.get_raid_scene()).get_file().get_basename()
	return ""


# --- player --------------------------------------------------------------------

func _freeze_player(frozen: bool) -> void:
	if player == null or not is_instance_valid(player):
		return
	player.set_physics_process(not frozen)
	if frozen and "velocity" in player:
		player.set("velocity", Vector3.ZERO)


## No shooting at home: drops any gun the player scene carries.
func _disarm(body: Node) -> void:
	var mount_path: Variant = body.get("weapon_mount_path")
	var mount := body.get_node_or_null(mount_path) if mount_path is NodePath else null
	if mount == null:
		return
	for child in mount.get_children():
		if child.has_method(&"try_fire"):
			mount.remove_child(child)
			child.queue_free()


# --- screen tweaks -------------------------------------------------------------

## The menu hideout's 출격 button becomes a 닫기 button: the door deploys.
func _adapt_ui() -> void:
	var deploy_button := ui.get("_deploy_button") as Button
	if deploy_button == null or not hide_menu_deploy_button:
		return
	deploy_button.visible = false
	var close := Button.new()
	close.name = "CloseButton"
	close.text = "닫기  (%s / Esc)" % key_label(interact_action)
	close.focus_mode = Control.FOCUS_NONE
	close.custom_minimum_size = deploy_button.custom_minimum_size
	close.add_theme_font_size_override("font_size", 22)
	close.pressed.connect(close_stash)
	var parent := deploy_button.get_parent()
	parent.add_child(close)
	parent.move_child(close, deploy_button.get_index())
	var note := Label.new()
	note.text = "출격은 은신처의 출격 문 앞에 서 있으면 됩니다"
	note.add_theme_color_override("font_color", Color(0.7, 0.72, 0.76))
	parent.add_child(note)
	parent.move_child(note, close.get_index())


# --- HUD -----------------------------------------------------------------------

func _build_hud() -> void:
	_hud = CanvasLayer.new()
	_hud.name = "HUD"
	_hud.layer = 10
	add_child(_hud)
	_info = _label(18, Color(0.9, 0.92, 0.95))
	_info.position = Vector2(20, 16)
	_hud.add_child(_info)
	_prompt = _label(26, Color(1, 1, 1))
	_prompt.set_anchors_preset(Control.PRESET_CENTER_BOTTOM)
	_prompt.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	_prompt.grow_horizontal = Control.GROW_DIRECTION_BOTH
	_prompt.grow_vertical = Control.GROW_DIRECTION_BEGIN
	_prompt.offset_bottom = -60.0
	_hud.add_child(_prompt)
	_banner = _label(24, Color(1, 1, 1))
	_banner.set_anchors_preset(Control.PRESET_CENTER_TOP)
	_banner.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	_banner.grow_horizontal = Control.GROW_DIRECTION_BOTH
	_banner.offset_top = 70.0
	_banner.visible = false
	_hud.add_child(_banner)


func _label(size: int, color: Color) -> Label:
	var label := Label.new()
	label.add_theme_font_size_override("font_size", size)
	label.add_theme_color_override("font_color", color)
	label.add_theme_color_override("font_outline_color", Color.BLACK)
	label.add_theme_constant_override("outline_size", 6)
	label.mouse_filter = Control.MOUSE_FILTER_IGNORE
	return label


func _refresh_info() -> void:
	if _info == null:
		return
	var lines: Array[String] = [title]
	var stash := get_stash()
	var bag := get_loadout()
	if stash != null and bag != null:
		var count := 0
		for e in bag.entries:
			count += int(e.count)
		var limit := float(bag.max_weight)
		lines.append("창고 ₩%s · 출격 가방 %d개 ₩%s · %.1f%s" % [
			_thousands(int(stash.get_total_value())), count, _thousands(int(bag.get_total_value())),
			float(bag.get_total_weight()), " / %.0f kg" % limit if limit > 0.0 else " kg"])
	if state != null and state.get("stats") is Dictionary:
		var s: Dictionary = state.stats
		lines.append("레이드 %d · 탈출 %d · 사망 %d" % [int(s.get("raids", 0)), int(s.get("extracted", 0)), int(s.get("died", 0)) + int(s.get("mia", 0))])
	_info.text = "\n".join(lines)


func _refresh_prompt() -> void:
	if _prompt == null:
		return
	var text := ""
	if is_stash_open or is_deploying:
		text = ""
	else:
		for door in get_tree().get_nodes_in_group(&"hideout_door"):
			if door.has_method(&"time_left") and float(door.time_left()) >= 0.0:
				text = "출격까지 %.1f초 · 문에서 벗어나면 취소" % float(door.time_left())
				break
		if text.is_empty():
			var locker := nearest_locker()
			if locker != null:
				text = "[%s] %s 열기" % [key_label(interact_action), str(locker.get("locker_name"))]
	_prompt.text = text
	_prompt.visible = not text.is_empty()


## The raid result the stash screen worked out (bag moved home, bag lost...).
func _show_raid_result() -> void:
	var banner := ui.get("_banner") as Control
	var label := ui.get("_banner_label") as Label
	if banner == null or label == null or not banner.visible or label.text.is_empty():
		return
	_show_banner(label.text, label.get_theme_color(&"font_color"), banner_time)


func _show_banner(text: String, color: Color, seconds: float) -> void:
	_banner.text = text
	_banner.add_theme_color_override("font_color", color)
	_banner.visible = true
	_banner_left = seconds


func flash(text: String) -> void:
	_show_banner(text, Color(1.0, 0.55, 0.45), 2.5)


## "E" for an action bound to the E key (first key event), else the action.
static func key_label(action: StringName) -> String:
	if InputMap.has_action(action):
		for ev in InputMap.action_get_events(action):
			if ev is InputEventKey:
				var code: Key = ev.keycode if ev.keycode != KEY_NONE else ev.physical_keycode
				if code != KEY_NONE:
					return OS.get_keycode_string(code)
	return str(action)


static func _thousands(n: int) -> String:
	var s := str(absi(n))
	var out := ""
	while s.length() > 3:
		out = "," + s.substr(s.length() - 3) + out
		s = s.substr(0, s.length() - 3)
	return ("-" if n < 0 else "") + s + out
