extends Area3D

## Deploy door of the 3D hideout (generated by hideout_scaffold with
## style="map").
##
## A player (a body in `player_group`) that stays on the pad for
## `deploy_time` seconds deploys: the hideout map's deploy() saves and loads
## the raid with the raid bag. Stepping off cancels. Nothing counts while
## the stash screen is open.
##
## Free to edit: this file was copied into your project and is yours now.

signal deploy_started(body: Node)
signal deploy_cancelled(body: Node)
signal deployed(body: Node)

@export var door_name := "출격"
@export var deploy_time := 3.0
@export var player_group: StringName = &"player"

var is_done := false
var _body: Node3D
var _timer := 0.0
var _label: Label3D


func _ready() -> void:
	add_to_group(&"hideout_door")
	_label = get_node_or_null(^"Label") as Label3D
	if Engine.is_editor_hint():
		return
	monitoring = true
	body_entered.connect(_on_body_entered)
	body_exited.connect(_on_body_exited)
	_reset_label()


func _process(delta: float) -> void:
	if Engine.is_editor_hint() or is_done or _body == null:
		return
	if not is_instance_valid(_body) or not _body.is_inside_tree():
		_body = null
		_reset_label()
		return
	var map := get_map()
	if map != null and bool(map.get("is_stash_open")):
		return
	_timer += delta
	if _label != null:
		_label.text = "%s\n%.1f" % [door_name, maxf(deploy_time - _timer, 0.0)]
	if _timer >= deploy_time:
		deploy(_body)


## Seconds left for the player on the pad, or -1 when nobody is waiting.
func time_left() -> float:
	return maxf(deploy_time - _timer, 0.0) if _body != null and not is_done else -1.0


## The hideout map this door belongs to (the first ancestor with deploy()).
func get_map() -> Node:
	var node := get_parent()
	while node != null:
		if node.has_method(&"deploy") and node.has_method(&"is_hideout"):
			return node
		node = node.get_parent()
	return null


## Deploys now. Returns OK or an error (the door stays usable on errors).
func deploy(body: Node = null) -> Error:
	if is_done:
		return ERR_BUSY
	var map := get_map()
	if map == null:
		push_warning("HideoutDoor: not inside a hideout map (hideout_map.gd); cannot deploy")
		return ERR_UNCONFIGURED
	is_done = true
	_body = null
	if _label != null:
		_label.text = "%s!" % door_name
	var err: Error = map.deploy()
	if err != OK:
		is_done = false
		_timer = 0.0
		_reset_label()
		return err
	deployed.emit(body)
	return OK


func _on_body_entered(body: Node) -> void:
	if is_done or _body != null or not body.is_in_group(player_group) or not body is Node3D:
		return
	_body = body
	_timer = 0.0
	deploy_started.emit(body)


func _on_body_exited(body: Node) -> void:
	if body != _body or is_done:
		return
	_body = null
	_timer = 0.0
	_reset_label()
	deploy_cancelled.emit(body)


func _reset_label() -> void:
	if _label == null:
		return
	var map := get_map()
	var raid := str(map.raid_scene_name()) if map != null and map.has_method(&"raid_scene_name") else ""
	_label.text = door_name if raid.is_empty() else "%s\n%s" % [door_name, raid]
