extends Node

## Playtest notes (generated by playtest_notes; registered as an autoload).
##
## While you play, press F9 or F8 (or Ctrl+N / Cmd+N, or your own "playtest_note"
## input action) to leave a note right where something is wrong:
##   1. the frame you were looking at is saved as a screenshot,
##   2. the game pauses and a pin marks the spot under the mouse (or the
##      player, switch with Tab),
##   3. type the note and press Enter (Shift+Enter for a new line, Esc to
##      cancel).
## Each note is one JSON file plus a PNG in res://playtest_notes/ (user://
## in an exported build): text, category, scene, world position, player and
## camera, the node under the cursor, recent engine errors and the time.
## The playtest_notes editor tool lists them, shows them as pins in the
## editor and marks them resolved once fixed.
##
## Free to edit: this file was copied into your project and is yours now.

const NOTES_DIR := "res://playtest_notes/"
const EXPORT_NOTES_DIR := "user://playtest_notes/"
const ACTION := &"playtest_note"
const VERSION := 1
const CATEGORIES := ["bug", "balance", "level", "idea", "other"]
const CATEGORY_LABELS := {"bug": "버그", "balance": "밸런스", "level": "레벨/맵", "idea": "아이디어", "other": "기타"}
const CATEGORY_COLORS := {
	"bug": Color(0.95, 0.25, 0.2),
	"balance": Color(0.95, 0.7, 0.15),
	"level": Color(0.3, 0.7, 1.0),
	"idea": Color(0.45, 0.85, 0.4),
	"other": Color(0.8, 0.8, 0.8),
}
## Notes are only taken in debug builds (editor runs and debug exports).
const ENABLED_IN_RELEASE := false

## Collects recent engine errors so a note can show what just went wrong.
## Logger virtuals can run on any thread, hence the mutex.
class ErrorTail extends Logger:
	var mutex := Mutex.new()
	var lines: Array = []

	func _log_error(
		function: String,
		file: String,
		line: int,
		code: String,
		rationale: String,
		_editor_notify: bool,
		error_type: int,
		_script_backtraces: Array,
	) -> void:
		var message := rationale if not rationale.is_empty() else code
		var where := "%s:%d" % [file, line] if not file.is_empty() else ""
		if not function.is_empty():
			where += " @ " + function
		var kind := "warning" if error_type == ERROR_TYPE_WARNING else "error"
		mutex.lock()
		lines.append({"kind": kind, "message": message, "where": where, "ticks_msec": Time.get_ticks_msec()})
		if lines.size() > 10:
			lines.pop_front()
		mutex.unlock()

	func recent() -> Array:
		mutex.lock()
		var out := lines.duplicate(true)
		mutex.unlock()
		return out


var enabled := false
## Overrides notes_dir() when set (tests).
var notes_folder := ""

var _errors: ErrorTail = null
var _open := false
var _was_paused := false
var _prev_mouse_mode := Input.MOUSE_MODE_VISIBLE
var _start_msec := 0

## Captured when the note key is pressed.
var _shot: Image = null
var _context := {}
var _use_player := false

var _layer: CanvasLayer = null
var _panel: PanelContainer = null
var _title: Label = null
var _info: Label = null
var _text: TextEdit = null
var _category: OptionButton = null
var _toast: Label = null
var _toast_left := 0.0
var _pins: Node3D = null


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	enabled = OS.is_debug_build() or ENABLED_IN_RELEASE
	set_process(false)
	if not enabled:
		set_process_input(false)
		return
	_start_msec = Time.get_ticks_msec()
	_errors = ErrorTail.new()
	OS.add_logger(_errors)
	_build_ui()


func _exit_tree() -> void:
	if _errors != null:
		OS.remove_logger(_errors)
		_errors = null


## Where notes go: the project folder when the game runs from the editor,
## user:// in an exported build (res:// is read-only there).
func notes_dir() -> String:
	if not notes_folder.is_empty():
		return notes_folder
	return NOTES_DIR if OS.has_feature("editor") else EXPORT_NOTES_DIR


static func is_note_key(event: InputEvent) -> bool:
	if not event.is_pressed() or event.is_echo():
		return false
	if InputMap.has_action(ACTION):
		return event.is_action_pressed(ACTION, false, true)
	var key := event as InputEventKey
	if key == null:
		return false
	var code := key.physical_keycode if key.physical_keycode != KEY_NONE else key.keycode
	## F9 works everywhere. F8 stays for macOS, but on Windows and Linux the
	## Godot editor takes F8 as "Stop Running Project" and closes the game first.
	if (code == KEY_F9 or code == KEY_F8) and not key.ctrl_pressed and not key.meta_pressed and not key.alt_pressed:
		return true
	return code == KEY_N and (key.ctrl_pressed or key.meta_pressed) and not key.alt_pressed and not key.shift_pressed


func _input(event: InputEvent) -> void:
	if _open:
		if event is InputEventKey and event.pressed and not event.echo:
			match event.keycode:
				KEY_ESCAPE:
					_close(false)
					get_viewport().set_input_as_handled()
				KEY_TAB:
					_use_player = not _use_player
					_refresh_info()
					get_viewport().set_input_as_handled()
		return
	if is_note_key(event):
		get_viewport().set_input_as_handled()
		open_note()


func _process(delta: float) -> void:
	if _toast_left > 0.0:
		_toast_left -= delta
		if _toast_left <= 0.0:
			_toast.visible = false
			if not _open:
				_clear_pins()
	if not _open and _toast_left <= 0.0:
		set_process(false)


# --- open / close --------------------------------------------------------------

## Captures the screen and context, pauses, shows the note panel.
func open_note() -> void:
	if _open or not enabled:
		return
	var texture := get_viewport().get_texture()
	_shot = texture.get_image() if texture != null else null
	_context = capture_context()
	_use_player = not _context.has("cursor_position") and _context.has("player_position")
	_open = true
	_was_paused = get_tree().paused
	get_tree().paused = true
	_prev_mouse_mode = Input.mouse_mode
	Input.mouse_mode = Input.MOUSE_MODE_VISIBLE
	_text.text = ""
	_category.select(0)
	_refresh_info()
	_panel.visible = true
	_toast.visible = false
	_show_pins()
	_text.grab_focus()


func _close(save: bool) -> void:
	if not _open:
		return
	var saved := {}
	if save:
		saved = save_note(_text.text, CATEGORIES[maxi(_category.selected, 0)], _use_player)
	_open = false
	_panel.visible = false
	_text.release_focus()
	get_tree().paused = _was_paused
	Input.mouse_mode = _prev_mouse_mode
	_shot = null
	if saved.has("error"):
		_show_toast("메모 저장 실패: %s" % saved.error, Color(1, 0.4, 0.35))
	elif save:
		_show_toast("메모 저장됨 (%s)" % saved.get("id", ""), Color(0.6, 1, 0.6))
	else:
		_clear_pins()


func _show_toast(message: String, color: Color) -> void:
	_toast.text = message
	_toast.add_theme_color_override("font_color", color)
	_toast.visible = true
	_toast_left = 2.5
	set_process(true)


# --- context -----------------------------------------------------------------------

## Everything known about the moment the key was pressed.
func capture_context() -> Dictionary:
	var ctx := {
		"game_time_sec": snappedf((Time.get_ticks_msec() - _start_msec) / 1000.0, 0.1),
		"fps": Engine.get_frames_per_second(),
	}
	var scene := get_tree().current_scene
	if scene != null:
		ctx["scene"] = scene.scene_file_path
		ctx["scene_name"] = str(scene.name)
	var viewport := get_viewport()
	var size := viewport.get_visible_rect().size
	ctx["viewport_size"] = [int(size.x), int(size.y)]
	var mouse := viewport.get_mouse_position()
	ctx["mouse_screen"] = [snappedf(mouse.x, 0.1), snappedf(mouse.y, 0.1)]

	var player := _find_player()
	if player != null:
		ctx["player_position"] = _arr(player.global_position)
		ctx["player_node"] = _scene_path(player, scene)
		var state := {}
		for key in ["health", "max_health", "is_dead"]:
			if key in player:
				state[key] = player.get(key)
		if not state.is_empty():
			ctx["player_state"] = state

	var cam := viewport.get_camera_3d()
	if cam != null:
		ctx["camera"] = {"position": _arr(cam.global_position), "rotation_degrees": _arr(cam.global_rotation_degrees), "fov": cam.fov}
		var origin := cam.project_ray_origin(mouse)
		var normal := cam.project_ray_normal(mouse)
		var hit := {}
		var world := cam.get_world_3d()
		if world != null:
			var query := PhysicsRayQueryParameters3D.create(origin, origin + normal * 1000.0)
			query.collide_with_areas = false
			hit = world.direct_space_state.intersect_ray(query)
		if not hit.is_empty():
			ctx["cursor_position"] = _arr(hit.position)
			var collider := hit.get("collider") as Node
			if collider != null:
				ctx["cursor_node"] = _scene_path(collider, scene)
				ctx["cursor_node_class"] = collider.get_class()
		else:
			var plane_y := player.global_position.y if player != null else 0.0
			var point: Variant = Plane(Vector3.UP, plane_y).intersects_ray(origin, normal)
			if point != null:
				ctx["cursor_position"] = _arr(point)
	return ctx


func _find_player() -> Node3D:
	for node in get_tree().get_nodes_in_group(&"player"):
		if node is Node3D and node.is_inside_tree():
			return node
	return null


static func _scene_path(node: Node, scene: Node) -> String:
	if scene == null:
		return str(node.get_path())
	if node == scene:
		return "/" + str(scene.name)
	if scene.is_ancestor_of(node):
		return "/%s/%s" % [scene.name, scene.get_path_to(node)]
	return str(node.get_path())


static func _arr(v: Vector3) -> Array:
	return [snappedf(v.x, 0.01), snappedf(v.y, 0.01), snappedf(v.z, 0.01)]


static func _vec(a: Variant) -> Variant:
	if a is Array and a.size() == 3:
		return Vector3(float(a[0]), float(a[1]), float(a[2]))
	return null


func marker_position(use_player: bool) -> Variant:
	if use_player and _context.has("player_position"):
		return _context.player_position
	if _context.has("cursor_position"):
		return _context.cursor_position
	return _context.get("player_position", null)


# --- save --------------------------------------------------------------------------

static func new_id() -> String:
	var t := Time.get_datetime_dict_from_system()
	return "%04d%02d%02d-%02d%02d%02d-%04x" % [t.year, t.month, t.day, t.hour, t.minute, t.second, randi() & 0xffff]


## Builds the note dictionary (no files written).
func build_note(text: String, category: String, use_player: bool, id: String) -> Dictionary:
	var dir := notes_dir()
	var note := {
		"version": VERSION,
		"id": id,
		"status": "open",
		"text": text.strip_edges(),
		"category": category,
		"created": Time.get_datetime_string_from_system(false, true),
		"created_unix": Time.get_unix_time_from_system(),
		"position": marker_position(use_player),
		"position_source": "player" if use_player and _context.has("player_position") else ("cursor" if _context.has("cursor_position") else ("player" if _context.has("player_position") else "none")),
		"screenshot": "",
	}
	for key in _context:
		note[key] = _context[key]
	if _errors != null:
		var recent := _errors.recent()
		var now := Time.get_ticks_msec()
		for entry in recent:
			entry["seconds_ago"] = snappedf((now - int(entry.ticks_msec)) / 1000.0, 0.1)
			entry.erase("ticks_msec")
		note["recent_errors"] = recent
	note["notes_dir"] = dir
	return note


## Writes <id>.json (and <id>.png) into the notes folder. Returns the note,
## or {"error": message}.
func save_note(text: String, category: String, use_player: bool) -> Dictionary:
	var dir := notes_dir()
	var err := DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(dir))
	if err != OK and err != ERR_ALREADY_EXISTS:
		return {"error": "cannot create %s: %s" % [dir, error_string(err)]}
	## Keep the editor from importing the PNGs; the tool reads them directly.
	var ignore := dir + ".gdignore"
	if not FileAccess.file_exists(ignore):
		var f := FileAccess.open(ignore, FileAccess.WRITE)
		if f != null:
			f.store_string("")
			f.close()
	var id := new_id()
	var note := build_note(text, category, use_player, id)
	if _shot != null and not _shot.is_empty():
		var image := _shot.duplicate() as Image
		if image.is_compressed():
			image.decompress()
		_draw_marker(image, note.get("position", null))
		if image.save_png(dir + id + ".png") == OK:
			note["screenshot"] = dir + id + ".png"
	var file := FileAccess.open(dir + id + ".json", FileAccess.WRITE)
	if file == null:
		return {"error": "cannot write %s: %s" % [dir + id + ".json", error_string(FileAccess.get_open_error())]}
	file.store_string(JSON.stringify(note, "\t"))
	file.close()
	print("[PlaytestNotes] saved %s%s.json: %s" % [dir, id, note.text.replace("\n", " ").left(80)])
	return note


## Rings the marked spot on the screenshot so the picture alone says where.
func _draw_marker(image: Image, position: Variant) -> void:
	if not is_inside_tree():
		return
	var cam := get_viewport().get_camera_3d()
	var world: Variant = _vec(position)
	if cam == null or world == null or cam.is_position_behind(world):
		return
	var screen := cam.unproject_position(world)
	var view := get_viewport().get_visible_rect().size
	if view.x <= 0 or view.y <= 0:
		return
	var center := Vector2(screen.x * image.get_width() / view.x, screen.y * image.get_height() / view.y)
	var scale := maxf(image.get_height() / 720.0, 1.0)
	_ring(image, center, 18.0 * scale, 3.0 * scale, Color(1, 0.15, 0.1))
	_ring(image, center, 3.5 * scale, 3.5 * scale, Color(1, 0.15, 0.1))


static func _ring(image: Image, center: Vector2, radius: float, width: float, color: Color) -> void:
	var r_out := radius + width * 0.5
	var r_in := maxf(radius - width * 0.5, 0.0)
	var x0 := maxi(int(center.x - r_out), 0)
	var x1 := mini(int(center.x + r_out) + 1, image.get_width() - 1)
	var y0 := maxi(int(center.y - r_out), 0)
	var y1 := mini(int(center.y + r_out) + 1, image.get_height() - 1)
	for y in range(y0, y1 + 1):
		for x in range(x0, x1 + 1):
			var d := Vector2(x + 0.5, y + 0.5).distance_to(center)
			if d <= r_out and d >= r_in:
				image.set_pixel(x, y, color)


# --- UI ----------------------------------------------------------------------------

func _build_ui() -> void:
	_layer = CanvasLayer.new()
	_layer.layer = 120
	add_child(_layer)

	_panel = PanelContainer.new()
	_panel.visible = false
	_panel.set_anchors_and_offsets_preset(Control.PRESET_CENTER_BOTTOM)
	_panel.custom_minimum_size = Vector2(520, 0)
	_panel.grow_horizontal = Control.GROW_DIRECTION_BOTH
	_panel.grow_vertical = Control.GROW_DIRECTION_BEGIN
	_panel.offset_top = -24
	_panel.offset_bottom = -24
	var style := StyleBoxFlat.new()
	style.bg_color = Color(0.08, 0.09, 0.11, 0.94)
	style.border_color = Color(1, 0.85, 0.3)
	style.set_border_width_all(2)
	style.set_corner_radius_all(8)
	style.set_content_margin_all(14)
	_panel.add_theme_stylebox_override("panel", style)
	_layer.add_child(_panel)

	var box := VBoxContainer.new()
	box.add_theme_constant_override("separation", 8)
	_panel.add_child(box)

	_title = Label.new()
	_title.text = "플레이테스트 메모 (일시정지됨)"
	_title.add_theme_font_size_override("font_size", 18)
	_title.add_theme_color_override("font_color", Color(1, 0.88, 0.4))
	box.add_child(_title)

	_info = Label.new()
	_info.add_theme_font_size_override("font_size", 13)
	_info.add_theme_color_override("font_color", Color(0.75, 0.78, 0.82))
	_info.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	box.add_child(_info)

	var row := HBoxContainer.new()
	box.add_child(row)
	var cat_label := Label.new()
	cat_label.text = "종류"
	row.add_child(cat_label)
	_category = OptionButton.new()
	for c in CATEGORIES:
		_category.add_item(CATEGORY_LABELS[c])
	_category.focus_mode = Control.FOCUS_NONE
	row.add_child(_category)

	_text = TextEdit.new()
	_text.custom_minimum_size = Vector2(0, 96)
	_text.placeholder_text = "무엇이 이상한가요? (Enter 저장 · Shift+Enter 줄바꿈 · Esc 취소 · Tab 위치 전환)"
	_text.wrap_mode = TextEdit.LINE_WRAPPING_BOUNDARY
	_text.gui_input.connect(_on_text_input)
	box.add_child(_text)

	var buttons := HBoxContainer.new()
	buttons.alignment = BoxContainer.ALIGNMENT_END
	box.add_child(buttons)
	var cancel := Button.new()
	cancel.text = "취소 (Esc)"
	cancel.focus_mode = Control.FOCUS_NONE
	cancel.pressed.connect(_close.bind(false))
	buttons.add_child(cancel)
	var save := Button.new()
	save.text = "저장 (Enter)"
	save.focus_mode = Control.FOCUS_NONE
	save.pressed.connect(_close.bind(true))
	buttons.add_child(save)

	_toast = Label.new()
	_toast.visible = false
	_toast.position = Vector2(16, 12)
	_toast.add_theme_font_size_override("font_size", 16)
	_toast.add_theme_color_override("font_outline_color", Color.BLACK)
	_toast.add_theme_constant_override("outline_size", 6)
	_layer.add_child(_toast)


func _on_text_input(event: InputEvent) -> void:
	var key := event as InputEventKey
	if key == null or not key.pressed or key.echo:
		return
	if (key.keycode == KEY_ENTER or key.keycode == KEY_KP_ENTER) and not key.shift_pressed and not _text.has_ime_text():
		_text.accept_event()
		_close(true)


func _refresh_info() -> void:
	var where := "위치 없음"
	var pos: Variant = marker_position(_use_player)
	if pos != null:
		var source := "플레이어" if _use_player and _context.has("player_position") else "마우스"
		where = "%s 위치 (%.1f, %.1f, %.1f)" % [source, pos[0], pos[1], pos[2]]
	var target := ""
	if _context.has("cursor_node") and not _use_player:
		target = " · " + str(_context.cursor_node).get_file()
	var scene := str(_context.get("scene_name", "?"))
	var open_here := _existing_notes(str(_context.get("scene", ""))).size()
	_info.text = "%s · %s%s · 스크린샷 %s · 이 씬의 열린 메모 %d개" % [scene, where, target, "저장" if _shot != null else "없음", open_here]
	_show_pins()


# --- pins ---------------------------------------------------------------------------

## Open notes of `scene` already on disk.
func _existing_notes(scene: String) -> Array:
	var out: Array = []
	var dir := notes_dir()
	if scene.is_empty() or not DirAccess.dir_exists_absolute(dir):
		return out
	for file in DirAccess.get_files_at(dir):
		if file.get_extension() != "json":
			continue
		var json := JSON.new()
		if json.parse(FileAccess.get_file_as_string(dir + file)) != OK:
			continue
		var data: Variant = json.data
		if data is Dictionary and data.get("status", "open") == "open" and str(data.get("scene", "")) == scene:
			out.append(data)
	return out


## Shows the new note's pin plus the scene's other open notes, so you see
## what was already reported here.
func _show_pins() -> void:
	_clear_pins()
	var scene := get_tree().current_scene
	if scene == null or get_viewport().get_camera_3d() == null:
		return
	_pins = Node3D.new()
	_pins.name = "PlaytestNotePins"
	_pins.process_mode = Node.PROCESS_MODE_ALWAYS
	scene.add_child(_pins, false, Node.INTERNAL_MODE_BACK)
	for note in _existing_notes(str(_context.get("scene", ""))):
		var at: Variant = _vec(note.get("position", null))
		if at != null:
			_pins.add_child(make_pin(at, CATEGORY_COLORS.get(note.get("category", "other"), Color.WHITE), str(note.get("text", "")).left(30), 0.6))
	var here: Variant = _vec(marker_position(_use_player))
	if here != null:
		_pins.add_child(make_pin(here, Color(1, 0.85, 0.2), "새 메모", 1.0))


func _clear_pins() -> void:
	if _pins != null and is_instance_valid(_pins):
		_pins.queue_free()
	_pins = null


## A pin (stick + head + label) drawn on top of walls. Shared with the editor
## tool's markers so both look alike.
static func make_pin(at: Vector3, color: Color, label: String, alpha: float = 1.0) -> Node3D:
	var pin := Node3D.new()
	pin.position = at
	var mat := StandardMaterial3D.new()
	mat.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	mat.no_depth_test = true
	mat.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	mat.albedo_color = Color(color, alpha)
	mat.render_priority = 10
	var stick := MeshInstance3D.new()
	var cyl := CylinderMesh.new()
	cyl.top_radius = 0.04
	cyl.bottom_radius = 0.04
	cyl.height = 1.6
	stick.mesh = cyl
	stick.position = Vector3(0, 0.8, 0)
	stick.material_override = mat
	stick.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	pin.add_child(stick)
	var head := MeshInstance3D.new()
	var ball := SphereMesh.new()
	ball.radius = 0.22
	ball.height = 0.44
	head.mesh = ball
	head.position = Vector3(0, 1.7, 0)
	head.material_override = mat
	head.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	pin.add_child(head)
	var ring := MeshInstance3D.new()
	var torus := TorusMesh.new()
	torus.inner_radius = 0.35
	torus.outer_radius = 0.45
	ring.mesh = torus
	ring.position = Vector3(0, 0.03, 0)
	ring.material_override = mat
	ring.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	pin.add_child(ring)
	if not label.is_empty():
		var text := Label3D.new()
		text.text = label
		text.position = Vector3(0, 2.15, 0)
		text.billboard = BaseMaterial3D.BILLBOARD_ENABLED
		text.no_depth_test = true
		text.fixed_size = true
		text.pixel_size = 0.002
		text.font_size = 28
		text.outline_size = 8
		text.modulate = Color(1, 1, 1, alpha)
		text.render_priority = 11
		text.outline_render_priority = 10
		pin.add_child(text)
	return pin
