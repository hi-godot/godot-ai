extends Area3D

## An extraction zone (generated by raid_map_blockout).
##
## A player (a body in `player_group`) that stays inside for `extract_time`
## seconds extracts: the zone emits `extracted`, calls the player's
## on_extracted(zone) when it has one, freezes the player, and shows the
## result (with the bag's value when the player has an Inventory child).
## After `restart_delay` seconds the scene reloads; 0 keeps it as it is.
##
## Free to edit: this file was copied into your project and is yours now.

signal extraction_started(body: Node)
signal extraction_cancelled(body: Node)
signal extracted(body: Node)

@export var extraction_name := "탈출 지점"
@export var extract_time := 5.0
@export var player_group: StringName = &"player"
## Seconds after extracting before the scene reloads; 0 = never.
@export var restart_delay := 4.0

var is_done := false
var _body: Node3D
var _timer := 0.0
var _label: Label3D
var _hud: Label


func _ready() -> void:
	add_to_group(&"extraction")
	_label = get_node_or_null(^"Label") as Label3D
	if Engine.is_editor_hint():
		return
	monitoring = true
	body_entered.connect(_on_body_entered)
	body_exited.connect(_on_body_exited)


func _process(delta: float) -> void:
	if Engine.is_editor_hint() or is_done or _body == null:
		return
	if not is_instance_valid(_body) or not _body.is_inside_tree():
		_body = null
		_show_hud("")
		return
	_timer += delta
	var left := maxf(extract_time - _timer, 0.0)
	_show_hud("%s: %.1f초 뒤 탈출" % [extraction_name, left])
	if _label != null:
		_label.text = "%s\n%.1f" % [extraction_name, left]
	if _timer >= extract_time:
		extract(_body)


## Seconds left for the player inside, or -1 when nobody is extracting.
func time_left() -> float:
	return maxf(extract_time - _timer, 0.0) if _body != null and not is_done else -1.0


## Extracts `body` now.
func extract(body: Node) -> void:
	if is_done:
		return
	is_done = true
	_body = null
	var message := "탈출 성공!"
	var inventory := body.get_node_or_null(^"Inventory") if body != null else null
	if inventory != null and inventory.has_method("get_total_value"):
		message += "\n가져온 물건 가치: %s" % inventory.get_total_value()
	if body != null and body.has_method("on_extracted"):
		body.on_extracted(self)
	extracted.emit(body)
	if body is Node:
		(body as Node).process_mode = Node.PROCESS_MODE_DISABLED
	if _label != null:
		_label.text = "탈출 완료"
	_show_hud(message, true)
	if restart_delay > 0.0 and is_inside_tree():
		await get_tree().create_timer(restart_delay).timeout
		if is_inside_tree():
			get_tree().reload_current_scene()


func _on_body_entered(body: Node) -> void:
	if is_done or _body != null or not body.is_in_group(player_group) or not body is Node3D:
		return
	_body = body
	_timer = 0.0
	extraction_started.emit(body)


func _on_body_exited(body: Node) -> void:
	if body != _body or is_done:
		return
	_body = null
	_show_hud("")
	if _label != null:
		_label.text = extraction_name
	extraction_cancelled.emit(body)


func _show_hud(text: String, big: bool = false) -> void:
	if _hud == null:
		if text.is_empty():
			return
		var layer := CanvasLayer.new()
		layer.layer = 50
		add_child(layer)
		_hud = Label.new()
		_hud.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		_hud.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
		_hud.set_anchors_preset(Control.PRESET_CENTER_TOP)
		_hud.add_theme_color_override("font_outline_color", Color.BLACK)
		_hud.add_theme_constant_override("outline_size", 8)
		layer.add_child(_hud)
	_hud.visible = not text.is_empty()
	_hud.text = text
	_hud.add_theme_font_size_override("font_size", 48 if big else 26)
	_hud.add_theme_color_override("font_color", Color(0.5, 1.0, 0.6) if big else Color(1, 1, 1))
	_hud.set_anchors_preset(Control.PRESET_CENTER if big else Control.PRESET_CENTER_TOP)
	_hud.offset_top = 0.0 if big else 40.0
	_hud.grow_horizontal = Control.GROW_DIRECTION_BOTH
	_hud.grow_vertical = Control.GROW_DIRECTION_BOTH
