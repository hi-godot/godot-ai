extends Node

## Raid autopilot (generated by raid_playtest; registered as an autoload).
##
## Does nothing in normal play. When the raid_playtest tool starts the game it
## leaves a fresh request at user://raid_playtest/request.json; this node
## consumes it, then plays the raid through the game's real input actions:
## it walks the navigation mesh, aims with synthetic mouse motion (the
## player controller reads InputEventMouse positions), fires and reloads,
## presses interact at loot crates, walks over dropped loot, fights enemies it
## sees and finally stands in an extraction zone. Along the way it records
## errors, FPS, combat, loot, stuck spots and screenshots, and writes
## user://raid_playtest/report.json for the editor tool.
##
## With the HideoutState autoload (hideout_scaffold) it also checks the
## loop around the raid, on a separate playtest save: after extracting (or
## dying) it waits for the hideout, checks that the bag reached the stash
## (or was lost) and the save file matches, then moves one stash item into
## the bag, deploys again and checks the raid player got that bag.
##
## Free to edit: this file was copied into your project and is yours now.

const DIR := "user://raid_playtest/"
const REQUEST_PATH := DIR + "request.json"
const REPORT_PATH := DIR + "report.json"
## A request older than this is ignored (a crashed run must not hijack a
## later manual play session).
const MAX_REQUEST_AGE_SEC := 180.0
const VERSION := 1

const DEFAULTS := {
	"token": "",
	"duration": 60.0,
	"time_scale": 1.0,
	"crates": true,
	"loot": true,
	"fight": true,
	"hunt": false,
	"extract": true,
	"explore": false,
	"max_crates": -1,
	"engage_range": 14.0,
	"loot_radius": 10.0,
	"invulnerable": false,
	"stuck_time": 2.0,
	"min_fps": 30.0,
	"screenshots": true,
	"screenshot_interval": 0.0,
	"max_screenshots": 8,
	"show_hud": true,
	"quit_on_finish": true,
	"seed": 1,
	"hideout_loop": true,
	"redeploy": true,
	"hideout_timeout": 20.0,
}

## Collects engine errors/warnings while the bot runs. Logger virtuals can be
## called from any thread, so everything goes through a mutex.
class ErrorCatcher extends Logger:
	var mutex := Mutex.new()
	var errors: Array = []
	var warnings: Array = []
	var printerr_lines: Array = []
	var error_count := 0
	var warning_count := 0

	func _log_message(message: String, error: bool) -> void:
		if not error:
			return
		mutex.lock()
		if printerr_lines.size() < 20:
			printerr_lines.append(message.strip_edges())
		mutex.unlock()

	func _log_error(
		function: String,
		file: String,
		line: int,
		code: String,
		rationale: String,
		_editor_notify: bool,
		error_type: int,
		_script_backtraces: Array,
	) -> void:
		var message := rationale if not rationale.is_empty() else code
		var where := "%s:%d" % [file, line] if not file.is_empty() else ""
		if not function.is_empty():
			where += " @ %s" % function
		var text := "%s (%s)" % [message, where] if not where.is_empty() else message
		mutex.lock()
		if error_type == ERROR_TYPE_WARNING:
			warning_count += 1
			if warnings.size() < 20:
				warnings.append(text)
		else:
			error_count += 1
			if errors.size() < 30:
				errors.append(text)
		mutex.unlock()

	func snapshot() -> Dictionary:
		mutex.lock()
		var out := {
			"count": error_count,
			"warning_count": warning_count,
			"messages": errors.duplicate(),
			"warnings": warnings.duplicate(),
			"printerr": printerr_lines.duplicate(),
		}
		mutex.unlock()
		return out


var active := false
var config := {}

