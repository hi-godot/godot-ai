func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	set_process(false)
	set_physics_process(false)
	var request: Variant = read_request()
	if request == null:
		return
	config = merge_config(request)
	_begin()


## Reads and consumes the request file. Returns null when there is none or it
## is stale.
static func read_request() -> Variant:
	if not FileAccess.file_exists(REQUEST_PATH):
		return null
	var text := FileAccess.get_file_as_string(REQUEST_PATH)
	DirAccess.remove_absolute(ProjectSettings.globalize_path(REQUEST_PATH))
	var data: Variant = JSON.parse_string(text)
	if not data is Dictionary:
		return null
	var created := float(data.get("created_unix", 0.0))
	if absf(Time.get_unix_time_from_system() - created) > MAX_REQUEST_AGE_SEC:
		return null
	return data


static func merge_config(request: Dictionary) -> Dictionary:
	var out := DEFAULTS.duplicate(true)
	for key in request:
		out[key] = request[key]
	return out


func _begin() -> void:
	active = true
	_rng.seed = int(config.seed)
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(_shot_dir()))
	_catcher = ErrorCatcher.new()
	OS.add_logger(_catcher)
	Engine.time_scale = clampf(float(config.time_scale), 0.1, 4.0)
	_real_start_usec = Time.get_ticks_usec()
	_last_frame_usec = _real_start_usec
	_second_start_usec = _real_start_usec
	_shot_left = float(config.screenshot_interval)
	if bool(config.show_hud):
		_make_hud()
	get_tree().node_added.connect(_on_node_added)
	## Other autoloads (HideoutState) may be added after this one.
	_link_hideout.call_deferred()
	set_process(true)
	set_physics_process(true)
	_event("start", {})


# --- per frame --------------------------------------------------------------

func _process(_delta: float) -> void:
	if not active:
		return
	var now := Time.get_ticks_usec()
	var ms := float(now - _last_frame_usec) / 1000.0
	_last_frame_usec = now
	## Skip the first second: loading hitches are not gameplay frames.
	if now - _real_start_usec > 1000000:
		if _frame_ms.size() < 60000:
			_frame_ms.append(ms)
		_second_frames += 1
		if now - _second_start_usec >= 1000000:
			_fps_per_second.append(_second_frames)
			_second_frames = 0
			_second_start_usec = now
	else:
		_second_start_usec = now
	if _hud != null:
		_hud.text = _hud_text()


func _physics_process(delta: float) -> void:
	if not active or _done:
		return
	if not _hideout_phase.is_empty():
		_hideout_tick()
		return
	_t += delta
	if not _ensure_player():
		if _t > 5.0:
			_finish("no_player")
		return
	if bool(config.invulnerable) and "health" in _player:
		_player.set("health", maxf(float(_player.get("health")), float(_player.get("max_health")) * 0.5))
	if _player.get("is_dead") == true:
		_end_raid("died")
		return
	if _t >= float(config.duration):
		_finish("timeout")
		return
	_track_motion()
	_maybe_periodic_shot(delta)

	_threat_pick_left -= delta
	if _threat_pick_left <= 0.0:
		_threat_pick_left = 0.1
		_threat = _pick_threat() if bool(config.fight) else null
		if _threat != null and float(_stats.first_contact) < 0.0:
			_stats.first_contact = _t
			_event("contact", {"enemy": str(_threat.name), "position": _arr(_threat.global_position)})
			_shot("first_contact")

	_goal_pick_left -= delta
	if _goal.is_empty() or not _goal_valid(_goal) or _goal_pick_left <= 0.0:
		_goal_pick_left = 1.0
		var next := _pick_goal()
		if not _same_goal(next, _goal):
			_set_goal(next)
	_goal_time += delta

	var move := _steer(delta)
	move = _keep_distance(move)
	_apply_move(move)
	_aim_and_fire(move, delta)


# --- goals ------------------------------------------------------------------

func _pick_goal() -> Dictionary:
	var pos := _player.global_position
	var remaining := float(config.duration) - _t
	var zone := _nearest_in_group(&"extraction", func(n): return n.get("is_done") != true)
	## Leave in time: path length at move speed, the hold time and a margin.
	if bool(config.extract) and zone != null:
		var speed := maxf(float(_player.get("move_speed")) if "move_speed" in _player else 6.0, 1.0)
		var need := _path_length(pos, zone.global_position) / speed + float(zone.get("extract_time") if "extract_time" in zone else 5.0) + 4.0
		if remaining <= need or not _goal.is_empty() and _goal.kind == "extract":
			return _goal_for("extract", zone)
	if bool(config.loot):
		var pickup := _nearest_in_group(&"loot_pickup", func(n): return pos.distance_to(n.global_position) <= float(config.loot_radius))
		if pickup != null:
			return _goal_for("pickup", pickup)
	if bool(config.crates) and (int(config.max_crates) < 0 or int(_stats.crates_opened) < int(config.max_crates)):
		var crate := _nearest_by_path(&"loot_crate", func(n): return n.get("is_open") != true)
		if crate != null:
			return _goal_for("crate", crate)
	if bool(config.hunt) and bool(config.fight):
		var enemy := _nearest_by_path(&"enemy", func(n): return n.get("is_dead") != true)
		if enemy != null:
			return _goal_for("enemy", enemy)
	if bool(config.explore):
		var room := _next_unvisited_room()
		if room != null:
			return _goal_for("room", room)
	if bool(config.extract) and zone != null:
		return _goal_for("extract", zone)
	return {}


func _goal_for(kind: String, node: Node3D) -> Dictionary:
	return {"kind": kind, "node": node, "id": node.get_instance_id(), "name": str(node.name)}


func _same_goal(a: Dictionary, b: Dictionary) -> bool:
	if a.is_empty() or b.is_empty():
		return a.is_empty() and b.is_empty()
	return a.id == b.id


func _goal_valid(goal: Dictionary) -> bool:
	var node: Variant = goal.get("node")
	if node == null or not is_instance_valid(node) or not (node as Node).is_inside_tree():
		return false
	match goal.kind:
		"crate":
			return node.get("is_open") != true
		"enemy":
			return node.get("is_dead") != true
		"extract":
			return node.get("is_done") != true
		"room":
			return not _stats.rooms_visited.has(goal.name)
	return true


func _set_goal(goal: Dictionary) -> void:
	_goal = goal
	_goal_stucks = 0
	_goal_time = 0.0
	_interact_left = 0.0
	_repath_left = 0.0
	_path = PackedVector3Array()
	if not goal.is_empty():
		_event("goal", {"kind": goal.kind, "target": goal.name})


func _skip_goal(reason: String) -> void:
	if _goal.is_empty():
		return
	_skip[_goal.id] = true
	var entry := {"t": snappedf(_t, 0.1), "kind": _goal.kind, "target": _goal.name, "reason": reason, "position": _arr(_player.global_position)}
	_stats.unreachable.append(entry)
	_event("unreachable", entry)
	_set_goal({})
	_goal_pick_left = 0.0


func _nearest_in_group(group: StringName, accept: Callable) -> Node3D:
	var best: Node3D = null
	var best_d := INF
	var pos := _player.global_position
	for node in get_tree().get_nodes_in_group(group):
		var n := node as Node3D
		if n == null or not n.is_inside_tree() or _skip.has(n.get_instance_id()) or not accept.call(n):
			continue
		var d := pos.distance_squared_to(n.global_position)
		if d < best_d:
			best = n
			best_d = d
	return best


func _nearest_by_path(group: StringName, accept: Callable) -> Node3D:
	var best: Node3D = null
	var best_d := INF
	var pos := _player.global_position
	for node in get_tree().get_nodes_in_group(group):
		var n := node as Node3D
		if n == null or not n.is_inside_tree() or _skip.has(n.get_instance_id()) or not accept.call(n):
			continue
		var d := _path_length(pos, n.global_position)
		if d < best_d:
			best = n
			best_d = d
	return best


func _next_unvisited_room() -> Node3D:
	var best: Node3D = null
	var best_d := INF
	for room in _rooms:
		if not is_instance_valid(room) or _stats.rooms_visited.has(str(room.name)) or _skip.has(room.get_instance_id()):
			continue
		var d := _path_length(_player.global_position, room.global_position)
		if d < best_d:
			best = room
			best_d = d
	return best


# --- movement ---------------------------------------------------------------

## World-space direction (XZ, length <= 1) the bot wants to move this tick.
func _steer(delta: float) -> Vector3:
	if _goal.is_empty():
		return Vector3.ZERO
	var node: Node3D = _goal.node
	var pos := _player.global_position
	var target := node.global_position
	var flat := Vector2(target.x - pos.x, target.z - pos.z).length()

	if _unstick_left > 0.0:
		_unstick_left -= delta
		return _unstick_dir

	match _goal.kind:
		"crate":
			var radius := float(node.get("interact_radius")) if "interact_radius" in node else 1.8
			if flat <= radius * 0.8:
				_interact_with_crate(node, delta)
				return Vector3.ZERO
			if _goal_time > 25.0:
				_skip_goal("too_slow")
				return Vector3.ZERO
		"extract":
			if flat <= 0.6:
				_reset_stuck()
				return Vector3.ZERO
		"pickup":
			if flat <= 0.35:
				if _goal_time > 3.0:
					_stats.pickups_refused += 1
					_skip_goal("not_collected")
				return Vector3.ZERO
		"room":
			if flat <= 2.0:
				return Vector3.ZERO
		"enemy":
			if _threat != null and flat <= float(config.engage_range) * 0.7:
				return Vector3.ZERO

	_repath_left -= delta
	if _path.is_empty() or _repath_left <= 0.0:
		_repath_left = 1.0
		_path = _path_to(pos, target)
		_path_index = 0
	while _path_index < _path.size():
		var p := _path[_path_index]
		if Vector2(p.x - pos.x, p.z - pos.z).length() > 0.45:
			break
		_path_index += 1
	var waypoint := target if _path_index >= _path.size() else _path[_path_index]
	var dir := Vector3(waypoint.x - pos.x, 0.0, waypoint.z - pos.z)
	if dir.length_squared() < 0.0001:
		return Vector3.ZERO
	_check_stuck(delta)
	return dir.normalized()


func _check_stuck(delta: float) -> void:
	_stuck_check_left -= delta
	if _stuck_check_left > 0.0:
		return
	var pos := _player.global_position
	var moved := Vector2(pos.x - _stuck_anchor.x, pos.z - _stuck_anchor.z).length()
	var first := _stuck_check_left < -100.0
	_stuck_anchor = pos
	_stuck_check_left = float(config.stuck_time)
	if first or moved > 0.4 or _threat != null:
		return
	_goal_stucks += 1
	var entry := {"t": snappedf(_t, 0.1), "position": _arr(pos), "goal": _goal.kind, "target": _goal.name}
	if _stats.stuck.size() < 40:
		_stats.stuck.append(entry)
	_event("stuck", entry)
	if _stats.stuck.size() == 1:
		_shot("stuck")
	if _goal_stucks >= 3:
		_skip_goal("stuck")
		return
	## Sidestep for a moment, then path again.
	var angle := _rng.randf_range(-PI, PI)
	_unstick_dir = Vector3(cos(angle), 0.0, sin(angle))
	_unstick_left = 0.5
	_repath_left = 0.0
	_tap(_actions.dodge)


func _reset_stuck() -> void:
	_stuck_anchor = _player.global_position
	_stuck_check_left = float(config.stuck_time)


func _interact_with_crate(crate: Node3D, delta: float) -> void:
	_reset_stuck()
	_interact_left -= delta
	if _interact_left > 0.0:
		return
	var search := float(crate.get("search_time")) if "search_time" in crate else 1.0
	if _goal_time > search + 20.0:
		_skip_goal("would_not_open")
		return
	## Re-press only when the crate is idle (pressing again while searching
	## would restart nothing but is noise in the input log).
	if crate.get("_searcher") == null:
		_tap(_actions.interact)
	_interact_left = 0.6


func _path_to(from: Vector3, to: Vector3) -> PackedVector3Array:
	var map := _player.get_world_3d().navigation_map
	if NavigationServer3D.map_get_iteration_id(map) == 0:
		return PackedVector3Array([to])
	var path := NavigationServer3D.map_get_path(map, from, to, true)
	if path.is_empty():
		return PackedVector3Array([to])
	return path


func _path_length(from: Vector3, to: Vector3) -> float:
	var path := _path_to(from, to)
	var total := 0.0
	var prev := from
	for p in path:
		total += Vector2(p.x - prev.x, p.z - prev.z).length()
		prev = p
	return total + Vector2(to.x - prev.x, to.z - prev.z).length()


## Presses the move actions so the controller's camera-relative input maps
## back to `world_dir`.
func _apply_move(world_dir: Vector3) -> void:
	var input := input_for_direction(world_dir, _camera_basis())
	_set_action(_actions.left, maxf(-input.x, 0.0))
	_set_action(_actions.right, maxf(input.x, 0.0))
	_set_action(_actions.forward, maxf(-input.y, 0.0))
	_set_action(_actions.back, maxf(input.y, 0.0))


## Inverse of the player controller's _camera_relative(): the input vector
## (x right, y back, like Input.get_vector) that moves along `world_dir` for a
## camera with basis `cam`.
static func input_for_direction(world_dir: Vector3, cam: Basis) -> Vector2:
	var dir := Vector3(world_dir.x, 0.0, world_dir.z)
	if dir.length_squared() < 0.0001:
		return Vector2.ZERO
	var forward := -cam.z
	forward.y = 0.0
	var right := cam.x
	right.y = 0.0
	if forward.length_squared() < 0.0001 or right.length_squared() < 0.0001:
		return Vector2(dir.x, dir.z).limit_length(1.0)
	forward = forward.normalized()
	right = right.normalized()
	var x := dir.dot(right)
	var y := -dir.dot(forward)
	return Vector2(x, y).normalized() * minf(dir.length(), 1.0)


func _camera_basis() -> Basis:
	var cam := get_viewport().get_camera_3d()
	return cam.global_basis if cam != null else Basis.IDENTITY


# --- combat -----------------------------------------------------------------

## Backs away from an enemy that gets too close (point-blank shots can start
## inside its body and miss, and melee enemies hit hardest up close).
func _keep_distance(move: Vector3) -> Vector3:
	if _threat == null or not is_instance_valid(_threat):
		return move
	var away := _player.global_position - _threat.global_position
	away.y = 0.0
	if away.length() >= KEEP_DISTANCE or away.length_squared() < 0.0001:
		return move
	## Mostly away, plus a little sideways so walls behind do not pin us.
	var side := Vector3(-away.z, 0.0, away.x).normalized() * (0.5 if _rng.randf() < 0.5 else -0.5)
	return (away.normalized() + side).normalized()


func _pick_threat() -> Node3D:
	var best: Node3D = null
	var best_d := INF
	var range_limit := float(config.engage_range)
	if _weapon != null and "data" in _weapon and _weapon.data != null and "range" in _weapon.data:
		range_limit = minf(range_limit, float(_weapon.data.range))
	## Being shot at: look for the shooter farther away.
	if _t - _hurt_at < ALERT_TIME:
		range_limit *= 2.0
	var eye := _player.global_position + Vector3.UP * _aim_height()
	for node in get_tree().get_nodes_in_group(&"enemy"):
		var e := node as Node3D
		if e == null or not e.is_inside_tree() or e.get("is_dead") == true:
			continue
		var d := eye.distance_to(e.global_position)
		if d > range_limit or d >= best_d:
			continue
		if not _line_clear(eye, e.global_position + Vector3.UP * _aim_height(), e):
			continue
		best = e
		best_d = d
	return best


func _line_clear(from: Vector3, to: Vector3, target: Node) -> bool:
	var query := PhysicsRayQueryParameters3D.create(from, to)
	query.exclude = [(_player as CollisionObject3D).get_rid()] if _player is CollisionObject3D else []
	var hit := _player.get_world_3d().direct_space_state.intersect_ray(query)
	if hit.is_empty():
		return true
	var collider: Variant = hit.get("collider")
	return collider == target or (collider is Node and target.is_ancestor_of(collider))


func _aim_and_fire(move: Vector3, delta: float) -> void:
	var point: Vector3
	if _threat != null and is_instance_valid(_threat):
		point = _threat.global_position + Vector3.UP * _aim_height()
	elif move != Vector3.ZERO:
		point = _player.global_position + move * 4.0 + Vector3.UP * _aim_height()
	elif not _goal.is_empty():
		point = (_goal.node as Node3D).global_position + Vector3.UP * _aim_height()
	else:
		point = _player.global_position - _player.global_basis.z * 4.0
	_aim_at(point)

	_reload_tap_left -= delta
	if _weapon == null:
		_set_action(_actions.fire, 0.0)
		return
	var empty: bool = "ammo" in _weapon and int(_weapon.get("ammo")) <= 0
	var reloading: bool = _weapon.has_method("is_reloading") and _weapon.is_reloading()
	if empty and not reloading and _reload_tap_left <= 0.0:
		_reload_tap_left = 0.5
		_tap(_actions.reload)
	var aimed := _threat != null and _aim_settled(point)
	if not aimed or empty or reloading:
		_set_action(_actions.fire, 0.0)
		return
	var automatic: bool = _weapon.has_method("is_automatic") and _weapon.is_automatic()
	if automatic:
		_set_action(_actions.fire, 1.0)
	else:
		_fire_toggle = not _fire_toggle
		_set_action(_actions.fire, 1.0 if _fire_toggle else 0.0)


## True when the player's aim pivot already faces `point` (within ~12°).
func _aim_settled(point: Vector3) -> bool:
	var pivot := _player.get_node_or_null(^"Aim") as Node3D
	if pivot == null:
		return true
	var to := point - _player.global_position
	to.y = 0.0
	var facing := -pivot.global_basis.z
	facing.y = 0.0
	if to.length_squared() < 0.01 or facing.length_squared() < 0.01:
		return true
	return facing.normalized().dot(to.normalized()) > 0.978


func _aim_at(world_point: Vector3) -> void:
	var cam := get_viewport().get_camera_3d()
	if cam == null or cam.is_position_behind(world_point):
		return
	var screen := cam.unproject_position(world_point)
	## unproject_position is in viewport pixels; events arrive in window
	## pixels and the viewport applies its stretch transform to them.
	var window_pos: Vector2 = get_viewport().get_final_transform() * screen
	var motion := InputEventMouseMotion.new()
	motion.position = window_pos
	motion.global_position = window_pos
	motion.relative = window_pos - _aim_screen
	_aim_screen = window_pos
	Input.parse_input_event(motion)


func _aim_height() -> float:
	return float(_player.get("aim_height")) if "aim_height" in _player else 1.2


# --- input ------------------------------------------------------------------

func _resolve_actions() -> void:
	var names := {
		"left": "action_move_left", "right": "action_move_right",
		"forward": "action_move_forward", "back": "action_move_back",
		"dodge": "action_dodge", "fire": "action_fire", "reload": "action_reload",
	}
	var fallback := {
		"left": &"move_left", "right": &"move_right", "forward": &"move_forward",
		"back": &"move_back", "dodge": &"dodge", "fire": &"fire", "reload": &"reload",
	}
	for key in names:
		var value: Variant = _player.get(names[key]) if names[key] in _player else null
		_actions[key] = StringName(value) if value != null else fallback[key]
	var interact: StringName = &"interact"
	var crates := get_tree().get_nodes_in_group(&"loot_crate")
	if not crates.is_empty() and "interact_action" in crates[0]:
		interact = crates[0].get("interact_action")
	_actions["interact"] = interact


func _set_action(action: StringName, strength: float) -> void:
	if not InputMap.has_action(action):
		return
	if strength > 0.0:
		Input.action_press(action, strength)
		_held[action] = true
	elif _held.has(action):
		Input.action_release(action)
		_held.erase(action)


## Press + release as an InputEventAction so _unhandled_input handlers (the
## crate's interact) see it too.
func _tap(action: StringName) -> void:
	if not InputMap.has_action(action):
		return
	var press := InputEventAction.new()
	press.action = action
	press.pressed = true
	press.strength = 1.0
	Input.parse_input_event(press)
	await get_tree().physics_frame
	await get_tree().physics_frame
	var release := InputEventAction.new()
	release.action = action
	release.pressed = false
	Input.parse_input_event(release)


func _release_all() -> void:
	for action in _held.keys():
		Input.action_release(action)
	_held.clear()


# --- tracking ---------------------------------------------------------------

func _ensure_player() -> bool:
	if _player != null and is_instance_valid(_player) and _player.is_inside_tree():
		if _weapon == null or not is_instance_valid(_weapon):
			_weapon = _player.get_weapon() if _player.has_method("get_weapon") else null
			_connect_weapon()
		return true
	_player = null
	for node in get_tree().get_nodes_in_group(&"player"):
		if node is Node3D:
			_player = node
			break
	if _player == null:
		return false
	var scene := get_tree().current_scene
	_scene_path = scene.scene_file_path if scene != null else ""
	_resolve_actions()
	_stats.start = _player.global_position
	_last_pos = _player.global_position
	_stuck_anchor = _last_pos
	_stuck_check_left = -1000.0
	_stats.health_start = float(_player.get("health")) if "health" in _player else 0.0
	_last_health = _stats.health_start
	if _player.has_signal(&"health_changed"):
		_player.connect(&"health_changed", _on_player_health)
	_inventory = _player.get_node_or_null(^"Inventory")
	if _inventory != null and _inventory.has_signal(&"item_added"):
		_inventory.connect(&"item_added", _on_item_added)
	_weapon = _player.get_weapon() if _player.has_method("get_weapon") else null
	_connect_weapon()
	for node in get_tree().get_nodes_in_group(&"loot_crate"):
		_watch(node)
	for node in get_tree().get_nodes_in_group(&"enemy"):
		_watch(node)
	for node in get_tree().get_nodes_in_group(&"extraction"):
		_watch(node)
	for node in get_tree().get_nodes_in_group(&"loot_pickup"):
		_watch(node)
	_rooms = []
	for node in get_tree().get_nodes_in_group(&"raid_room"):
		if node is Node3D:
			_rooms.append(node)
	_crates_total = get_tree().get_nodes_in_group(&"loot_crate").size()
	_enemies_total = get_tree().get_nodes_in_group(&"enemy").size()
	_zones_total = get_tree().get_nodes_in_group(&"extraction").size()
	_event("player_found", {"player": str(_player.name), "position": _arr(_player.global_position), "weapon": str(_weapon.name) if _weapon != null else ""})
	_shot("start")
	return true


func _connect_weapon() -> void:
	if _weapon == null or _connected.has(_weapon.get_instance_id()):
		return
	_connected[_weapon.get_instance_id()] = true
	if _weapon.has_signal(&"fired"):
		_weapon.connect(&"fired", _on_weapon_fired)
	if _weapon.has_signal(&"hit"):
		_weapon.connect(&"hit", _on_weapon_hit)


func _on_node_added(node: Node) -> void:
	if active and not _done:
		_watch.call_deferred(node)


func _watch(node: Node) -> void:
	if node == null or not is_instance_valid(node) or _connected.has(node.get_instance_id()):
		return
	if node.is_in_group(&"enemy") and node.has_signal(&"died"):
		_connected[node.get_instance_id()] = true
		node.connect(&"died", _on_enemy_died.bind(node))
	elif node.is_in_group(&"loot_crate") and node.has_signal(&"opened"):
		_connected[node.get_instance_id()] = true
		node.connect(&"opened", _on_crate_opened.bind(node))
	elif node.is_in_group(&"extraction") and node.has_signal(&"extracted"):
		_connected[node.get_instance_id()] = true
		node.connect(&"extracted", _on_extracted.bind(node))
		if node.has_signal(&"extraction_started"):
			node.connect(&"extraction_started", _on_extraction_started)
	elif node.is_in_group(&"loot_pickup") and node.has_signal(&"picked_up") and _inventory == null:
		_connected[node.get_instance_id()] = true
		node.connect(&"picked_up", _on_pickup_picked)


func _track_motion() -> void:
	var pos := _player.global_position
	_stats.distance += Vector2(pos.x - _last_pos.x, pos.z - _last_pos.z).length()
	_last_pos = pos
	for room in _rooms:
		if not is_instance_valid(room) or _stats.rooms_visited.has(str(room.name)):
			continue
		var size: Vector2 = room.get_meta(&"size", Vector2(6, 6))
		var local := Vector2(pos.x - room.global_position.x, pos.z - room.global_position.z)
		if absf(local.x) <= size.x * 0.5 - 0.5 and absf(local.y) <= size.y * 0.5 - 0.5:
			_stats.rooms_visited[str(room.name)] = snappedf(_t, 0.1)


func _on_player_health(current: float, _maximum: float) -> void:
	if _last_health >= 0.0 and current < _last_health:
		_stats.damage_taken += _last_health - current
		_hurt_at = _t
		_event("hurt", {"health": snappedf(current, 0.1)})
	_last_health = current


func _on_weapon_fired(_ammo_left: int) -> void:
	_stats.shots += 1


func _on_extraction_started(_body: Node) -> void:
	if float(_stats.extraction_started) < 0.0:
		_stats.extraction_started = _t
		_event("extraction_started", {})


func _on_pickup_picked(_collector: Node, item_id: String, count: int) -> void:
	_count_item(item_id, count)


func _on_weapon_hit(target: Node, _position: Vector3, damage: float) -> void:
	if target != null and target.is_in_group(&"enemy"):
		_stats.hits += 1
		_stats.damage_dealt += damage


func _on_enemy_died(enemy: Node) -> void:
	_stats.kills += 1
	_event("kill", {"enemy": str(enemy.name)})


func _on_crate_opened(_by: Node, crate: Node) -> void:
	_stats.crates_opened += 1
	_event("crate_opened", {"crate": str(crate.name)})
	if int(_stats.crates_opened) == 1:
		_shot("first_crate")


func _on_item_added(item: Resource, count: int) -> void:
	var id := ""
	if _inventory != null and _inventory.has_method("item_id_of"):
		id = str(_inventory.item_id_of(item))
	if id.is_empty() and item != null:
		id = str(item.get("item_id")) if "item_id" in item else item.resource_path.get_file().get_basename()
	_count_item(id, count)


func _count_item(id: String, count: int) -> void:
	_stats.items_picked += count
	_stats.items[id] = int(_stats.items.get(id, 0)) + count
	_event("pickup", {"item": id, "count": count})


func _on_extracted(_body: Node, zone: Node) -> void:
	_stats.extracted_at = _t
	_event("extracted", {"zone": str(zone.name)})
	_end_raid("extracted")


# --- hideout loop -------------------------------------------------------------

func _link_hideout() -> void:
	if not bool(config.get("hideout_loop", true)):
		return
	_hideout_state = get_node_or_null(^"/root/HideoutState")
	if _hideout_state == null or not _hideout_state.has_method(&"enter_hideout"):
		_hideout_state = null
		return
	if _hideout_state.has_method(&"use_sandbox"):
		_hideout_state.use_sandbox()
	_counts_before = _sum_counts([_hideout_state.stash, _hideout_state.loadout, _hideout_state.overflow])
	_hideout_report = {
		"linked": true,
		"save_path": ProjectSettings.globalize_path(str(_hideout_state.save_path)),
		"sandbox": bool(_hideout_state.get("sandbox")),
		"hideout_scene": str(_hideout_state.hideout_scene),
		"items_before": _counts_before,
		"returned": false,
	}
	_hideout_state.hideout_ready.connect(_on_hideout_ready)
	_hideout_state.raid_started.connect(_on_raid_restarted)


## The raid is over (extracted or died). With a linked HideoutState, wait for
## the hideout before reporting; else report now.
func _end_raid(result: String) -> void:
	if _done or not _hideout_phase.is_empty():
		return
	_end_snap = _snapshot_player()
	if _hideout_state == null or not is_instance_valid(_hideout_state) or str(_hideout_state.hideout_scene).is_empty():
		_finish(result)
		return
	_release_all()
	_end_result = result
	_bag_counts = _hideout_state.count_items(_inventory.to_data()) if _inventory != null and is_instance_valid(_inventory) and _inventory.has_method("to_data") else {}
	_hideout_report["raid_result"] = result
	_hideout_report["bag"] = _bag_counts
	_hideout_phase = "returning"
	_phase_msec = Time.get_ticks_msec()
	_event("raid_end", {"result": result})


func _hideout_tick() -> void:
	if float(Time.get_ticks_msec() - _phase_msec) / 1000.0 > float(config.get("hideout_timeout", 20.0)):
		_hideout_report["error"] = "timeout while %s" % _hideout_phase
		_finish(_end_result)


func _on_hideout_ready(hideout: Node, summary: Dictionary) -> void:
	if _hideout_phase != "returning" or _done:
		return
	var stash_inv: Node = hideout.get("stash")
	var bag_inv: Node = hideout.get("loadout")
	_hideout_report["returned"] = true
	_hideout_report["seconds_to_hideout"] = snappedf(float(Time.get_ticks_msec() - _phase_msec) / 1000.0, 0.1)
	_hideout_report["moved_to_stash"] = summary.get("moved", {})
	_hideout_report["left_in_bag"] = summary.get("left_in_bag", {})
	var after := _sum_counts([stash_inv.to_data(), bag_inv.to_data(), _hideout_state.overflow])
	var expected := _counts_before.duplicate()
	if _end_result == "extracted":
		for id in _bag_counts:
			expected[id] = int(expected.get(id, 0)) + int(_bag_counts[id])
	var missing := {}
	var extra := {}
	for id in expected:
		var d := int(expected[id]) - int(after.get(id, 0))
		if d > 0:
			missing[id] = d
	for id in after:
		var d := int(after[id]) - int(expected.get(id, 0))
		if d > 0:
			extra[id] = d
	_hideout_report["items_after"] = after
	_hideout_report["missing"] = missing
	_hideout_report["unexpected"] = extra
	_hideout_report["stash_value"] = int(stash_inv.get_total_value())
	## The save on disk must hold what the hideout shows.
	var saved: Variant = JSON.parse_string(FileAccess.get_file_as_string(str(_hideout_state.save_path)))
	var saved_counts := _sum_counts([saved.get("stash", []), saved.get("loadout", []), saved.get("overflow", [])]) if saved is Dictionary else {}
	_hideout_report["save_matches"] = saved is Dictionary and saved_counts == after
	_shot("hideout")
	if not bool(config.get("redeploy", true)) or not hideout.has_method(&"deploy"):
		_finish(_end_result)
		return
	## Pack one stash item and go again.
	var redeploy := {"ok": false}
	if not stash_inv.entries.is_empty():
		var id: String = stash_inv.item_id_of(stash_inv.entries[0].item)
		var moved: int = _hideout_state.transfer(stash_inv, 0, bag_inv)
		redeploy["packed"] = {id: moved}
	_redeploy_expected = _hideout_state.count_items(bag_inv.to_data())
	redeploy["expected_bag"] = _redeploy_expected
	_hideout_report["redeploy"] = redeploy
	_hideout_phase = "redeploying"
	_phase_msec = Time.get_ticks_msec()
	var err: int = hideout.deploy()
	if err != OK:
		redeploy["error"] = error_string(err)
		_finish(_end_result)


func _on_raid_restarted(from_hideout: bool) -> void:
	if _hideout_phase != "redeploying" or _done:
		return
	var redeploy: Dictionary = _hideout_report.get("redeploy", {})
	var player := get_tree().get_first_node_in_group(&"player")
	var bag: Node = player.get_node_or_null(^"Inventory") if player != null else null
	var got: Dictionary = _hideout_state.count_items(bag.to_data()) if bag != null else {}
	redeploy["bag"] = got
	redeploy["scene"] = get_tree().current_scene.scene_file_path if get_tree().current_scene != null else ""
	redeploy["seconds"] = snappedf(float(Time.get_ticks_msec() - _phase_msec) / 1000.0, 0.1)
	redeploy["ok"] = from_hideout and bag != null and got == _redeploy_expected
	_shot("redeploy")
	_finish(_end_result)


static func _sum_counts(lists: Array) -> Dictionary:
	var out := {}
	for list in lists:
		if not list is Array:
			continue
		for d in list:
			if d is Dictionary:
				var id := str(d.get("item_id", ""))
				out[id] = int(out.get(id, 0)) + int(d.get("count", 0))
	return out


func _snapshot_player() -> Dictionary:
	var snap := {}
	if _player != null and is_instance_valid(_player):
		snap["pos"] = _player.global_position
		snap["health"] = float(_player.get("health")) if "health" in _player else 0.0
		snap["nav_ready"] = NavigationServer3D.map_get_iteration_id(_player.get_world_3d().navigation_map) > 0
	if _inventory != null and is_instance_valid(_inventory):
		if _inventory.has_method("get_total_value"):
			snap["inv_value"] = int(_inventory.get_total_value())
		if _inventory.has_method("get_total_weight"):
			snap["inv_weight"] = snappedf(float(_inventory.get_total_weight()), 0.01)
	return snap


func _event(type: String, data: Dictionary) -> void:
	if _events.size() >= 150:
		return
	var entry := {"t": snappedf(_t, 0.1), "type": type}
	entry.merge(data)
	_events.append(entry)


# --- screenshots + HUD -------------------------------------------------------

func _shot_dir() -> String:
	return DIR + "shots/"


func _maybe_periodic_shot(delta: float) -> void:
	var interval := float(config.screenshot_interval)
	if interval <= 0.0:
		return
	_shot_left -= delta
	if _shot_left <= 0.0:
		_shot_left = interval
		_shot("t%03d" % int(_t))


func _shot(label: String) -> void:
	if not bool(config.screenshots) or _shot_busy or _shots_taken.size() >= int(config.max_screenshots):
		return
	if DisplayServer.get_name() == "headless":
		return
	_shot_busy = true
	await RenderingServer.frame_post_draw
	_shot_busy = false
	var texture := get_viewport().get_texture()
	var image := texture.get_image() if texture != null else null
	if image == null or image.is_empty():
		return
	var path := _shot_dir() + "%s_%02d_%s.png" % [str(config.token).left(8), _shots_taken.size() + 1, label]
	if image.save_png(path) == OK:
		_shots_taken.append(ProjectSettings.globalize_path(path))


func _make_hud() -> void:
	var layer := CanvasLayer.new()
	layer.layer = 99
	add_child(layer)
	_hud = Label.new()
	_hud.position = Vector2(12, 8)
	_hud.add_theme_font_size_override("font_size", 16)
	_hud.add_theme_color_override("font_color", Color(1.0, 0.92, 0.4))
	_hud.add_theme_color_override("font_outline_color", Color.BLACK)
	_hud.add_theme_constant_override("outline_size", 6)
	layer.add_child(_hud)


func _hud_text() -> String:
	var goal := "-" if _goal.is_empty() else "%s %s" % [_goal.kind, _goal.name]
	return "자동 플레이테스트 %.0f / %.0f초\n목표: %s\n상자 %d/%d · 처치 %d/%d · 아이템 %d" % [
		_t, float(config.duration), goal, int(_stats.crates_opened), _crates_total,
		int(_stats.kills), _enemies_total, int(_stats.items_picked),
	]


# --- report -----------------------------------------------------------------

func _finish(result: String) -> void:
	if _done:
		return
	if _end_snap.is_empty():
		_end_snap = _snapshot_player()
	_done = true
	_release_all()
	_event("finish", {"result": result})
	if _hud != null:
		_hud.text = "자동 플레이테스트 끝: %s" % result
	_shot("end")
	if bool(config.screenshots) and DisplayServer.get_name() != "headless":
		await RenderingServer.frame_post_draw
		await RenderingServer.frame_post_draw
	var report := build_report(result)
	_write_report(report)
	if _catcher != null:
		OS.remove_logger(_catcher)
	Engine.time_scale = 1.0
	if bool(config.quit_on_finish):
		await get_tree().create_timer(1.0, true, false, true).timeout
		get_tree().quit()


func build_report(result: String) -> Dictionary:
	## Values from the end of the raid (the scene may have changed since).
	var snap := _end_snap if not _end_snap.is_empty() else _snapshot_player()
	var pos: Vector3 = snap.get("pos", Vector3.ZERO)
	var health_end: float = float(snap.get("health", 0.0))
	var inv_value := int(snap.get("inv_value", 0))
	var inv_weight := float(snap.get("inv_weight", 0.0))
	var real_time := float(Time.get_ticks_usec() - _real_start_usec) / 1000000.0
	var report := {
		"version": VERSION,
		"token": str(config.token),
		"scene": _scene_path,
		"result": result,
		"extracted": result == "extracted",
		"game_time": snappedf(_t, 0.01),
		"real_time": snappedf(real_time, 0.01),
		"time_scale": float(config.time_scale),
		"player": {
			"start": _arr(_stats.start),
			"end": _arr(pos),
			"distance": snappedf(float(_stats.distance), 0.1),
			"health_start": float(_stats.health_start),
			"health_end": health_end,
			"damage_taken": snappedf(float(_stats.damage_taken), 0.1),
			"died": result == "died",
			"invulnerable": bool(config.invulnerable),
		},
		"combat": {
			"weapon": str(_weapon.name) if _weapon != null and is_instance_valid(_weapon) else "",
			"shots": int(_stats.shots),
			"hits": int(_stats.hits),
			"accuracy": snappedf(float(_stats.hits) / float(_stats.shots), 0.01) if int(_stats.shots) > 0 else 0.0,
			"damage_dealt": snappedf(float(_stats.damage_dealt), 0.1),
			"enemies_total": _enemies_total,
			"enemies_killed": int(_stats.kills),
			"first_contact": float(_stats.first_contact),
		},
		"loot": {
			"crates_total": _crates_total,
			"crates_opened": int(_stats.crates_opened),
			"items_picked": int(_stats.items_picked),
			"items": _stats.items,
			"pickups_refused": int(_stats.pickups_refused),
			"inventory_value": inv_value,
			"inventory_weight": inv_weight,
		},
		"extraction": {
			"zones": _zones_total,
			"entered_at": float(_stats.extraction_started),
			"extracted_at": float(_stats.extracted_at),
		},
		"navigation": {
			"nav_ready": bool(snap.get("nav_ready", false)),
			"stuck": _stats.stuck,
			"unreachable": _stats.unreachable,
			"rooms_total": _rooms.size(),
			"rooms_visited": _stats.rooms_visited.size(),
		},
		"performance": performance_summary(_frame_ms, _fps_per_second),
		"errors": _catcher.snapshot() if _catcher != null else {"count": 0, "warning_count": 0, "messages": [], "warnings": [], "printerr": []},
		"events": _events,
		"screenshots": _shots_taken,
		"hideout": _hideout_report if not _hideout_report.is_empty() else {"linked": false},
	}
	report["issues"] = find_issues(report, config)
	return report


static func performance_summary(frame_ms: PackedFloat32Array, per_second: Array) -> Dictionary:
	var out := {
		"frames": frame_ms.size(),
		"fps_avg": 0.0,
		"fps_min": 0.0,
		"fps_1pct_low": 0.0,
		"frame_ms_avg": 0.0,
		"frame_ms_max": 0.0,
		"draw_calls": int(Performance.get_monitor(Performance.RENDER_TOTAL_DRAW_CALLS_IN_FRAME)),
		"objects": int(Performance.get_monitor(Performance.OBJECT_COUNT)),
		"nodes": int(Performance.get_monitor(Performance.OBJECT_NODE_COUNT)),
		"memory_mb": snappedf(Performance.get_monitor(Performance.MEMORY_STATIC) / 1048576.0, 0.1),
	}
	if frame_ms.is_empty():
		return out
	var sorted := frame_ms.duplicate()
	sorted.sort()
	var total := 0.0
	for ms in sorted:
		total += ms
	var avg := total / sorted.size()
	var p99 := sorted[mini(int(sorted.size() * 0.99), sorted.size() - 1)]
	out.frame_ms_avg = snappedf(avg, 0.01)
	out.frame_ms_max = snappedf(sorted[sorted.size() - 1], 0.01)
	out.fps_avg = snappedf(1000.0 / avg, 0.1) if avg > 0.0 else 0.0
	out.fps_1pct_low = snappedf(1000.0 / p99, 0.1) if p99 > 0.0 else 0.0
	if not per_second.is_empty():
		var lowest: int = per_second[0]
		for n in per_second:
			lowest = mini(lowest, int(n))
		out.fps_min = float(lowest)
	else:
		out.fps_min = out.fps_1pct_low
	return out


## Plain-language problems found in a report (Korean, for the user).
static func find_issues(report: Dictionary, cfg: Dictionary) -> Array:
	var issues: Array = []
	var errors: Dictionary = report.get("errors", {})
	if int(errors.get("count", 0)) > 0:
		issues.append("게임 중 오류 %d건 (errors.messages 참고)" % int(errors.count))
	match str(report.get("result", "")):
		"died":
			issues.append("플레이어가 %.0f초에 사망" % float(report.get("game_time", 0.0)))
		"timeout":
			if bool(cfg.get("extract", true)):
				issues.append("제한 시간 안에 탈출하지 못함")
		"no_player":
			issues.append("player 그룹의 플레이어를 찾지 못함")
	var combat: Dictionary = report.get("combat", {})
	if bool(cfg.get("fight", true)) and str(combat.get("weapon", "")).is_empty() and str(report.get("result", "")) != "no_player":
		issues.append("플레이어에게 무기가 없음")
	var nav: Dictionary = report.get("navigation", {})
	if not bool(nav.get("nav_ready", true)):
		issues.append("내비게이션 메시가 없어 직선으로만 이동함")
	var stuck: Array = nav.get("stuck", [])
	if not stuck.is_empty():
		issues.append("%d번 막힘 (navigation.stuck에 위치)" % stuck.size())
	var unreachable: Array = nav.get("unreachable", [])
	for u in unreachable:
		issues.append("%s %s에 가지 못함 (%s)" % [u.get("kind", ""), u.get("target", ""), u.get("reason", "")])
	var loot: Dictionary = report.get("loot", {})
	if int(loot.get("pickups_refused", 0)) > 0:
		issues.append("바닥 아이템 %d개를 줍지 못함 (가방이 가득 찼거나 너무 무거움)" % int(loot.pickups_refused))
	var hideout: Dictionary = report.get("hideout", {})
	if bool(hideout.get("linked", false)) and hideout.has("raid_result"):
		if not bool(hideout.get("returned", false)):
			issues.append("레이드가 끝난 뒤 은신처로 돌아가지 못함 (%s)" % hideout.get("error", "?"))
		else:
			var missing: Dictionary = hideout.get("missing", {})
			if not missing.is_empty():
				issues.append("은신처에 없는 아이템: %s" % ", ".join(missing.keys().map(func(k): return "%s x%d" % [k, int(missing[k])])))
			var unexpected: Dictionary = hideout.get("unexpected", {})
			if not unexpected.is_empty():
				issues.append("은신처에 생긴 예상 밖 아이템 (사망했는데 남았거나 복사됨): %s" % ", ".join(unexpected.keys().map(func(k): return "%s x%d" % [k, int(unexpected[k])])))
			if not bool(hideout.get("save_matches", true)):
				issues.append("세이브 파일 내용이 은신처 창고·가방과 다름")
			var redeploy: Dictionary = hideout.get("redeploy", {})
			if not redeploy.is_empty() and not bool(redeploy.get("ok", false)):
				issues.append("은신처에서 다시 출격했을 때 가방이 그대로 오지 않음 (%s)" % redeploy.get("error", "기대 %s, 실제 %s" % [redeploy.get("expected_bag", {}), redeploy.get("bag", "?")]))
	var perf: Dictionary = report.get("performance", {})
	var min_fps := float(cfg.get("min_fps", 30.0))
	if int(perf.get("frames", 0)) > 0 and float(perf.get("fps_min", 0.0)) < min_fps:
		issues.append("FPS가 %.0f까지 떨어짐 (기준 %.0f)" % [float(perf.fps_min), min_fps])
	return issues


func _write_report(report: Dictionary) -> void:
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(DIR))
	var tmp := DIR + "report.tmp"
	var file := FileAccess.open(tmp, FileAccess.WRITE)
	if file == null:
		push_warning("raid_playtest: cannot write %s" % tmp)
		return
	file.store_string(JSON.stringify(report, "\t"))
	file.close()
	DirAccess.rename_absolute(ProjectSettings.globalize_path(tmp), ProjectSettings.globalize_path(REPORT_PATH))


static func _arr(v: Vector3) -> Array:
	return [snappedf(v.x, 0.01), snappedf(v.y, 0.01), snappedf(v.z, 0.01)]
