extends Resource

## A drop table (generated by loot_table_edit) for an enemy, a crate or any
## other loot source.
##
## Each drop rolls the table `rolls_min`..`rolls_max` times. Every roll picks
## one entry by weight, or nothing with `empty_weight`. Entries marked
## "guaranteed" drop every time on top of the rolls. Rolls that pick the same
## item add up.
##
##     var drops := table.roll()   # [{"item_id": "bandage", "count": 2, "item": <Resource>}]
##
## Entries are dictionaries so they stay editable in the inspector:
##     {"item_id": "bandage", "weight": 10.0, "min": 1, "max": 3, "guaranteed": false}
##
## Free to edit: this file was copied into your project and is yours now.

@export var table_id := ""
## Item database (item_database.tres from item_db_import) used to turn ids
## into item resources.
@export var item_database: Resource
@export_range(0, 100) var rolls_min := 1
@export_range(0, 100) var rolls_max := 1
## Weight of "nothing" on each roll. With entries weighing 30 in total and
## empty_weight 70, a roll drops something 30% of the time.
@export var empty_weight := 0.0
@export var entries: Array[Dictionary] = []


## Rolls the table once. Pass an RNG with a fixed seed for repeatable drops.
func roll(rng: RandomNumberGenerator = null) -> Array[Dictionary]:
	if rng == null:
		rng = RandomNumberGenerator.new()
		rng.randomize()
	var counts := {}
	var order: Array[String] = []
	for entry in entries:
		if entry.get("guaranteed", false):
			_add(counts, order, entry, rng)
	var pool := total_weight()
	var rolls := rng.randi_range(mini(rolls_min, rolls_max), maxi(rolls_min, rolls_max))
	for i in rolls:
		if pool <= 0.0:
			break
		var pick := rng.randf() * pool
		if pick < empty_weight:
			continue
		pick -= empty_weight
		for entry in entries:
			if entry.get("guaranteed", false):
				continue
			var w := float(entry.get("weight", 0.0))
			if w <= 0.0:
				continue
			if pick < w:
				_add(counts, order, entry, rng)
				break
			pick -= w
	var out: Array[Dictionary] = []
	for id in order:
		out.append({"item_id": id, "count": counts[id], "item": get_item(id)})
	return out


## Sum of every weighted entry plus empty_weight.
func total_weight() -> float:
	var total := maxf(empty_weight, 0.0)
	for entry in entries:
		if not entry.get("guaranteed", false):
			total += maxf(float(entry.get("weight", 0.0)), 0.0)
	return total


## item_id -> chance (0..1) that one roll picks it. Guaranteed entries are 1.
func get_roll_chances() -> Dictionary:
	var out := {}
	var pool := total_weight()
	for entry in entries:
		var id := String(entry.get("item_id", ""))
		if entry.get("guaranteed", false):
			out[id] = 1.0
		elif pool > 0.0:
			out[id] = out.get(id, 0.0) + maxf(float(entry.get("weight", 0.0)), 0.0) / pool
	return out


func get_item(item_id: String) -> Resource:
	if item_database != null and item_database.has_method("get_item"):
		return item_database.get_item(item_id)
	return null


func _add(counts: Dictionary, order: Array[String], entry: Dictionary, rng: RandomNumberGenerator) -> void:
	var id := String(entry.get("item_id", ""))
	if id.is_empty():
		return
	var lo := int(entry.get("min", 1))
	var hi := int(entry.get("max", lo))
	var n := rng.randi_range(mini(lo, hi), maxi(lo, hi))
	if n <= 0:
		return
	if not counts.has(id):
		counts[id] = 0
		order.append(id)
	counts[id] += n
