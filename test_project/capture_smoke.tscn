[gd_scene load_steps=2 format=3 uid="uid://c4pturem0k3"]

; CI game-capture smoke-test scene.
;
; Four quadrants and a midgray patch fill the game window so script/ci-game-capture-smoke
; can sample the centre of each quadrant and assert that editor_screenshot
; (source="game") actually returned the game's framebuffer and not the editor
; UI. Midgray also detects missing linear-to-sRGB conversion.
; Do not edit the colors or layout without updating that script.

[ext_resource type="Script" path="res://capture_smoke.gd" id="1"]

[node name="Root" type="Control"]
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1")

