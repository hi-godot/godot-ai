#!/usr/bin/env python3
"""Prepare and run the local interactive self-update smoke harness.

This harness creates a disposable Godot project with a physical
addons/godot_ai directory, patches that fixture only, and stages a signed,
canonical v4 bundle whose exact tree adds hot-reload and topology canaries.
The operator still performs the one step that matters: click Update.
"""

from __future__ import annotations

import argparse
import hashlib
import http.client
import importlib.machinery
import importlib.util
import io
import json
import os
import platform
import re
import shutil
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request
import zipfile
from pathlib import Path, PurePosixPath

# The fixture editor auto-spawns a real MCP server; neither may send
# telemetry from a local smoke run (audit backlog).
os.environ.setdefault("GODOT_AI_DISABLE_TELEMETRY", "true")

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "src"))
from godot_ai import release_verify  # noqa: E402
from godot_ai.transport.capability import CAPABILITY_DIR_ENV, read_capabilities  # noqa: E402

PLUGIN_ROOT = ROOT / "plugin" / "addons" / "godot_ai"
DEFAULT_PROJECT_DIR = Path(tempfile.gettempdir()) / "godot-ai-self-update-smoke"
PROJECT_HEADER = "; Generated by script/local-self-update-smoke."
SMOKE_DIR = "self_update_smoke"
SMOKE_ARCHIVE_NAME = "godot-ai-v4-plugin.zip"
SMOKE_MANIFEST_NAME = "godot-ai-v4-plugin.manifest.json"
SMOKE_SIGNATURE_NAME = "godot-ai-v4-plugin.manifest.sig"
SMOKE_PUBLIC_KEY_NAME = "smoke-release-key.pub.pem"
SMOKE_SOURCE = "0123456789abcdef0123456789abcdef01234567"
SMOKE_STAGED_LOG = "MCP | self-update smoke: staged signed local bundle"
# The lean updater keeps its marker, lock and retained backup beside the live
# tree (docs/self-update.md); nothing of it lives outside the project.
UPDATE_STATE_DIR = "addons/.godot_ai_update"
SMOKE_SWAP_LOG_SUFFIX = "swapped in; restarting the editor"
SMOKE_MIGRATED_LOG = "MCP | client migration completed"
RESTARTED_EDITOR_LOG_NAME = "godot-editor-restarted.log"
RESTARTED_EDITOR_TIMEOUT_SECONDS = 120.0
V3_BRIDGE_RESTART_LOG = "MCP | v3 bridge restarting editor into canonical v4 tree"
FINAL_V3_REF = "v3.2.5"
V3_FALLBACK_NAME = "godot-ai-v3-plugin.zip"
V3_CLICK_LOG = "V3_BRIDGE_TEST | clicked final-v3 Update button"
# The capsule ships the installer and everything it preloads (docs/self-update.md).
CAPSULE_INSTALLER_SCRIPTS = (
    "release_verifier.gd",
    "update_installer.gd",
    "port_resolver.gd",
    "windows_port_reservation.gd",
)
DEFAULT_HTTP_PORT = 18000
DEFAULT_WS_PORT = 19500
SMOKE_TRIGGER_LOG = "MCP | [self-update-smoke vnext _exit_tree]"
STATUS_PATH = "/godot-ai/status"
POST_UPDATE_STATUS_TIMEOUT_SECONDS = 30.0
POST_UPDATE_STATUS_POLL_SECONDS = 0.25
MAX_STATUS_RESPONSE_BYTES = 64 * 1024


class HarnessError(RuntimeError):
    pass


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=(
            "Prepare a disposable Godot project for the interactive "
            "self-update smoke, optionally launch Godot, then verify state "
            "after the editor exits."
        )
    )
    parser.add_argument(
        "--project-dir",
        type=Path,
        default=DEFAULT_PROJECT_DIR,
        help=f"Disposable smoke project path (default: {DEFAULT_PROJECT_DIR})",
    )
    parser.add_argument(
        "--godot",
        default=os.environ.get(
            "GODOT_BIN",
            "/Applications/Godot_mono.app/Contents/MacOS/Godot"
            if platform.system() == "Darwin"
            else "godot",
        ),
        help="Godot executable to launch (default: GODOT_BIN or platform default)",
    )
    parser.add_argument(
        "--base-version",
        default="",
        help="Override the fixture v(N) plugin.cfg version",
    )
    parser.add_argument(
        "--from-v3-tag",
        metavar="TAG",
        help=(
            "Smoke the v3-to-v4 crossing instead: install exact final-v3 from this git tag "
            "(e.g. v3.2.4) with a locally built capsule, then click Update in its dock."
        ),
    )
    parser.add_argument(
        "--base-from-release-tag",
        default="",
        help=(
            "Source v(N) from the signed v4 GitHub release with this tag "
            "(e.g. 'v4.0.0') instead of current source."
        ),
    )
    parser.add_argument(
        "--base-from-zip",
        type=Path,
        default=None,
        help=(
            "Source v(N) from this local godot-ai-v4-plugin.zip (offline alternative "
            "to --base-from-release-tag)."
        ),
    )
    parser.add_argument(
        "--next-version",
        default="",
        help="Override the synthetic v(N+1) plugin.cfg version",
    )
    parser.add_argument(
        "--server-version",
        default="",
        help=("Version stamped into the frozen local v(A) server runtime (default: base version)."),
    )
    parser.add_argument(
        "--next-server-version",
        default="",
        help=("Version stamped into the frozen local v(B) server runtime (default: next version)."),
    )
    parser.add_argument(
        "--http-port",
        type=int,
        default=DEFAULT_HTTP_PORT,
        help=f"Fixture-only MCP HTTP port (default: {DEFAULT_HTTP_PORT})",
    )
    parser.add_argument(
        "--ws-port",
        type=int,
        default=DEFAULT_WS_PORT,
        help=f"Fixture-only MCP websocket port (default: {DEFAULT_WS_PORT})",
    )
    parser.add_argument(
        "--no-launch",
        action="store_true",
        help="Prepare and print instructions without launching Godot",
    )
    parser.add_argument(
        "--force",
        action="store_true",
        help="Replace project-dir even if it is not a prior smoke fixture",
    )
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    try:
        project_dir = args.project_dir.expanduser().resolve()
        if args.from_v3_tag:
            return run_v3_crossing(args, project_dir)
        if args.base_from_release_tag and args.base_from_zip:
            raise HarnessError("Pass at most one of --base-from-release-tag / --base-from-zip")
        base_zip: Path | None = None
        if args.base_from_zip:
            base_zip = args.base_from_zip.expanduser().resolve()
            if not base_zip.is_file():
                raise HarnessError(f"--base-from-zip not found: {base_zip}")
        elif args.base_from_release_tag:
            base_zip = ensure_release_zip_cached(args.base_from_release_tag)
        default_base_version = (
            release_tag_to_version(args.base_from_release_tag)
            if args.base_from_release_tag
            else read_plugin_version(PLUGIN_ROOT / "plugin.cfg")
        )
        base_version = args.base_version or default_base_version
        next_version = args.next_version or read_plugin_version(PLUGIN_ROOT / "plugin.cfg")
        if next_version == base_version:
            next_version = bump_patch_version(base_version)
        for label, value in (("base", base_version), ("next", next_version)):
            if re.fullmatch(r"4\.\d+\.\d+", value) is None:
                raise HarnessError(f"{label} smoke version must be a canonical v4 version")
        server_version = args.server_version or base_version
        next_server_version = args.next_server_version or next_version
        for label, value in (
            ("base server", server_version),
            ("next server", next_server_version),
        ):
            if re.fullmatch(r"4\.\d+\.\d+", value) is None:
                raise HarnessError(f"{label} smoke version must be a canonical v4 version")
        baseline = diagnostic_reports_snapshot()

        prepare_project(
            project_dir=project_dir,
            base_version=base_version,
            next_version=next_version,
            server_version=server_version,
            next_server_version=next_server_version,
            http_port=args.http_port,
            ws_port=args.ws_port,
            force=args.force,
            base_zip=base_zip,
            restart_log=project_dir / ".godot-ai-self-update-smoke" / RESTARTED_EDITOR_LOG_NAME,
        )
        write_baseline(project_dir, baseline)
        print_instructions(
            project_dir,
            args.godot,
            base_version,
            next_version,
            server_version,
            next_server_version,
            baseline,
        )

        if args.no_launch:
            return 0

        return launch_and_verify(
            project_dir,
            args.godot,
            next_version,
            baseline,
            http_port=args.http_port,
            next_server_version=next_server_version,
        )
    except HarnessError as exc:
        print(f"FAIL: {exc}", file=sys.stderr)
        return 1
    except Exception as exc:
        print(f"FAIL: Unexpected {type(exc).__name__}: {exc}", file=sys.stderr)
        return 1


def read_plugin_version(plugin_cfg: Path) -> str:
    match = re.search(r'^version="([^"]+)"$', plugin_cfg.read_text(), re.MULTILINE)
    if not match:
        raise HarnessError(f"Could not read plugin version from {plugin_cfg}")
    return match.group(1)


def release_tag_to_version(tag: str) -> str:
    return tag[1:] if tag.startswith("v") else tag


def ensure_release_zip_cached(tag: str) -> Path:
    if re.fullmatch(r"v4\.\d+\.\d+(?:rc\d+)?", tag) is None:
        raise HarnessError("--base-from-release-tag must be a canonical v4 tag")
    cache_dir = Path(tempfile.gettempdir()) / "godot-ai-self-update-smoke-cache"
    cache_dir.mkdir(parents=True, exist_ok=True)
    zip_path = cache_dir / f"godot-ai-v4-plugin-{tag}.zip"
    if zip_path.is_file() and zip_path.stat().st_size > 0:
        return zip_path
    url = f"https://github.com/hi-godot/godot-ai/releases/download/{tag}/{SMOKE_ARCHIVE_NAME}"
    print(f"Fetching release zip: {url}")
    try:
        with urllib.request.urlopen(url) as resp:
            data = resp.read()
    except Exception as exc:
        raise HarnessError(f"Failed to download {url}: {exc}") from exc
    zip_path.write_bytes(data)
    return zip_path


def extract_release_zip_to_addon(zip_path: Path, addon_dir: Path) -> None:
    if addon_dir.exists():
        shutil.rmtree(addon_dir)
    addon_dir.mkdir(parents=True)
    with zipfile.ZipFile(zip_path) as zf:
        for member in zf.infolist():
            name = member.filename
            if not name.startswith("addons/godot_ai/"):
                continue
            rel = name[len("addons/godot_ai/") :]
            if not rel:
                continue
            ## Directory entries end with "/" and nothing is written for
            ## them — file entries' parent mkdir below covers the tree.
            if member.is_dir():
                continue
            ## Same containment the standalone v4 verifier enforces:
            ## refuse traversal/absolute/backslash entries instead of
            ## writing wherever a hostile zip points (audit backlog).
            segments = rel.split("/")
            if (
                "\\" in rel
                or PurePosixPath(rel).is_absolute()
                or any(seg in ("", ".", "..") for seg in segments)
            ):
                raise RuntimeError(f"unsafe zip entry refused: {name!r}")
            dest = addon_dir / rel
            ## Belt-and-suspenders resolved-path net (mirrors
            ## tests/integration/_self_update_fixture.py).
            if not dest.resolve().is_relative_to(addon_dir.resolve()):
                raise RuntimeError(f"unsafe zip entry refused: {name!r}")
            dest.parent.mkdir(parents=True, exist_ok=True)
            with zf.open(member) as src, open(dest, "wb") as out:
                shutil.copyfileobj(src, out)
    if not (addon_dir / "plugin.cfg").is_file():
        raise HarnessError(f"Extracted zip {zip_path} did not contain addons/godot_ai/plugin.cfg")


def bump_patch_version(version: str) -> str:
    match = re.match(r"^(\d+)\.(\d+)\.(\d+)", version)
    if not match:
        return f"{version}-self-update-smoke"
    major, minor, patch = (int(part) for part in match.groups())
    return f"{major}.{minor}.{patch + 1}"


def fixture_environment_paths(project_dir: Path) -> dict[str, Path]:
    root = project_dir / ".godot-ai-self-update-smoke" / "client-environment"
    local_app_data = root / "local-app-data"
    capability_dir = (
        local_app_data / "godot-ai" / "capabilities" if os.name == "nt" else root / "capabilities"
    )
    return {
        "home": root / "home",
        "codex_home": root / "codex",
        "xdg_config_home": root / "xdg-config",
        "local_app_data": local_app_data,
        "capability_dir": capability_dir,
        "client_command": root / "client-command-disabled.txt",
    }


def smoke_client_args(version: str, http_port: int, ws_port: int) -> list[str]:
    return [
        "--from",
        f"godot-ai=={version}",
        "godot-ai",
        "attach",
        "--port",
        str(http_port),
        "--ws-port",
        str(ws_port),
    ]


def prepare_isolated_client_environment(
    project_dir: Path, *, base_version: str, http_port: int, ws_port: int
) -> Path:
    """Seed one disposable Codex entry and a command that cannot execute."""

    paths = fixture_environment_paths(project_dir)
    paths["home"].parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    paths["home"].parent.chmod(0o700)
    for key in ("home", "codex_home", "xdg_config_home", "capability_dir"):
        paths[key].mkdir(mode=0o700, parents=True, exist_ok=True)
    paths["client_command"].write_text(
        "Fixture sentinel: client launch is disabled for the self-update smoke.\n",
        encoding="utf-8",
    )
    paths["client_command"].chmod(0o600)
    encoded_args = ", ".join(
        json.dumps(value) for value in smoke_client_args(base_version, http_port, ws_port)
    )
    config = paths["codex_home"] / "config.toml"
    config.write_text(
        (
            '[mcp_servers."godot-ai"]\n'
            f"command = {json.dumps(str(paths['client_command']))}\n"
            f"args = [{encoded_args}]\n"
            "enabled = true\n"
            "startup_timeout_sec = 60\n"
            "tool_timeout_sec = 360\n"
        ),
        encoding="utf-8",
    )
    config.chmod(0o600)
    return paths["client_command"]


def godot_child_environment(project_dir: Path) -> dict[str, str]:
    paths = fixture_environment_paths(project_dir)
    environment = {
        "HOME": str(paths["home"]),
        "USERPROFILE": str(paths["home"]),
        "CODEX_HOME": str(paths["codex_home"]),
        "XDG_CONFIG_HOME": str(paths["xdg_config_home"]),
        "GODOT_AI_DISABLE_TELEMETRY": "true",
        "GODOT_AI_MODE": "user",
    }
    if os.name == "nt":
        environment["LOCALAPPDATA"] = str(paths["local_app_data"])
    else:
        environment[CAPABILITY_DIR_ENV] = str(paths["capability_dir"])
    return environment


def prepare_project(
    *,
    project_dir: Path,
    base_version: str,
    next_version: str,
    server_version: str,
    next_server_version: str,
    http_port: int,
    ws_port: int,
    force: bool,
    base_zip: Path | None = None,
    isolate_client_migration: bool = True,
    restart_log: Path | None = None,
) -> None:
    ensure_safe_project_dir(project_dir, force)
    project_dir.mkdir(parents=True)
    marker_dir = project_dir / ".godot-ai-self-update-smoke"
    marker_dir.mkdir()
    (marker_dir / "marker.txt").write_text(
        "Generated by script/local-self-update-smoke. Safe to delete.\n",
        encoding="utf-8",
    )

    write_project_files(project_dir)
    base_server, _base_runtime = prepare_local_server_runtime(
        marker_dir, "server-a", server_version
    )
    next_server, _next_runtime = prepare_local_server_runtime(
        marker_dir, "server-b", next_server_version
    )
    # Both signed trees intentionally use one stable command, just as the
    # installed plugin keeps invoking uvx while selecting its exact package
    # pin from the current plugin.cfg. Godot may retain a same-path script
    # resource during an in-editor swap; baking different A/B paths directly
    # into that resource would make the fixture stricter in the wrong place.
    server_selector = prepare_server_selector(
        marker_dir,
        project_dir / "addons" / "godot_ai" / "plugin.cfg",
        {
            base_version: base_server,
            next_version: next_server,
        },
    )
    private_key, public_key = prepare_smoke_signing_key(marker_dir)
    client_launch_command = (
        prepare_isolated_client_environment(
            project_dir,
            base_version=base_version,
            http_port=http_port,
            ws_port=ws_port,
        )
        if isolate_client_migration
        else None
    )

    base_addon = project_dir / "addons" / "godot_ai"
    if base_zip is not None:
        extract_release_zip_to_addon(base_zip, base_addon)
    else:
        shutil.copytree(PLUGIN_ROOT, base_addon, ignore=copy_ignore)
    patch_fixture_plugin(
        base_addon,
        version=base_version,
        server_version=server_version,
        http_port=http_port,
        ws_port=ws_port,
        force_local_update=True,
        next_version=next_version,
        server_command=server_selector,
        isolate_client_migration=isolate_client_migration,
        client_launch_command=client_launch_command,
    )
    patch_release_signing_key(base_addon / "utils" / "update_manager.gd", public_key)
    if restart_log is not None:
        patch_restart_log(base_addon / "utils" / "update_installer.gd", restart_log)

    vnext_root = project_dir / ".godot-ai-self-update-smoke" / "vnext" / "addons" / "godot_ai"
    shutil.copytree(PLUGIN_ROOT, vnext_root, ignore=copy_ignore)
    patch_fixture_plugin(
        vnext_root,
        version=next_version,
        server_version=next_server_version,
        http_port=http_port,
        ws_port=ws_port,
        force_local_update=False,
        next_version=next_version,
        server_command=server_selector,
        isolate_client_migration=isolate_client_migration,
        client_launch_command=client_launch_command,
    )
    patch_vnext_hot_reload_trigger(vnext_root / "mcp_dock.gd")
    patch_vnext_topology_change(vnext_root)

    bundle_dir = project_dir / SMOKE_DIR
    bundle_dir.mkdir()
    create_signed_v4_bundle(vnext_root, bundle_dir, next_version, private_key, public_key)
    private_key.unlink()


def ensure_safe_project_dir(project_dir: Path, force: bool) -> None:
    if not project_dir.exists():
        return
    if project_dir.is_symlink():
        raise HarnessError(f"Refusing to remove symlinked project dir: {project_dir}")
    marker = project_dir / ".godot-ai-self-update-smoke" / "marker.txt"
    generated = marker.exists() and is_generated_smoke_project(project_dir)
    if marker.exists() and not generated and not force:
        raise HarnessError(
            f"{project_dir} has a smoke marker but does not look generated. "
            "Pass --project-dir elsewhere or --force."
        )
    if force or generated:
        shutil.rmtree(project_dir)
        return
    raise HarnessError(
        f"{project_dir} already exists and is not marked as a smoke fixture. "
        "Pass --project-dir elsewhere or --force."
    )


def is_generated_smoke_project(project_dir: Path) -> bool:
    project_file = project_dir / "project.godot"
    if not project_file.is_file():
        return False
    try:
        return project_file.read_text(encoding="utf-8").startswith(PROJECT_HEADER)
    except OSError:
        return False


def copy_ignore(_dir: str, names: list[str]) -> set[str]:
    return {
        name
        for name in names
        if name in {".godot", ".import"}
        or name.endswith(".tmp")
        or name.endswith(".bak")
        or name.startswith("godot_ai.backup.")
    }


def write_project_files(project_dir: Path) -> None:
    (project_dir / "project.godot").write_text(
        f"""{PROJECT_HEADER}
config_version=5

[application]
config/name="Godot AI Self Update Smoke"
run/main_scene="res://empty.tscn"
config/features=PackedStringArray("4.7")

[editor_plugins]
enabled=PackedStringArray("res://addons/godot_ai/plugin.cfg")
""",
        encoding="utf-8",
    )
    (project_dir / "empty.tscn").write_text(
        """[gd_scene format=3]

[node name="Main" type="Node3D"]
""",
        encoding="utf-8",
    )


def patch_fixture_plugin(
    addon_dir: Path,
    *,
    version: str,
    server_version: str,
    http_port: int,
    ws_port: int,
    force_local_update: bool,
    next_version: str,
    server_command: list[str],
    isolate_client_migration: bool = False,
    skip_client_prewarm: bool = True,
    client_launch_command: Path | None = None,
) -> None:
    _require_v4_addon_shape(addon_dir, version)
    patch_plugin_cfg(addon_dir / "plugin.cfg", version)
    patch_port_isolation(
        addon_dir / "client_configurator.gd",
        addon_dir / "utils" / "settings.gd",
        http_port,
        ws_port,
    )
    patch_server_command(addon_dir / "client_configurator.gd", server_command)
    patch_expected_server_version(addon_dir / "plugin.gd", server_version)
    if isolate_client_migration:
        patch_client_migration_fixture(
            addon_dir / "client_configurator.gd", skip_prewarm=skip_client_prewarm
        )
    if client_launch_command is not None:
        patch_isolated_client_launch(addon_dir / "client_configurator.gd", client_launch_command)
    if force_local_update:
        # Update flow lives on McpUpdateManager; the dock keeps only
        # the visible banner UI.
        patch_local_update_banner(addon_dir / "utils" / "update_manager.gd", next_version)


def patch_client_migration_fixture(path: Path, *, skip_prewarm: bool = True) -> None:
    """Use one command-shaped client, optionally without package prewarm."""

    text = path.read_text(encoding="utf-8")
    text = replace_function(
        text,
        "static func client_ids() -> PackedStringArray:",
        """static func client_ids() -> PackedStringArray:
\treturn PackedStringArray(["codex"])""",
    )
    if skip_prewarm:
        text = replace_function(
            text,
            "static func prewarm_server_package_blocking(",
            """static func prewarm_server_package_blocking(
\t_version: String,
\t_timeout_ms: int = PREWARM_TIMEOUT_MS,
\t_cancel_check: Callable = Callable(),
) -> Dictionary:
\treturn {"skipped": true, "reason": "frozen self-update fixture runtime"}""",
        )
    path.write_text(text, encoding="utf-8")


def patch_isolated_client_launch(path: Path, command: Path) -> None:
    """Resolve only the fixture command; never discover or execute user tooling."""

    text = replace_function(
        path.read_text(encoding="utf-8"),
        "static func resolve_attach_launch(",
        f"""static func resolve_attach_launch(
\tlaunch_context: Dictionary, _discovery_override: Dictionary = {{}}
) -> Dictionary:
\tvar version := str(launch_context.get("plugin_version", "")).strip_edges()
\treturn {{
\t\t"ok": not version.is_empty(),
\t\t"tier": "self_update_smoke",
\t\t"command": {json.dumps(str(command))},
\t\t"args": [
\t\t\t"--from", "godot-ai==%s" % version,
\t\t\t"godot-ai", "attach",
\t\t\t"--port", str(int(launch_context.get("http_port", DEFAULT_HTTP_PORT))),
\t\t\t"--ws-port", str(int(launch_context.get("ws_port", DEFAULT_WS_PORT))),
\t\t],
\t}}""",
    )
    path.write_text(text, encoding="utf-8")


def _require_v4_addon_shape(addon_dir: Path, version: str) -> None:
    """Refuse the deliberately unsupported pre-v4 in-place update path."""
    missing = [
        rel
        for rel in ("utils/server_lifecycle.gd", "utils/update_manager.gd")
        if not (addon_dir / rel).is_file()
    ]
    if not missing:
        return
    raise HarnessError(
        f"Base addon at version {version!r} is not a v4 self-updating tree; "
        f"missing {missing}. Pre-v4 releases require the documented clean migration."
    )


def patch_plugin_cfg(path: Path, version: str) -> None:
    text = path.read_text(encoding="utf-8")
    text, count = re.subn(
        r'^version="[^"]+"$',
        f'version="{version}"',
        text,
        count=1,
        flags=re.MULTILINE,
    )
    if count != 1:
        raise HarnessError(f"Could not replace plugin.cfg version in {path}")
    path.write_text(text, encoding="utf-8")


def patch_port_isolation(
    configurator_path: Path, settings_path: Path, http_port: int, ws_port: int
) -> None:
    # SETTING_HTTP_PORT and SETTING_EXCLUDED_DOMAINS live in utils/settings.gd.
    stext = settings_path.read_text(encoding="utf-8")
    stext = replace_once(
        settings_path,
        stext,
        'const SETTING_HTTP_PORT := "godot_ai/http_port"',
        'const SETTING_HTTP_PORT := "godot_ai_self_update_smoke/http_port"',
        "SETTING_HTTP_PORT",
    )
    stext = replace_once(
        settings_path,
        stext,
        'const SETTING_EXCLUDED_DOMAINS := "godot_ai/excluded_domains"',
        'const SETTING_EXCLUDED_DOMAINS := "godot_ai_self_update_smoke/excluded_domains"',
        "SETTING_EXCLUDED_DOMAINS",
    )
    settings_path.write_text(stext, encoding="utf-8")

    # DEFAULT_HTTP_PORT, DEFAULT_WS_PORT, SETTING_WS_PORT, and
    # _read_port_setting all remain in client_configurator.gd.
    text = configurator_path.read_text(encoding="utf-8")
    text = subn_once(
        configurator_path,
        text,
        r"const DEFAULT_HTTP_PORT := \d+",
        f"const DEFAULT_HTTP_PORT := {http_port}",
        "DEFAULT_HTTP_PORT",
    )
    text = subn_once(
        configurator_path,
        text,
        r"const DEFAULT_WS_PORT := \d+",
        f"const DEFAULT_WS_PORT := {ws_port}",
        "DEFAULT_WS_PORT",
    )
    text = replace_once(
        configurator_path,
        text,
        'const SETTING_WS_PORT := "godot_ai/ws_port"',
        'const SETTING_WS_PORT := "godot_ai_self_update_smoke/ws_port"',
        "SETTING_WS_PORT",
    )
    text = replace_function(
        text,
        "static func _read_port_setting(key: String, default_port: int) -> int:",
        """static func _read_port_setting(_key: String, default_port: int) -> int:
\t## The smoke fixture must not adopt or kill another editor's server through
\t## global EditorSettings. Keep its ports deterministic and fixture-local.
\treturn default_port""",
    )
    configurator_path.write_text(text, encoding="utf-8")


def patch_server_command(path: Path, command: list[str]) -> None:
    text = path.read_text(encoding="utf-8")
    text = replace_function(
        text,
        "static func get_server_command() -> Array[String]:",
        (f"static func get_server_command() -> Array[String]:\n\treturn {json.dumps(command)}"),
    )
    path.write_text(text, encoding="utf-8")


def patch_expected_server_version(path: Path, server_version: str) -> None:
    text = path.read_text(encoding="utf-8")
    text = replace_once(
        path,
        text,
        '"expected_version": ClientConfigurator.get_plugin_version(),',
        f'"expected_version": "{server_version}",',
        "smoke lifecycle expected version",
    )
    path.write_text(text, encoding="utf-8")


def smoke_python() -> Path:
    candidates = (
        ROOT / ".venv" / "bin" / "python",
        ROOT / ".venv" / "Scripts" / "python.exe",
        Path(sys.executable),
    )
    for candidate in candidates:
        if candidate.is_file():
            ## Preserve the .venv entry path: resolving its interpreter symlink
            ## would discard venv site-packages when the frozen server launches.
            return candidate.absolute()
    raise HarnessError("no Python interpreter is available for the frozen smoke runtimes")


def prepare_local_server_runtime(
    marker_dir: Path, name: str, version: str
) -> tuple[list[str], Path]:
    """Freeze one isolated local v4 server tree; never resolve from PyPI."""

    runtime = marker_dir / name
    source = runtime / "src"
    shutil.copytree(
        ROOT / "src" / "godot_ai",
        source / "godot_ai",
        ignore=lambda _path, names: {
            value for value in names if value == "__pycache__" or value.endswith(".pyc")
        },
    )
    (runtime / "pyproject.toml").write_text(
        f'[project]\nname="godot-ai-smoke-{name}"\nversion="{version}"\n',
        encoding="utf-8",
    )
    # The lifecycle intentionally refuses process authority for an unbranded
    # command line. Mirror the production console script in this frozen local
    # runtime instead of relying on a generic run.py fixture name.
    launcher = runtime / "godot-ai-server.py"
    launcher.write_text(
        f"import sys\nsys.path.insert(0, {str(source)!r})\nfrom godot_ai import main\nmain()\n",
        encoding="utf-8",
    )
    command = [str(smoke_python()), "-I", str(launcher)]
    checked = subprocess.run(
        [*command, "--version"], check=True, capture_output=True, text=True, timeout=30
    ).stdout.strip()
    if checked != f"godot-ai {version}":
        raise HarnessError(f"{name} reported {checked!r}, expected godot-ai {version}")
    return command, source


def prepare_server_selector(
    marker_dir: Path,
    plugin_cfg: Path,
    commands: dict[str, list[str]],
) -> list[str]:
    """Write a stable, fail-closed A/B dispatcher for the frozen runtimes.

    This is fixture code, not a candidate production launcher. It models the
    stable production uvx command whose exact package pin is derived from the
    currently installed plugin.cfg after a same-editor script swap.
    """

    if len(commands) != 2 or any(
        re.fullmatch(r"4\.\d+\.\d+", version) is None for version in commands
    ):
        raise HarnessError("server selector requires two exact canonical v4 versions")
    interpreter = str(smoke_python())
    for command in commands.values():
        if (
            len(command) != 3
            or command[:2] != [interpreter, "-I"]
            or not Path(command[0]).is_absolute()
            or not Path(command[2]).is_absolute()
        ):
            raise HarnessError("server selector commands must be fixed absolute argv arrays")
    selector = marker_dir / "server-selector.py"
    selector.write_text(
        "import re\n"
        "import runpy\n"
        "import sys\n"
        "from pathlib import Path\n"
        f"PLUGIN_CFG = Path({str(plugin_cfg)!r})\n"
        f"COMMANDS = {commands!r}\n"
        f"INTERPRETER = {interpreter!r}\n"
        "try:\n"
        "    raw = PLUGIN_CFG.read_text(encoding='utf-8')\n"
        "except OSError as exc:\n"
        "    raise SystemExit(f'refused unreadable plugin.cfg: {exc}') from exc\n"
        'matches = re.findall(r\'^version="([^"\\r\\n]+)"$\', raw, re.MULTILINE)\n'
        "if len(matches) != 1 or matches[0] not in COMMANDS:\n"
        "    raise SystemExit('refused unknown or ambiguous plugin version')\n"
        "command = COMMANDS[matches[0]]\n"
        "if len(command) != 3 or command[:2] != [INTERPRETER, '-I']:\n"
        "    raise SystemExit('refused invalid frozen server command')\n"
        "sys.argv = [command[2], *sys.argv[1:]]\n"
        "runpy.run_path(command[2], run_name='__main__')\n",
        encoding="utf-8",
    )
    return [str(smoke_python()), "-I", str(selector)]


def patch_restart_log(update_installer: Path, log_path: Path) -> None:
    """Forward a --log-file to the editor the installer restarts into.

    Godot does not forward --log-file on restart, so the harness would see
    nothing from the editor that verifies the swap. Only the diagnostics
    change; the restart itself stays the production call.
    """
    text = update_installer.read_text(encoding="utf-8")
    if "diagnostics_args" in text:
        raise HarnessError(f"{update_installer} already forwards a restart log")
    text = replace_once(
        update_installer,
        text,
        "\t\tEditorInterface.restart_editor(true)\n",
        "\t\tEditorInterface.restart_editor(true)\n"
        "\t\tvar diagnostics_args := OS.get_restart_on_exit_arguments()\n"
        '\t\tdiagnostics_args.append("--log-file")\n'
        f"\t\tdiagnostics_args.append({json.dumps(str(log_path))})\n"
        "\t\tOS.set_restart_on_exit(true, diagnostics_args)\n",
        "restarted-editor log",
    )
    update_installer.write_text(text, encoding="utf-8")


def patch_release_signing_key(update_manager: Path, public_key: str) -> None:
    """Trust the one-run fixture key in the tree that will verify the bundle.

    The plugin verifies release manifests in GDScript against the key embedded
    in ``utils/update_manager.gd`` (docs/self-update.md, step 3), so the tree
    that installs a fixture-signed bundle must carry the fixture public key.
    """
    text = subn_once(
        update_manager,
        update_manager.read_text(encoding="utf-8"),
        r'const RELEASE_SIGNING_PUBLIC_KEY_PEM := """[\s\S]*?"""',
        'const RELEASE_SIGNING_PUBLIC_KEY_PEM := """' + public_key.strip() + '"""',
        "fixture release signing key",
    )
    update_manager.write_text(text, encoding="utf-8")


def prepare_smoke_signing_key(marker_dir: Path) -> tuple[Path, str]:
    """Mint the one-run release signing pair the fixture bundle is signed with."""
    private = marker_dir / "smoke-release-key.pem"
    subprocess.run(
        [
            "openssl",
            "genpkey",
            "-algorithm",
            "RSA",
            "-pkeyopt",
            "rsa_keygen_bits:4096",
            "-out",
            str(private),
        ],
        check=True,
        capture_output=True,
    )
    public = subprocess.run(
        ["openssl", "pkey", "-in", str(private), "-pubout"],
        check=True,
        capture_output=True,
        text=True,
    ).stdout
    ## The private key is deleted once the bundle is signed; the public half
    ## stays so a later fixture step can re-trust it in a tree it rebuilds.
    (marker_dir / SMOKE_PUBLIC_KEY_NAME).write_text(public, encoding="utf-8")
    return private, public


def smoke_public_key_path(project_dir: Path) -> Path:
    """The fixture public key `prepare_project` left beside its marker."""
    return project_dir / ".godot-ai-self-update-smoke" / SMOKE_PUBLIC_KEY_NAME


def _load_v4_release():
    path = ROOT / "script" / "v4-release"
    loader = importlib.machinery.SourceFileLoader("self_update_smoke_v4_release", str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    if spec is None:
        raise HarnessError("could not load v4 release primitive")
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def create_signed_v4_bundle(
    addon: Path, output: Path, version: str, private: Path, public: str
) -> None:
    release = _load_v4_release()
    release.PUBLIC_KEY_PEM = public
    archive = output / SMOKE_ARCHIVE_NAME
    manifest_path = output / SMOKE_MANIFEST_NAME
    signature = output / SMOKE_SIGNATURE_NAME
    snapshot = release._snapshot_tree(addon, version)
    release._write_zip(archive, snapshot)
    size, digest = release._hash_file(archive, release.MAX_ARCHIVE_SIZE)
    manifest = {
        "schema_version": 1,
        "repository": release.REPOSITORY,
        "channel": "stable",
        "tag": f"v{version}",
        "version": version,
        "source_commit": SMOKE_SOURCE,
        "asset": {"name": release.ASSET_NAME, "size": size, "sha256": digest},
        "inventory": [
            {"path": path, "size": len(data), "sha256": hashlib.sha256(data).hexdigest()}
            for path, data in snapshot
        ],
    }
    manifest_path.write_bytes(release._canonical(manifest))
    expected = (release.REPOSITORY, "stable", f"v{version}", version, SMOKE_SOURCE)
    release.sign_release(manifest_path, signature, private, expected)
    release.verify_release(archive, manifest_path, signature, expected)


def patch_local_update_banner(path: Path, next_version: str) -> None:
    """Replace only network I/O; retain production discovery and download control."""
    text = path.read_text(encoding="utf-8")
    text = replace_once(
        path,
        text,
        'const SIGNATURE_NAME := "godot-ai-v4-plugin.manifest.sig"\n',
        (
            'const SIGNATURE_NAME := "godot-ai-v4-plugin.manifest.sig"\n'
            f'const SELF_UPDATE_SMOKE_ARCHIVE := "res://{SMOKE_DIR}/{SMOKE_ARCHIVE_NAME}"\n'
            f'const SELF_UPDATE_SMOKE_MANIFEST := "res://{SMOKE_DIR}/{SMOKE_MANIFEST_NAME}"\n'
            f'const SELF_UPDATE_SMOKE_SIGNATURE := "res://{SMOKE_DIR}/{SMOKE_SIGNATURE_NAME}"\n'
            f'const SELF_UPDATE_SMOKE_NEXT_VERSION := "{next_version}"\n'
            "var _smoke_downloads: Array[String] = []\n"
        ),
        "SELF_UPDATE_SMOKE constants",
    )
    text = replace_function(
        text,
        "func check_for_updates() -> void:",
        """func check_for_updates() -> void:
\tvar assets: Array[Dictionary] = []
\tvar canonical := {
\t\tASSET_NAME: SELF_UPDATE_SMOKE_ARCHIVE,
\t\tMANIFEST_NAME: SELF_UPDATE_SMOKE_MANIFEST,
\t\tSIGNATURE_NAME: SELF_UPDATE_SMOKE_SIGNATURE,
\t}
\tfor name in _RELEASE_ASSET_LIMITS:
\t\tvar size := 512 if name == LEGACY_SIGNATURE_NAME else 1
\t\tif canonical.has(name):
\t\t\tsize = FileAccess.get_file_as_bytes(str(canonical[name])).size()
\t\tassets.append({
\t\t\t"name": name, "size": size,
\t\t\t"browser_download_url": (
\t\t\t\t"https://github.com/hi-godot/godot-ai/releases/download/v%s/%s"
\t\t\t\t% [SELF_UPDATE_SMOKE_NEXT_VERSION, name]),
\t\t})
\tvar release := {"tag_name": "v" + SELF_UPDATE_SMOKE_NEXT_VERSION, "assets": assets}
\t_on_check_completed(HTTPRequest.RESULT_SUCCESS, 200, PackedStringArray(),
\t\tJSON.stringify(release).to_utf8_buffer())""",
    )
    text = replace_function(
        text,
        "func _request_active_asset(url: String) -> void:",
        """func _request_active_asset(url: String) -> void:
\tvar canonical := {
\t\tASSET_NAME: SELF_UPDATE_SMOKE_ARCHIVE,
\t\tMANIFEST_NAME: SELF_UPDATE_SMOKE_MANIFEST,
\t\tSIGNATURE_NAME: SELF_UPDATE_SMOKE_SIGNATURE,
\t}
\tif not canonical.has(_active_asset) or url != str(_release.urls.get(_active_asset, "")):
\t\t_fail_download("smoke attempted a non-canonical asset")
\t\treturn
\tvar error := DirAccess.copy_absolute(
\t\tProjectSettings.globalize_path(str(canonical[_active_asset])), _download_path(_active_asset))
\tif error != OK:
\t\t_fail_download("smoke copy failed: " + error_string(error))
\t\treturn
\t_smoke_downloads.append(_active_asset)
\tif _queue.is_empty():
\t\tif _smoke_downloads != [ASSET_NAME, MANIFEST_NAME, SIGNATURE_NAME]:
\t\t\t_fail_download("smoke did not download exactly the canonical three")
\t\t\treturn
\t\tprint("MCP | self-update smoke: staged signed local bundle")
\t_on_asset_completed.call_deferred(
\t\tHTTPRequest.RESULT_SUCCESS, 200, PackedStringArray(), PackedByteArray())""",
    )
    path.write_text(text, encoding="utf-8")


def patch_vnext_hot_reload_trigger(path: Path) -> None:
    """Inject a typed Dict + Array onto McpDock so the vNext hot-reload
    actually exercises the field-storage crash class (issue #245).

    Anchored to a stable plain field (`_last_connected`) — anchoring to
    a recently-moved field would silently miss the regression rather
    than failing loudly. (`_last_log_count` moved into the LogViewer
    subpanel as part of audit-v2 #360 and is no longer on McpDock.)
    """
    text = path.read_text(encoding="utf-8")
    field_marker = "var _last_connected := false\n"
    if field_marker not in text:
        raise HarnessError(f"Could not find self-update field marker in {path}")
    text = text.replace(
        field_marker,
        (
            field_marker + 'var _self_update_smoke_trigger: Dictionary = {"armed": true}\n'
            'var _self_update_smoke_array_trigger: Array[String] = ["armed"]\n'
        ),
        1,
    )
    # Production Dock is now an inert, replaceable view and intentionally has
    # no teardown hook. Add a vNext-only hook: if Godot binds the newly parsed
    # method to the old live instance during the overwrite window, freeing the
    # old Dock still prints the crash-class canary.
    text += (
        "\n\nfunc _exit_tree() -> void:\n"
        + '\tprint("MCP | [self-update-smoke vnext _exit_tree] keys=%d values=%d" % '
        + "[_self_update_smoke_trigger.keys().size(), _self_update_smoke_array_trigger.size()])\n"
    )
    path.write_text(text, encoding="utf-8")


def patch_vnext_topology_change(addon_dir: Path) -> None:
    utils_dir = addon_dir / "utils"
    base_path = utils_dir / "self_update_smoke_base.gd"
    child_path = utils_dir / "self_update_smoke_child.gd"
    base_path.write_text(
        """@tool
class_name McpSelfUpdateSmokeBase
extends RefCounted


func marker() -> String:
\treturn "base"
""",
        encoding="utf-8",
    )
    child_path.write_text(
        """@tool
class_name McpSelfUpdateSmokeChild
extends McpSelfUpdateSmokeBase


func marker() -> String:
\treturn "child:" + super.marker()
""",
        encoding="utf-8",
    )
    # Godot creates UID sidecars during the first class scan when they are
    # absent. Include stable values in the signed tree so scanning cannot
    # change the live tree's hash between the swap and its verification.
    Path(f"{base_path}.uid").write_text("uid://m5waxbfff4ud\n", encoding="utf-8")
    Path(f"{child_path}.uid").write_text("uid://bm2056w0qvj7x\n", encoding="utf-8")

    # Anchor the topology-change preload onto a stable presentation dependency
    # in the Dock. UpdateManager moved to the composition root in v4.
    dock_path = addon_dir / "mcp_dock.gd"
    text = dock_path.read_text(encoding="utf-8")
    marker = 'const LogViewerScript := preload("res://addons/godot_ai/dock_panels/log_viewer.gd")\n'
    text = replace_once(
        dock_path,
        text,
        marker,
        (
            marker
            + "const SelfUpdateSmokeChild := preload("
            + '"res://addons/godot_ai/utils/self_update_smoke_child.gd")\n'
        ),
        "self-update smoke topology preload",
    )
    dock_path.write_text(text, encoding="utf-8")


def replace_function(text: str, signature: str, replacement: str) -> str:
    lines = text.splitlines(keepends=True)
    start_line = -1
    for i, line in enumerate(lines):
        if line.startswith(signature):
            start_line = i
            break
    if start_line == -1:
        raise HarnessError(f"Could not find function signature: {signature}")

    next_func_line = -1
    for i in range(start_line + 1, len(lines)):
        if lines[i].startswith("func ") or lines[i].startswith("static func "):
            next_func_line = i
            break
    if next_func_line == -1:
        raise HarnessError(f"Could not find end of function: {signature}")

    end_line = next_func_line
    j = next_func_line - 1
    while j > start_line and (lines[j].strip() == "" or lines[j].startswith("##")):
        j -= 1
    if j < next_func_line - 1:
        end_line = j + 1

    before = "".join(lines[:start_line])
    after = "".join(lines[end_line:])
    return before + replacement.rstrip("\n") + "\n\n" + after.lstrip("\n")


def replace_once(path: Path, text: str, old: str, new: str, label: str) -> str:
    if old not in text:
        raise HarnessError(f"Could not patch {label} in {path}")
    return text.replace(old, new, 1)


def subn_once(path: Path, text: str, pattern: str, replacement: str, label: str) -> str:
    text, count = re.subn(pattern, replacement, text, count=1)
    if count != 1:
        raise HarnessError(f"Could not patch {label} in {path}")
    return text


def diagnostic_reports_snapshot() -> set[Path]:
    if platform.system() != "Darwin":
        return set()
    reports_dir = Path.home() / "Library" / "Logs" / "DiagnosticReports"
    if not reports_dir.exists():
        return set()
    return {path for path in reports_dir.glob("Godot*.ips") if path.is_file()}


def write_baseline(project_dir: Path, baseline: set[Path]) -> None:
    baseline_file = project_dir / ".godot-ai-self-update-smoke" / "diagnostic-baseline.txt"
    baseline_file.write_text(
        "\n".join(str(path) for path in sorted(baseline)) + ("\n" if baseline else ""),
        encoding="utf-8",
    )


def print_instructions(
    project_dir: Path,
    godot_bin: str,
    base_version: str,
    next_version: str,
    server_version: str,
    next_server_version: str,
    baseline: set[Path],
) -> None:
    log_path = project_dir / ".godot-ai-self-update-smoke" / "godot-editor.log"
    latest = max(baseline, key=lambda path: path.stat().st_mtime, default=None)
    print("")
    print("Self-update smoke fixture ready")
    print(f"  project:      {project_dir}")
    print(f"  base version: {base_version}")
    print(f"  next version: {next_version}")
    print(f"  base server:  godot-ai=={server_version}")
    print(f"  next server:  godot-ai=={next_server_version}")
    print(f"  signed bundle: {project_dir / SMOKE_DIR}")
    if latest is not None:
        print(f"  latest .ips:  {latest}")
    elif platform.system() == "Darwin":
        print("  latest .ips:  none found")
    else:
        print("  crash report: non-macOS; .ips check is skipped")
    print("")
    print("Manual step:")
    print("  1. In the Godot AI dock, click Update, then confirm 'Save & Update'.")
    print("  2. The editor verifies, stages and swaps the bundle, prints")
    print(f"     '... {SMOKE_SWAP_LOG_SUFFIX}' and restarts itself. Nothing else to click.")
    print(f"  3. The restarted editor verifies the tree, prints '{SMOKE_MIGRATED_LOG}',")
    print("     shows the update as complete in the dock, and brings the server back")
    print("     at the new version.")
    print("  4. This script waits for that restarted editor, checks disk state, /godot-ai/status")
    print("     and .ips files, then leaves the editor open for inspection.")
    print("")
    print("Failure signals:")
    print("  - Godot exits without the swap line, exits non-zero, or a new Godot*.ips appears.")
    print("  - The restarted editor never prints the migration line, or its server is not")
    print("    listening at the new version.")
    print("  - The update marker does not record success, or the retained backup is missing.")
    print("  - 'MCP | [self-update-smoke vnext _exit_tree]' prints before the swap.")
    print("")
    print("Launch command:")
    print(f"  {godot_bin} --editor --path {project_dir} --log-file {log_path}")
    print("")


def launch_and_verify(
    project_dir: Path,
    godot_bin: str,
    next_version: str,
    baseline: set[Path],
    *,
    http_port: int,
    next_server_version: str,
) -> int:
    godot_path = shutil.which(godot_bin) if os.sep not in godot_bin else godot_bin
    if godot_path is None or not Path(godot_path).exists():
        raise HarnessError(f"Godot executable not found: {godot_bin}")

    started = time.time()
    log_path = project_dir / ".godot-ai-self-update-smoke" / "godot-editor.log"
    child_environment = os.environ.copy()
    if os.name == "nt":
        child_environment.pop(CAPABILITY_DIR_ENV, None)
    child_environment.update(godot_child_environment(project_dir))
    proc = subprocess.Popen(
        [
            str(godot_path),
            "--editor",
            "--path",
            str(project_dir),
            "--log-file",
            str(log_path),
        ],
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
        bufsize=1,
        env=child_environment,
    )
    lines: list[str] = []
    assert proc.stdout is not None
    for line in proc.stdout:
        print(line, end="")
        lines.append(line.rstrip("\n"))
    code = proc.wait()
    if code != 0:
        print(f"FAIL: Godot exited with code {code}")
        print_new_reports(baseline, started, Path(godot_path))
        return code or 1
    if not smoke_restart_requested(lines):
        print("FAIL: the editor closed before an update was swapped in (click Update in the dock)")
        return 1

    ## The swapping editor is gone; the one it restarted into verifies the
    ## tree, repins clients and starts the new server. Its log is forwarded
    ## by patch_restart_log; wait for it there, then for the live server.
    restarted_log = project_dir / ".godot-ai-self-update-smoke" / RESTARTED_EDITOR_LOG_NAME
    restarted_lines = wait_for_restarted_editor(restarted_log)
    lines.extend(restarted_lines)
    post_update_status = wait_for_live_status(
        http_port,
        next_server_version,
        capability_dir=fixture_environment_paths(project_dir)["capability_dir"],
        timeout=POST_UPDATE_STATUS_TIMEOUT_SECONDS,
        poll=POST_UPDATE_STATUS_POLL_SECONDS,
    )

    ok = verify_post_run(
        project_dir,
        next_version,
        baseline,
        started,
        lines,
        post_update_status=post_update_status,
        next_server_version=next_server_version,
        godot_path=Path(godot_path),
    )
    print("The restarted editor stays open for inspection; close it when you are done.")
    return 0 if ok else 1


def run_v3_crossing(args: argparse.Namespace, project_dir: Path) -> int:
    from_version = release_tag_to_version(args.from_v3_tag)
    if re.fullmatch(r"3\.\d+\.\d+", from_version) is None:
        raise HarnessError("--from-v3-tag must name a v3 release tag, like v3.2.4")
    target_version = read_plugin_version(PLUGIN_ROOT / "plugin.cfg")
    ensure_safe_project_dir(project_dir, args.force)
    baseline = diagnostic_reports_snapshot()
    marker_dir = project_dir / ".godot-ai-self-update-smoke"
    prepare_v3_crossing_project(
        project_dir,
        from_version=from_version,
        target_version=target_version,
        http_port=args.http_port,
        ws_port=args.ws_port,
        restart_log=marker_dir / RESTARTED_EDITOR_LOG_NAME,
    )
    write_baseline(project_dir, baseline)
    print_v3_instructions(project_dir, args.godot, from_version, target_version)
    if args.no_launch:
        return 0
    return launch_and_verify_v3_crossing(
        project_dir,
        args.godot,
        from_version=from_version,
        target_version=target_version,
        baseline=baseline,
        http_port=args.http_port,
    )


def prepare_v3_crossing_project(
    project_dir: Path,
    *,
    from_version: str,
    target_version: str,
    http_port: int,
    ws_port: int,
    restart_log: Path | None = None,
) -> dict[str, Path]:
    """Install exact final-v3 that will cross into this checkout's v4 via the capsule.

    The v3 tree is ``git archive v<from_version>``; its updater is patched only
    to trust the one-run key and to offer the locally built capsule instead of
    a GitHub release, and its server start is disabled (the v4 editor starts
    the frozen local runtime). The capsule is the bridge plus this checkout's
    installer scripts and a signed bundle of this checkout's plugin, laid out
    as ``script/v4-release build_migration_capsule`` lays it out. Returns the
    live add-on, the extracted v3 add-on source, the work dir and the
    capability dir.
    """
    project_dir.mkdir(parents=True, exist_ok=True)
    write_project_files(project_dir)
    work = project_dir / ".godot-ai-self-update-smoke"
    work.mkdir(exist_ok=True)
    (work / "marker.txt").write_text("v3 crossing fixture\n", encoding="utf-8")

    server_command, _runtime_source = prepare_local_server_runtime(
        work, "bridge-server", target_version
    )
    private_key, public_key = prepare_smoke_signing_key(work)
    client_command = prepare_isolated_client_environment(
        project_dir, base_version=from_version, http_port=http_port, ws_port=ws_port
    )
    release_tree = work / "release-tree"
    shutil.copytree(PLUGIN_ROOT, release_tree, ignore=copy_ignore)
    patch_fixture_plugin(
        release_tree,
        version=target_version,
        server_version=target_version,
        http_port=http_port,
        ws_port=ws_port,
        force_local_update=False,
        next_version=target_version,
        server_command=server_command,
        isolate_client_migration=True,
        client_launch_command=client_command,
    )
    bundle = work / "release"
    bundle.mkdir()
    create_signed_v4_bundle(release_tree, bundle, target_version, private_key, public_key)

    capsule_tree = work / "capsule-tree" / "addons" / "godot_ai"
    shutil.copytree(ROOT / "migration_bridge", capsule_tree)
    (capsule_tree / "utils").mkdir()
    for name in CAPSULE_INSTALLER_SCRIPTS:
        shutil.copy2(PLUGIN_ROOT / "utils" / name, capsule_tree / "utils" / name)
    capsule_config = capsule_tree / "plugin.cfg"
    capsule_config.write_text(
        capsule_config.read_text(encoding="utf-8").replace("@VERSION@", target_version),
        encoding="utf-8",
    )
    if restart_log is not None:
        patch_restart_log(capsule_tree / "utils" / "update_installer.gd", restart_log)
    payload = capsule_tree / "migration_payload"
    payload.mkdir()
    for name in (SMOKE_ARCHIVE_NAME, SMOKE_MANIFEST_NAME, SMOKE_SIGNATURE_NAME):
        shutil.copy2(bundle / name, payload / name)
    write_final_v3_fallback(payload / V3_FALLBACK_NAME)
    bridge = capsule_tree / "migration_bridge.gd"
    bridge_text = subn_once(
        bridge,
        bridge.read_text(encoding="utf-8"),
        r'const RELEASE_SIGNING_PUBLIC_KEY_PEM := """[\s\S]*?"""',
        'const RELEASE_SIGNING_PUBLIC_KEY_PEM := """' + public_key.strip() + '"""',
        "capsule fixture signing key",
    )
    bridge_text = replace_function(
        bridge_text,
        "static func _previous_version() -> String:",
        "static func _previous_version() -> String:\n" + f"\treturn {json.dumps(from_version)}",
    )
    bridge.write_text(bridge_text, encoding="utf-8")
    capsule = work / "godot-ai-plugin.zip"
    with zipfile.ZipFile(capsule, "w", compression=zipfile.ZIP_STORED) as package:
        for path in sorted(capsule_tree.rglob("*")):
            if path.is_file():
                package.write(path, path.relative_to(capsule_tree.parents[1]).as_posix())
    checksum = work / "godot-ai-plugin.zip.sha256"
    checksum.write_text(
        f"{hashlib.sha256(capsule.read_bytes()).hexdigest()}  {capsule.name}\n",
        encoding="ascii",
    )
    signature = work / "godot-ai-plugin.zip.sha256.sig"
    subprocess.run(
        [
            "openssl", "dgst", "-sha256", "-sign", str(private_key),
            "-out", str(signature), str(checksum),
        ],
        check=True,
        capture_output=True,
    )
    private_key.unlink()

    archived = work / f"v{from_version}.zip"
    archived.write_bytes(
        subprocess.run(
            ["git", "archive", "--format=zip", f"v{from_version}", "plugin/addons/godot_ai"],
            cwd=ROOT,
            check=True,
            capture_output=True,
        ).stdout
    )
    extracted = work / "v3-source"
    with zipfile.ZipFile(archived) as package:
        for info in package.infolist():
            member = PurePosixPath(info.filename)
            if member.is_absolute() or ".." in member.parts:
                raise HarnessError(f"refusing archive member {info.filename}")
            if not info.is_dir() and not info.filename.startswith("plugin/addons/godot_ai/"):
                raise HarnessError(f"unexpected archive member {info.filename}")
        package.extractall(extracted)
    v3_source = extracted / "plugin/addons/godot_ai"
    live = project_dir / "addons" / "godot_ai"
    shutil.copytree(v3_source, live)
    old_plugin = live / "plugin.gd"
    old_plugin.write_text(
        replace_function(
            old_plugin.read_text(encoding="utf-8"),
            "func _start_server() -> void:",
            "func _start_server() -> void:\n\tpass",
        ),
        encoding="utf-8",
    )
    old_manager = live / "utils" / "update_manager.gd"
    manager_text = old_manager.read_text(encoding="utf-8")
    manager_text = subn_once(
        old_manager,
        manager_text,
        r'const RELEASE_SIGNING_PUBLIC_KEY_PEM := """[\s\S]*?"""',
        'const RELEASE_SIGNING_PUBLIC_KEY_PEM := """' + public_key.strip() + '"""',
        "v3 fixture signing key",
    )
    manager_text = replace_once(
        old_manager,
        manager_text,
        'const UPDATE_TEMP_ZIP := "user://godot_ai_update/update.zip"\n',
        (
            'const UPDATE_TEMP_ZIP := "user://godot_ai_update/update.zip"\n'
            f"const CLICK_FIXTURE_ARCHIVE := {json.dumps(str(capsule))}\n"
            f"const CLICK_FIXTURE_CHECKSUM := {json.dumps(str(checksum))}\n"
            f"const CLICK_FIXTURE_SIGNATURE := {json.dumps(str(signature))}\n"
            f"const CLICK_FIXTURE_VERSION := {json.dumps(target_version)}\n"
        ),
        "v3 click fixture assets",
    )
    manager_text = replace_function(
        manager_text,
        "func check_for_updates() -> void:",
        """func check_for_updates() -> void:
\t_latest_download_url = (
\t\t"https://github.com/hi-godot/godot-ai/releases/download/v%s/" % CLICK_FIXTURE_VERSION
\t\t+ "godot-ai-plugin.zip"
\t)
\t_latest_checksum_url = _latest_download_url + ".sha256"
\t_latest_signature_url = _latest_checksum_url + ".sig"
\t_latest_remote_version = CLICK_FIXTURE_VERSION
\tupdate_check_completed.emit({
\t\t"has_update": true,
\t\t"version": CLICK_FIXTURE_VERSION,
\t\t"label_text": "Update available: v%s" % CLICK_FIXTURE_VERSION,
\t})""",
    )
    manager_text = replace_function(
        manager_text,
        "func start_install() -> void:",
        f"""func start_install() -> void:
\tprint({json.dumps(V3_CLICK_LOG)})
\tvar global_zip := ProjectSettings.globalize_path(UPDATE_TEMP_ZIP)
\tDirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(UPDATE_TEMP_DIR))
\tif DirAccess.copy_absolute(CLICK_FIXTURE_ARCHIVE, global_zip) != OK:
\t\t_fail_verification("fixture archive copy failed")
\t\treturn
\tvar sidecar := FileAccess.get_file_as_bytes(CLICK_FIXTURE_CHECKSUM)
\tvar signature := FileAccess.get_file_as_bytes(CLICK_FIXTURE_SIGNATURE)
\tif not _verify_sidecar_signature(RELEASE_SIGNING_PUBLIC_KEY_PEM, sidecar, signature):
\t\t_fail_verification("fixture signature failed")
\t\treturn
\tprint("MCP | self-update release signature verified")
\tvar expected := _parse_sha256_digest(sidecar.get_string_from_utf8())
\t_finish_digest_check_and_install(expected)""",
    )
    old_manager.write_text(manager_text, encoding="utf-8")
    return {
        "live": live,
        "v3_source": v3_source,
        "work": work,
        "capability_dir": fixture_environment_paths(project_dir)["capability_dir"],
    }


def write_final_v3_fallback(destination: Path, ref: str = FINAL_V3_REF) -> None:
    """The final v3 add-on re-packed at its live path, as the release capsule carries it."""
    archived = subprocess.run(
        ["git", "archive", "--format=zip", ref, "plugin/addons/godot_ai"],
        cwd=ROOT,
        check=True,
        capture_output=True,
    ).stdout
    prefix = "plugin/addons/godot_ai/"
    with (
        zipfile.ZipFile(io.BytesIO(archived)) as source,
        zipfile.ZipFile(destination, "w", compression=zipfile.ZIP_STORED) as target,
    ):
        for info in sorted(source.infolist(), key=lambda entry: entry.filename):
            if info.is_dir():
                continue
            if not info.filename.startswith(prefix) or ".." in PurePosixPath(info.filename).parts:
                raise HarnessError(f"unexpected archive member {info.filename}")
            target.writestr("addons/godot_ai/" + info.filename[len(prefix) :], source.read(info))


def print_v3_instructions(
    project_dir: Path, godot_bin: str, from_version: str, target_version: str
) -> None:
    log_path = project_dir / ".godot-ai-self-update-smoke" / "godot-editor.log"
    print("")
    print("v3-to-v4 crossing smoke fixture ready")
    print(f"  project:       {project_dir}")
    print(f"  installed:     exact Godot AI v{from_version} (git tag v{from_version})")
    print(f"  capsule:       bridge + this checkout's installer + signed v{target_version} bundle")
    print("")
    print("Manual step:")
    print(f"  1. In the v{from_version} Godot AI dock, click Update.")
    print("  2. v3's own updater extracts the capsule; the bridge verifies, stages and swaps")
    print(f"     the v4 tree, prints '{V3_BRIDGE_RESTART_LOG}' and restarts the editor.")
    print(f"  3. The restarted v4 editor verifies the tree, prints '{SMOKE_MIGRATED_LOG}',")
    print("     repins the isolated Codex entry and starts the local server.")
    print("  4. This script waits for that editor, checks disk state, /godot-ai/status and")
    print("     .ips files, then leaves the editor open for inspection.")
    print("")
    print("Launch command:")
    print(f"  {godot_bin} --editor --path {project_dir} --log-file {log_path}")
    print("")


def launch_and_verify_v3_crossing(
    project_dir: Path,
    godot_bin: str,
    *,
    from_version: str,
    target_version: str,
    baseline: set[Path],
    http_port: int,
) -> int:
    godot_path = shutil.which(godot_bin) if os.sep not in godot_bin else godot_bin
    if godot_path is None or not Path(godot_path).exists():
        raise HarnessError(f"Godot executable not found: {godot_bin}")
    started = time.time()
    marker_dir = project_dir / ".godot-ai-self-update-smoke"
    child_environment = os.environ.copy()
    if os.name == "nt":
        child_environment.pop(CAPABILITY_DIR_ENV, None)
    child_environment.update(godot_child_environment(project_dir))
    proc = subprocess.Popen(
        [
            str(godot_path),
            "--editor",
            "--path",
            str(project_dir),
            "--log-file",
            str(marker_dir / "godot-editor.log"),
        ],
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
        bufsize=1,
        env=child_environment,
    )
    lines: list[str] = []
    assert proc.stdout is not None
    for line in proc.stdout:
        print(line, end="")
        lines.append(line.rstrip("\n"))
    code = proc.wait()
    if code != 0:
        print(f"FAIL: Godot exited with code {code}")
        print_new_reports(baseline, started, Path(godot_path))
        return code or 1
    if not any(V3_BRIDGE_RESTART_LOG in line for line in lines):
        print("FAIL: the editor closed before the capsule swapped the v4 tree in (click Update)")
        return 1
    restarted_lines = wait_for_restarted_editor(marker_dir / RESTARTED_EDITOR_LOG_NAME)
    lines.extend(restarted_lines)
    post_update_status = wait_for_live_status(
        http_port,
        target_version,
        capability_dir=fixture_environment_paths(project_dir)["capability_dir"],
        timeout=POST_UPDATE_STATUS_TIMEOUT_SECONDS,
        poll=POST_UPDATE_STATUS_POLL_SECONDS,
    )
    ok = verify_v3_crossing(
        project_dir,
        from_version,
        target_version,
        baseline,
        started,
        lines,
        post_update_status=post_update_status,
        godot_path=Path(godot_path),
    )
    print("The restarted editor stays open for inspection; close it when you are done.")
    return 0 if ok else 1


def verify_v3_crossing(
    project_dir: Path,
    from_version: str,
    target_version: str,
    baseline: set[Path],
    started: float,
    lines: list[str],
    *,
    post_update_status: dict | None,
    godot_path: Path | None = None,
) -> bool:
    ok = True
    live = project_dir / "addons" / "godot_ai"
    installed = read_plugin_version(live / "plugin.cfg")
    if installed == target_version:
        print(f"PASS: plugin version advanced from {from_version} to {installed}")
    else:
        print(f"FAIL: plugin version is {installed}, expected {target_version}")
        ok = False

    expected_order = (
        V3_CLICK_LOG,
        "MCP | self-update release signature verified",
        "MCP | update runner disabling old plugin",
        "MCP | v3 bridge swapping in the verified canonical v4 tree",
        V3_BRIDGE_RESTART_LOG,
        SMOKE_MIGRATED_LOG,
        "MCP | plugin loaded",
    )
    position = 0
    missing = ""
    for marker in expected_order:
        while position < len(lines) and marker not in lines[position]:
            position += 1
        if position >= len(lines):
            missing = marker
            break
    if missing:
        print(f"FAIL: crossing log is missing or out of order at {missing!r}")
        ok = False
    else:
        print("PASS: click, extract, swap, restart and client migration logged in order")
    if any("Failed to create an autoload" in line for line in lines):
        print("FAIL: an autoload failed to load during the crossing (#946)")
        ok = False

    try:
        marker, backup = verify_lean_update_state(project_dir, target_version)
        print(
            f"PASS: update marker records success from {marker.get('from_version')} "
            f"to {marker.get('to_version')}; backup retained at {backup}"
        )
        if str(marker.get("from_version")) != from_version:
            print(f"FAIL: marker names {marker.get('from_version')!r} as the previous version")
            ok = False
        overlaid = (backup / "update_reload_runner.gd").is_file()
        if overlaid and (backup / "migration_payload").is_dir():
            print("PASS: the backup is the v3 tree with the capsule overlay it received")
        else:
            print("FAIL: the backup does not hold the v3 tree and capsule payload")
            ok = False
    except Exception as exc:
        print(f"FAIL: {exc}")
        ok = False

    leftovers = [
        name
        for name in (
            "migration_bridge.gd",
            "migration_coordinator.gd",
            "update_reload_runner.gd",
            "migration_payload",
        )
        if (live / name).exists()
    ]
    if leftovers:
        print(f"FAIL: live tree still carries {leftovers}")
        ok = False
    else:
        print("PASS: live tree is the canonical v4 tree (no bridge, runner or payload)")

    codex_config = fixture_environment_paths(project_dir)["codex_home"] / "config.toml"
    config_text = codex_config.read_text(encoding="utf-8") if codex_config.is_file() else ""
    repinned = f"godot-ai=={target_version}" in config_text
    if repinned and f"godot-ai=={from_version}" not in config_text:
        print(f"PASS: isolated Codex entry repinned from {from_version} to {target_version}")
    else:
        print(f"FAIL: isolated Codex entry was not repinned to {target_version}")
        ok = False

    if status_reports_live_version(post_update_status, target_version):
        print(f"PASS: post-update {STATUS_PATH} live v{post_update_status.get('server_version')}")
    else:
        got = None if post_update_status is None else post_update_status.get("server_version")
        print(
            f"FAIL: post-update {STATUS_PATH} was not live "
            f"(got {got!r}, expected {target_version!r})"
        )
        ok = False

    new_reports = new_diagnostic_reports(baseline, started, godot_path)
    if new_reports:
        print("FAIL: new Godot crash reports:")
        for report in new_reports:
            print(f"  {report}")
        ok = False
    elif platform.system() == "Darwin":
        print("PASS: no new Godot .ips crash report detected")
    return ok


def wait_for_restarted_editor(
    log_path: Path, timeout: float = RESTARTED_EDITOR_TIMEOUT_SECONDS
) -> list[str]:
    """Lines the restarted editor logged, once it reports the migration done."""
    deadline = time.time() + timeout
    lines: list[str] = []
    while time.time() < deadline:
        if log_path.is_file():
            lines = log_path.read_text(encoding="utf-8", errors="replace").splitlines()
            if any(SMOKE_MIGRATED_LOG in line for line in lines) and any(
                "MCP | plugin loaded" in line for line in lines
            ):
                return lines
        time.sleep(POST_UPDATE_STATUS_POLL_SECONDS)
    return lines


def verify_post_run(
    project_dir: Path,
    next_version: str,
    baseline: set[Path],
    started: float,
    lines: list[str],
    *,
    post_update_status: dict | None,
    next_server_version: str,
    godot_path: Path | None = None,
) -> bool:
    ok = True
    installed_version = read_plugin_version(project_dir / "addons" / "godot_ai" / "plugin.cfg")
    if installed_version == next_version:
        print(f"PASS: plugin version advanced to {installed_version}")
    else:
        print(f"FAIL: plugin version is {installed_version}, expected {next_version}")
        ok = False

    try:
        marker, backup = verify_lean_update_state(project_dir, next_version)
        print(
            f"PASS: update marker records success from {marker.get('from_version')} "
            f"to {marker.get('to_version')}; backup retained at {backup}"
        )
    except Exception as exc:
        print(f"FAIL: update evidence is invalid: {exc}")
        ok = False

    if vnext_exit_tree_during_update(lines):
        print(f"FAIL: {SMOKE_TRIGGER_LOG} printed before the swap")
        ok = False
    else:
        print("PASS: vNext _exit_tree trigger did not run before the swap")

    if smoke_restart_requested(lines) and any(SMOKE_MIGRATED_LOG in line for line in lines):
        print("PASS: the editor restarted and the restarted editor completed client migration")
    else:
        print("FAIL: no swap-and-restart followed by client migration in the logs")
        ok = False

    if smoke_adopted_existing_server_before_update(lines):
        print(
            "FAIL: smoke fixture adopted an existing server before update; "
            "clear the smoke ports first"
        )
        ok = False
    elif smoke_started_own_server_before_update(lines):
        print("PASS: smoke fixture started its own server before update")
    else:
        print("FAIL: smoke fixture did not start its own server before update")
        ok = False

    if smoke_stopped_server_during_update(lines):
        print("PASS: self-update stopped the managed smoke server")
    else:
        print("FAIL: self-update did not stop a managed smoke server")
        ok = False

    if smoke_reported_server_version_mismatch(lines):
        print("FAIL: smoke fixture reported a server/plugin version mismatch")
        ok = False
    else:
        print("PASS: no server/plugin version mismatch reported")

    if status_reports_live_version(post_update_status, next_server_version):
        print(f"PASS: post-update {STATUS_PATH} live v{post_update_status.get('server_version')}")
    else:
        got = None if post_update_status is None else post_update_status.get("server_version")
        print(
            f"FAIL: post-update {STATUS_PATH} was not live "
            f"(got server_version={got!r}, expected {next_server_version!r})"
        )
        ok = False

    new_reports = new_diagnostic_reports(baseline, started, godot_path)
    if new_reports:
        print("FAIL: new Godot crash reports:")
        for report in new_reports:
            print(f"  {report}")
        ok = False
    elif platform.system() == "Darwin":
        print("PASS: no new Godot .ips crash report detected")
    else:
        print("SKIP: non-macOS .ips crash report check")

    print("Check the Godot console for:")
    print("  PASS signal: update coordinator enabling verified plugin, then plugin loaded")
    return ok


def verify_lean_update_state(project_dir: Path, next_version: str) -> tuple[dict, Path]:
    """Check the on-disk state one successful update leaves (docs/self-update.md)."""
    project = project_dir.resolve(strict=True)
    live = (project / "addons" / "godot_ai").resolve(strict=True)
    state = project / UPDATE_STATE_DIR
    marker_path = state / "pending.json"
    if not marker_path.is_file():
        raise HarnessError("update marker is missing")
    marker = json.loads(marker_path.read_text(encoding="utf-8"))
    if not isinstance(marker, dict) or marker.get("status") != "success":
        raise HarnessError(f"update marker does not record success: {marker!r}")
    if marker.get("clients_migrated") is not True:
        raise HarnessError("the update marker does not record client migration")
    if marker.get("to_version") != next_version:
        raise HarnessError(
            f"update marker ends at {marker.get('to_version')!r}, not {next_version!r}"
        )
    if release_verify.hash_tree(live)["tree_sha256"] != marker.get("expected_tree_sha256"):
        raise HarnessError("live tree differs from the hash the update marker expected")
    from_version = str(marker.get("from_version", ""))
    backup = state / "backup" / from_version
    if not from_version or not backup.is_dir():
        raise HarnessError("retained backup of the previous version is missing")
    for leftover in ("lock.json", "stage", "quarantine"):
        if (state / leftover).exists():
            raise HarnessError(f"update left {leftover} behind")
    return marker, backup


def smoke_swap_line(line: str) -> bool:
    return line.strip().startswith("MCP | update to ") and line.rstrip().endswith(
        SMOKE_SWAP_LOG_SUFFIX
    )


def smoke_restart_requested(lines: list[str]) -> bool:
    return any(smoke_swap_line(line) for line in lines)


def vnext_exit_tree_during_update(lines: list[str]) -> bool:
    """True when the vNext trigger ran in the update window (staged, not yet swapped)."""
    staged = False
    for line in lines:
        if SMOKE_STAGED_LOG in line:
            staged = True
        if staged and smoke_swap_line(line):
            return False
        if staged and SMOKE_TRIGGER_LOG in line:
            return True
    return False


def smoke_started_own_server_before_update(lines: list[str]) -> bool:
    return any("MCP | started server" in line for line in smoke_lines_before_update(lines))


def smoke_adopted_existing_server_before_update(lines: list[str]) -> bool:
    external_signals = (
        "MCP | adopted external server",
        "MCP | foreign server already running",
        "foreign server already running",
    )
    return any(
        any(signal in line for signal in external_signals)
        for line in smoke_lines_before_update(lines)
    )


def smoke_stopped_server_during_update(lines: list[str]) -> bool:
    staged = False
    for line in lines:
        if SMOKE_STAGED_LOG in line:
            staged = True
            continue
        if not staged:
            continue
        if smoke_swap_line(line):
            return False
        if "MCP | stopped server" in line:
            return True
    return False


def smoke_reported_server_version_mismatch(lines: list[str]) -> bool:
    return any(
        "is occupied by godot-ai server v" in line and "plugin expects v" in line for line in lines
    )


def smoke_lines_before_update(lines: list[str]) -> list[str]:
    before: list[str] = []
    for line in lines:
        if SMOKE_STAGED_LOG in line:
            break
        before.append(line)
    return before



def status_url(http_port: int) -> str:
    return f"http://127.0.0.1:{http_port}{STATUS_PATH}"


def fetch_status_payload(
    http_port: int, timeout: float = 2.0, *, capability_dir: Path | None = None
) -> dict | None:
    """GET /godot-ai/status. None if the port is dark or the body is not JSON."""
    try:
        record = read_capabilities(http_port, capability_dir)
        if record is None:
            return None
        request = urllib.request.Request(
            status_url(http_port),
            headers={
                "Authorization": f"Bearer {record.http}",
                "Accept-Encoding": "identity",
            },
        )
        with urllib.request.urlopen(request, timeout=timeout) as resp:
            if getattr(resp, "status", 200) != 200:
                return None
            if resp.headers.get("Content-Encoding", "").strip().lower() not in {"", "identity"}:
                return None
            declared = resp.headers.get("Content-Length")
            if declared is not None and (
                not declared.isdigit() or int(declared) > MAX_STATUS_RESPONSE_BYTES
            ):
                return None
            raw = resp.read(MAX_STATUS_RESPONSE_BYTES + 1)
            if len(raw) > MAX_STATUS_RESPONSE_BYTES or (
                declared is not None and len(raw) != int(declared)
            ):
                return None
            payload = json.loads(raw.decode())
    except (
        OSError,
        TimeoutError,
        ValueError,
        urllib.error.URLError,
        http.client.IncompleteRead,
    ):
        return None
    if not isinstance(payload, dict) or payload.get("instance_id") != record.instance_nonce:
        return None
    return payload


def status_reports_live_version(payload: dict | None, expected_version: str) -> bool:
    if not payload:
        return False
    if payload.get("name") != "godot-ai":
        return False
    version = payload.get("server_version")
    if not isinstance(version, str) or not version:
        return False
    if expected_version and version != expected_version:
        return False
    return True


def wait_for_live_status(
    http_port: int,
    expected_version: str,
    *,
    capability_dir: Path | None = None,
    timeout: float = POST_UPDATE_STATUS_TIMEOUT_SECONDS,
    poll: float = POST_UPDATE_STATUS_POLL_SECONDS,
) -> dict | None:
    deadline = time.time() + timeout
    last: dict | None = None
    while time.time() < deadline:
        last = fetch_status_payload(http_port, capability_dir=capability_dir)
        if status_reports_live_version(last, expected_version):
            return last
        time.sleep(poll)
    return last


def print_new_reports(baseline: set[Path], started: float, godot_path: Path) -> None:
    reports = new_diagnostic_reports(baseline, started, godot_path)
    if reports:
        print("New Godot crash reports:")
        for report in reports:
            print(f"  {report}")


def _report_matches_executable(report: Path, godot_path: Path | None) -> bool:
    if godot_path is None:
        return True
    try:
        with report.open(encoding="utf-8") as source:
            source.readline()
            payload = json.load(source)
        reported = payload.get("procPath")
        return isinstance(reported, str) and Path(reported).resolve() == godot_path.resolve()
    except (OSError, ValueError, TypeError):
        # An unreadable report cannot be proven unrelated to this smoke.
        return True


def new_diagnostic_reports(
    baseline: set[Path], started: float, godot_path: Path | None = None
) -> list[Path]:
    current = diagnostic_reports_snapshot()
    return sorted(
        (
            path
            for path in current - baseline
            if path.exists()
            and path.stat().st_mtime >= started - 2
            and _report_matches_executable(path, godot_path)
        ),
        key=lambda path: path.stat().st_mtime,
    )


if __name__ == "__main__":
    raise SystemExit(main())
